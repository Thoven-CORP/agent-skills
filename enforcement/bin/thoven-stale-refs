#!/usr/bin/env bash
# Lists live instructions that still describe the pre-THV-968 branch and deploy model:
# release/2.0 as the prod branch, feature/teacher-2.0 or integrate/2.0 as the 2.0 line,
# thoven.vercel.app as prod. Since THV-1038 it also lists any path into the retired thoven2.0
# workspace. History (archives, changelogs, dated plans, audits, decision logs) is exempt: it
# records what was true then.
#
#   thoven-stale-refs                   one line per hit, then a count per root; exit 1 on any hit
#   thoven-stale-refs --count           the counts only
#   thoven-stale-refs [--count] [--base REF] [-- ROOT...]  scan roots and deleted callers
#
# Git checkouts include tracked and untracked, non-ignored files in the live scan.
set -uo pipefail

PATTERN='release/2\.0|feature/teacher-2\.0|integrate/2\.0|thoven\.vercel\.app|thoven2\.0'
SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
WORKSPACE_ROOT="${THOVEN_WORKSPACE_ROOT:-$(dirname "$SCRIPT_ROOT")}"
ROOTS=(
  "$WORKSPACE_ROOT/frontend"
  "$WORKSPACE_ROOT/backend"
  "$SCRIPT_ROOT"
  # The rest of .workspace is session history (THV-1038 inventory). These three are live law.
  "$WORKSPACE_ROOT/.workspace/CLAUDE-root.md"
  "$WORKSPACE_ROOT/.workspace/AGENTS-root.md"
  "$WORKSPACE_ROOT/.workspace/CONTEXT-MAP.md"
  "$WORKSPACE_ROOT/CI_CD.md"
)
# Paths whose job is to record the past.
# Test fixtures can describe retired names without being live instructions.
EXEMPT='/(archive|_archive|audit|audits|history|tests|node_modules|\.git|\.next|coverage|tmp|log|vendor|orchestrate|checkins|runs|reports|scratch|\.specs|resume-prompts|wireframe)/|/TODO\.md|/TECH_DEBT\.md|/thoven-stale-refs|CHANGELOG|/decisions/|/adr/|/plans/20[0-9]{2}-|/plans/[^/]*20[0-9]{2}-[0-9]{2}|\.bak|\.jsonl$|/graphify-out/|/test-results/|/playwright-report/|package-lock\.json$|/\.agents/|/\.claude/worktrees/'

# Records the THV-1038 inventory ruled history, per repo. They cite thoven2.0 as it was then.
# Matched against the root-relative path only.
FE_HISTORY='^(\.audit/|decisions\.tsv:|\.superpowers/|docs/superpowers/|docs/Design_Practice/|docs/Book_Lessons/CONTINUE_HERE\.md:|docs/Payment_Request_Management/|docs/Platform/projects/platform-upgrade-and-hosting/(STATE\.md:|research/))'
BE_HISTORY='^\.scratch/'

# A live doc may still name the old model when the same line says it is gone.
ALLOW='retired|deleted|superseded|no longer|formerly|stale-ok'

# Keyed on the checkout's own files, not its name: bin/verify scans a snapshot directory.
drop_history() {
  if [ -e "$1/next.config.mjs" ] || [ -e "$1/next.config.js" ] || case "$(basename "$1")" in frontend*) true ;; *) false ;; esac; then
    grep -vE "$FE_HISTORY"
  elif [ -e "$1/config/application.rb" ] || case "$(basename "$1")" in backend*) true ;; *) false ;; esac; then
    grep -vE "$BE_HISTORY"
  else
    cat
  fi
}

# Prints hits as root-relative path:line:text.
scan_relative() {
  if git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$1" grep -nIE "$PATTERN" -- . ':(exclude,glob)**/public/**' ':(exclude,glob)**/storage/**' \
      ':(exclude)*.lock' ':(exclude)package-lock.json' ':(exclude)*.min.js' ':(exclude)*.map'
    while IFS= read -r -d "" rel; do
      grep -HnIE "$PATTERN" "$1/$rel" 2>/dev/null | sed "s|^$1/||" || true
    done < <(git -C "$1" ls-files --others --exclude-standard -z)
  else
    grep -rInE "$PATTERN" "$1" \
      --exclude-dir={node_modules,.git,.next,coverage,tmp,log,vendor,graphify-out,test-results,playwright-report,worktrees,storage,public} \
      --exclude='*.lock' --exclude='package-lock.json' --exclude='*.min.js' --exclude='*.map' |
      cut -c$((${#1} + 2))-
  fi
}

scan() {
  if [ -f "$1" ]; then
    grep -HnIE "$PATTERN" "$1"
  else
    scan_relative "$1" 2>/dev/null | drop_history "$1" | sed "s|^|$1/|"
  fi
}

count_only=0
base=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --count) count_only=1; shift ;;
    --base)
      [ "$#" -ge 2 ] || { echo 'usage: thoven-stale-refs [--count] [--base REF] [-- ROOT...]' >&2; exit 2; }
      [ -n "$2" ] || { echo 'thoven-stale-refs: --base is empty' >&2; exit 2; }
      base="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [ "$#" -gt 0 ]; then
  for root in "$@"; do
    if [ -z "$root" ] || [ ! -e "$root" ]; then
      printf 'thoven-stale-refs: root is empty or missing: %s\n' "$root" >&2
      exit 2
    fi
  done
  ROOTS=("$@")
fi
total=0
for root in "${ROOTS[@]}"; do
  if [ ! -e "$root" ]; then
    printf 'thoven-stale-refs: default root is missing: %s\n' "$root" >&2
    exit 2
  fi
  hits=$(scan "$root" | grep -vE "$EXEMPT" | grep -viE "$ALLOW" || true)
  if [ -n "$base" ] && [ -d "$root" ] && git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    call_hits="$("$(dirname "${BASH_SOURCE[0]}")/thoven-stale-ref-calls.py" "$base" "$root")" || call_rc=$?
    call_rc="${call_rc:-0}"
    if [ "$call_rc" -gt 1 ]; then
      exit "$call_rc"
    fi
    if [ -n "$call_hits" ]; then
      call_hits="$(printf '%s\n' "$call_hits" | drop_history "$root" | sed "s|^|$root/|")"
      hits="$(printf '%s\n%s\n' "$hits" "$call_hits" | grep -vE "$EXEMPT" || true)"
    fi
    unset call_rc
  fi
  n=$(printf '%s' "$hits" | grep -c . || true)
  total=$((total + n))
  [ "$count_only" = 1 ] || { [ -n "$hits" ] && printf '%s\n' "$hits"; }
  printf '%6d  %s\n' "$n" "$root" >&2
done
printf '%6d  total\n' "$total" >&2
[ "$total" = 0 ]
