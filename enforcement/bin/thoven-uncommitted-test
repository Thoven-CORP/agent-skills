#!/usr/bin/env bash
# Runs thoven-uncommitted in each dialect against two throwaway repos and a fake session edit log,
# then end to end per tool: thoven-track-edits writes the log from that tool's own payload.
set -uo pipefail

ENF="$(cd "$(dirname "$0")/.." && pwd)"
HOOK="$ENF/hooks/thoven-uncommitted"
TRACK="$ENF/hooks/thoven-track-edits"
T=$(mktemp -d /tmp/thv974.XXXXXX) || exit 1; case "$T" in /tmp/thv974.*) ;; *) exit 1;; esac
SESSION="uncommitted-test-$$"
STATE="/tmp/claude-thoven/$SESSION"
case "$STATE" in /tmp/claude-thoven/uncommitted-test-[0-9]*) ;; *) exit 1;; esac
trap 'rm -rf "$T" "$STATE" "$STATE-nolog" "$STATE-cursor" "$STATE-devin" "$STATE-opencode" "$STATE-claude" "/tmp/thv984-escape-track-$$"' EXIT
TMP="$T"

ok() { printf 'ok %s\n' "$1"; }
fail() { printf 'FAIL %s: got %s\n' "$1" "$2"; exit 1; }
expect() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "'$2' (want '$3')"; fi; }

g() { git -c user.name=t -c user.email=t@t -c commit.gpgsign=false -c core.hooksPath=/dev/null "$@"; }

A="$TMP/repo-a"
B="$TMP/repo-b"
for r in "$A" "$B"; do
  mkdir -p "$r" && g -C "$r" init -q && g -C "$r" commit -q --allow-empty -m init
done
mkdir -p "$B/sub"
echo a >"$A/a.txt"
echo b >"$B/sub/b.txt"
echo gone >"$A/gone.txt"
g -C "$A" add gone.txt && g -C "$A" commit -q -m gone
rm "$A/gone.txt"

mkdir -p "$STATE"
printf '%s\n' "$A/a.txt" "$B/sub/b.txt" "$A/never-existed.txt" >"$STATE/edited"

MSG="New files remain uncommitted: a.txt, sub/b.txt. Commit owned work by exact path, or explain why it stays. Tracking is not proof of ownership."
BLOCK="$(jq -nc --arg r "$MSG" '{decision:"block",reason:$r}')"

# run <dialect> <payload>: prints "rc=<n> <stdout>"
run() {
  local out rc
  out=$(printf '%s' "$2" | "$HOOK" --dialect "$1" 2>/dev/null); rc=$?
  printf 'rc=%s %s' "$rc" "$(printf '%s' "$out" | jq -c . 2>/dev/null || printf '%s' "$out")"
}
stop_payload() { jq -nc --arg s "${2:-$SESSION}" --argjson a "${1:-false}" '{session_id:$s,hook_event_name:"Stop",stop_hook_active:$a}'; }
cursor_payload() { jq -nc --arg s "$SESSION" --argjson n "${1:-0}" --arg st "${2:-completed}" '{conversation_id:$s,hook_event_name:"stop",status:$st,loop_count:$n}'; }
reset() { rm -f "$STATE/uncommitted-asked" "$STATE/uncommitted-notified.paths" "$STATE/uncommitted-strict" "$STATE/uncommitted-kept"; }

expect "empty input has no work to block" "$(run codex '{}')" "rc=0 "
expect "path-traversing session id is ignored" "$(run codex '{"session_id":"../escape"}')" "rc=0 "

reset
expect "claude allows when stop_hook_active is true" "$(run claude "$(stop_payload true)")" "rc=0 "
expect "claude blocks on uncommitted edits, repo-relative across two repos" "$(run claude "$(stop_payload)")" "rc=0 $BLOCK"
# 2026-11-08: a git call per logged path needed minutes on a 10,000-line log, past the 10 s Stop
# timeout, so the gate let those sessions stop unchecked. 20,000 lines over two repos, two pending.
reset
cp "$STATE/edited" "$STATE/edited.orig"
{ for i in $(seq 1 10000); do printf '%s\n' "$A/clean-$i.txt" "$B/elsewhere/clean-$i.txt"; done
  printf '%s\n' "$A/a.txt" "$B/sub/b.txt"; } >"$STATE/edited"
started=$(date +%s)
scaled="$(run claude "$(stop_payload)")"
elapsed=$(( $(date +%s) - started ))
expect "a 20,000-line log still blocks on the two uncommitted files" "$scaled" "rc=0 $BLOCK"
if [ "$elapsed" -le 5 ]; then ok "a 20,000-line log is checked in ${elapsed}s, inside the Stop timeout"
else fail "a 20,000-line log is checked inside the Stop timeout" "${elapsed}s"; fi
mv "$STATE/edited.orig" "$STATE/edited"

expect "claude does not ask the same list twice" "$(run claude "$(stop_payload)")" "rc=0 "

reset
expect "codex blocks with the same message" "$(run codex "$(stop_payload)")" "rc=0 $BLOCK"
reset
expect "devin blocks with the same message" "$(run devin "$(stop_payload)")" "rc=0 $BLOCK"

reset
expect "cursor allows on loop_count > 0" "$(run cursor "$(cursor_payload 1)")" "rc=0 "
expect "cursor allows an aborted stop" "$(run cursor "$(cursor_payload 0 aborted)")" "rc=0 "
expect "cursor follows up" "$(run cursor "$(cursor_payload 0)")" "rc=0 $(jq -nc --arg r "$MSG" '{followup_message:$r}')"

reset
warn_err=$(stop_payload | "$HOOK" --dialect warn 2>&1 >/dev/null); warn_rc=$?
expect "warn dialect exits 0" "$warn_rc" "0"
expect "warn dialect prints the message to stderr" "$warn_err" "$MSG"

reset
expect "claude asks once" "$(run claude "$(stop_payload)")" "rc=0 $BLOCK"
echo c >"$A/c.txt"
echo "$A/c.txt" >>"$STATE/edited"
MSG_C="New files remain uncommitted: c.txt. Commit owned work by exact path, or explain why it stays. Tracking is not proof of ownership."
expect "only a genuinely new path is asked again" "$(run claude "$(stop_payload)")" "rc=0 $(jq -nc --arg r "$MSG_C" '{decision:"block",reason:$r}')"

# Shrinking a list after a partial commit must not repeat an already raised path.
g -C "$A" add c.txt && g -C "$A" commit -q -m partial
expect "partial commit does not repeat old remaining paths" "$(run claude "$(stop_payload)")" "rc=0 "

# Preserve prior-session notifications when upgrading from list-based state.
reset
printf '%s\n' "$A/a.txt|$B/sub/b.txt" >"$STATE/uncommitted-asked"
expect "legacy notifications suppress already raised paths" "$(run claude "$(stop_payload)")" "rc=0 "

# Large output is bounded, but every path is available in an exact absolute manifest.
reset
for n in $(seq 1 20); do
  echo bulk >"$A/bulk-$n.txt"
  echo "$A/bulk-$n.txt" >>"$STATE/edited"
done
large=$(run codex "$(stop_payload)")
case "$large" in *"and 10 more"*"uncommitted-pending.paths"*) ok "large warning is bounded and links the full manifest" ;; *) fail "large warning is bounded" "$large" ;; esac
expect "full manifest retains all 22 uncommitted paths" "$(wc -l <"$STATE/uncommitted-pending.paths" | tr -d ' ')" "22"
expect "a large warning does not repeat on next stop" "$(run codex "$(stop_payload)")" "rc=0 "
for n in $(seq 1 20); do g -C "$A" add "bulk-$n.txt"; done
g -C "$A" commit -q -m bulk

# Absolute identity keeps equal relative names in two repositories independent.
reset
printf '%s\n' "$A/a.txt" >"$STATE/edited"
run codex "$(stop_payload)" >/dev/null
echo peer >"$B/a.txt"
echo "$B/a.txt" >>"$STATE/edited"
expect "same relative name in a second repo is new work" "$(run codex "$(stop_payload)")" "rc=0 $(jq -nc --arg r "New files remain uncommitted: a.txt. Commit owned work by exact path, or explain why it stays. Tracking is not proof of ownership." '{decision:"block",reason:$r}')"
g -C "$B" add a.txt && g -C "$B" commit -q -m peer
printf '%s\n' "$A/a.txt" "$B/sub/b.txt" "$A/gone.txt" >"$STATE/edited"

# Strict: an uncommitted change to a tracked file blocks every stop until committed or kept.
reset
printf '%s\n' "$A/gone.txt" >"$STATE/edited"
# shellcheck disable=SC2016 # the backticks are literal message text
strict_msg() { printf 'Uncommitted edits to tracked files block this stop: %s. Commit owned work by exact path. To leave one uncommitted on purpose, run `%s keep %s <absolute path> "<reason>"`, then name the path and the reason in your reply to Andres.' "$1" "$HOOK" "$SESSION"; }
SBLOCK="$(jq -nc --arg r "$(strict_msg gone.txt)" '{decision:"block",reason:$r}')"
expect "tracked deletion blocks" "$(run claude "$(stop_payload)")" "rc=0 $SBLOCK"
expect "tracked deletion blocks again with stop_hook_active" "$(run claude "$(stop_payload true)")" "rc=0 $SBLOCK"
expect "tracked deletion blocks a third time" "$(run codex "$(stop_payload true)")" "rc=0 $SBLOCK"
guard_err=$(stop_payload true | "$HOOK" --dialect claude 2>&1 >/dev/null); guard_out=$(stop_payload true | "$HOOK" --dialect claude 2>/dev/null)
expect "after 3 blocks on the same set the stop goes through" "$guard_out" ""
case "$guard_err" in "Stopping with uncommitted edits to tracked files after 3 blocks: gone.txt") ok "the let-go names the paths" ;; *) fail "the let-go names the paths" "$guard_err" ;; esac
echo m >"$A/mod.txt"; g -C "$A" add mod.txt && g -C "$A" commit -q -m mod; echo changed >"$A/mod.txt"
echo "$A/mod.txt" >>"$STATE/edited"
expect "a changed set resets the guard" "$(run claude "$(stop_payload true)")" "rc=0 $(jq -nc --arg r "$(strict_msg "gone.txt, mod.txt")" '{decision:"block",reason:$r}')"
reset
expect "cursor follows up past loop_count for tracked edits" "$(run cursor "$(cursor_payload 2)")" "rc=0 $(jq -nc --arg r "$(strict_msg "gone.txt, mod.txt")" '{followup_message:$r}')"
expect "cursor still lets an aborted stop through" "$(run cursor "$(cursor_payload 0 aborted)")" "rc=0 "
reset
keep_rc() { local e; e=$("$HOOK" keep "$@" 2>&1); printf '%s rc=%s' "$e" "$?"; }
expect "keep refuses a relative path" "$(keep_rc "$SESSION" mod.txt "why")" "keep: path must be absolute rc=2"
expect "keep refuses an empty reason" "$(keep_rc "$SESSION" "$A/mod.txt" "  ")" "keep: give a reason rc=2"
expect "keep refuses a traversing session id" "$(keep_rc ../x "$A/mod.txt" "why")" "keep: invalid session id rc=2"
"$HOOK" keep "$SESSION" "$A/mod.txt" "Andres said leave it" >/dev/null
expect "a kept path drops out of the block" "$(run claude "$(stop_payload)")" "rc=0 $SBLOCK"
"$HOOK" keep "$SESSION" "$A/gone.txt" "a peer session owns this deletion" >/dev/null
expect "with every tracked path kept the stop goes through" "$(run claude "$(stop_payload true)")" "rc=0 "
reset
g -C "$A" add mod.txt && g -C "$A" commit -q -m mod2
printf '%s\n' "$A/a.txt" "$B/sub/b.txt" "$A/gone.txt" >"$STATE/edited"

reset
g -C "$A" add a.txt c.txt gone.txt && g -C "$A" commit -q -m a
g -C "$B" add sub/b.txt && g -C "$B" commit -q -m b
expect "committed paths are allowed" "$(run claude "$(stop_payload)")" "rc=0 "

expect "no edit log is allowed" "$(run claude "$(stop_payload false "$SESSION-nolog")")" "rc=0 "
[ -e "/tmp/claude-thoven/$SESSION-nolog" ] && fail "no log leaves no state" "a session dir"
ok "no log leaves no state"

# End to end. The tracker only records under $HOME/thoven, so these repos live under a fake HOME.
mkdir -p "$TMP/home/thoven/frontend-thv-1"
# Canonical, as a real ~/thoven path is: the scan records git's resolved toplevel.
E2E="$(cd "$TMP/home/thoven/frontend-thv-1" && pwd -P)"
g -C "$E2E" init -q && g -C "$E2E" commit -q --allow-empty -m init
e2e_msg() { printf 'New files remain uncommitted: %s. Commit owned work by exact path, or explain why it stays. Tracking is not proof of ownership.' "$1"; }
track() { printf '%s' "$2" | HOME="$(cd "$TMP/home" && pwd -P)" "$TRACK" --dialect "$1" >/dev/null 2>&1; }

S="$SESSION-cursor"
echo x >"$E2E/edited.tsx"
track cursor "$(jq -nc --arg s "$S" --arg f "$E2E/edited.tsx" --arg w "$E2E" '{conversation_id:$s,hook_event_name:"afterFileEdit",workspace_roots:[$w],file_path:$f,edits:[]}')"
echo x >"$E2E/shell.txt"
track cursor "$(jq -nc --arg s "$S" --arg w "$E2E" '{conversation_id:$s,hook_event_name:"afterShellExecution",workspace_roots:[$w],command:"echo x > shell.txt",output:"",duration:1}')"
expect "cursor: afterFileEdit and afterShellExecution feed the stop follow-up" \
  "$(run cursor "$(jq -nc --arg s "$S" '{conversation_id:$s,hook_event_name:"stop",status:"completed",loop_count:0}')")" \
  "rc=0 $(jq -nc --arg r "$(e2e_msg "edited.tsx, shell.txt")" '{followup_message:$r}')"

S="$SESSION-devin"
echo y >"$E2E/devin.rb"
DEVIN_PROJECT_DIR="$E2E" track devin "$(jq -nc --arg s "$S" --arg f "$E2E/devin.rb" '{session_id:$s,hook_event_name:"PostToolUse",tool_name:"edit",tool_input:{file_path:$f},tool_response:{success:true}}')"
expect "devin: a PostToolUse edit feeds the stop block" \
  "$(run devin "$(jq -nc --arg s "$S" '{session_id:$s,hook_event_name:"Stop",stop_hook_active:false}')")" \
  "rc=0 $(jq -nc --arg r "$(e2e_msg "devin.rb")" '{decision:"block",reason:$r}')"

S="$SESSION-opencode"
echo z >"$E2E/opencode.ts"
oc_err=$(HOME="$(cd "$TMP/home" && pwd -P)" node --no-warnings --input-type=module -e '
const { ThovenUncommittedPlugin } = await import(process.argv[1]);
const hooks = await ThovenUncommittedPlugin({ directory: process.argv[2] });
await hooks["tool.execute.after"]({ tool: "edit", sessionID: process.argv[3], callID: "c1", args: { filePath: "opencode.ts" } }, { title: "", output: "", metadata: {} });
await hooks.event({ event: { type: "session.idle", properties: { sessionID: process.argv[3] } } });
' "$ENF/opencode/thoven-uncommitted.js" "$E2E" "$S" 2>&1 >/dev/null)
expect "opencode: tool.execute.after on edit feeds the session.idle warning" "$oc_err" "$(e2e_msg "opencode.ts")"

S="$SESSION-claude"
HOMEP="$(cd "$TMP/home" && pwd -P)"
C="$HOMEP/thoven/backend-thv-2"
mkdir -p "$C/components" && g -C "$C" init -q && g -C "$C" commit -q --allow-empty -m init
jq -nc --arg s "$S" --arg d "$C" '{session_id:$s,cwd:$d,tool_name:"Bash",tool_input:{command:"true"}}' | HOME="$HOMEP" "$TRACK" >/dev/null
echo w >"$C/components/Badge.tsx"
nudge=$(jq -nc --arg s "$S" --arg d "$C" '{session_id:$s,cwd:$d,tool_name:"Bash",tool_input:{command:"cat > components/Badge.tsx"}}' | HOME="$HOMEP" "$TRACK" | jq -r .hookSpecificOutput.hookEventName)
expect "claude: a Bash-written component still gets the UI rule" "$nudge" "PostToolUse"
expect "claude: the Bash scan feeds the stop block" \
  "$(run claude "$(stop_payload false "$S")")" \
  "rc=0 $(jq -nc --arg r "$(e2e_msg "components/Badge.tsx")" '{decision:"block",reason:$r}')"

ESC="thv984-escape-track-$$"
jq -nc --arg s "../../../tmp/$ESC" --arg d "$C" '{session_id:$s,cwd:$d,tool_name:"Edit",tool_input:{file_path:($d+"/x")}}' | HOME="$HOMEP" "$TRACK" >/dev/null
if [ -e "/tmp/$ESC" ]; then fail "a session id with ../ writes nothing outside /tmp/claude-thoven" "/tmp/$ESC exists"; fi
ok "a session id with ../ writes nothing outside /tmp/claude-thoven"

echo "all passed"
