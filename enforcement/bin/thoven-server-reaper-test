#!/usr/bin/env bash
# Exercises thoven-server-reaper against injected process tables. The only real process it
# signals is a sleep this test starts.
set -uo pipefail

TOOL="$(cd "$(dirname "$0")" && pwd)/thoven-server-reaper"
T=$(mktemp -d /tmp/thoven-server-reaper-test.XXXXXX) || exit 1
case "$T" in /tmp/thoven-server-reaper-test.*) ;; *) exit 1 ;; esac
trap 'kill "$victim" 2>/dev/null; rm -rf "$T"' EXIT

export THOVEN_REAPER_KEEP_DIR="$T/keep" THOVEN_REAPER_LOG="$T/log" THOVEN_REAPER_GRACE=2
mkdir -p "$THOVEN_REAPER_KEEP_DIR"
failures=0
pass() { printf 'PASS %s\n' "$1"; }
fail() { printf 'FAIL %s: %s\n' "$1" "$2"; failures=$((failures + 1)); }
run() { : >"$T/log"; THOVEN_REAPER_PS="$T/ps" "$TOOL" "$@" >/dev/null 2>&1; }

: >"$T/ps"
run --dry-run; rc=$?
[ "$rc" = 2 ] && pass "a) empty process table refuses" || fail "a) empty process table refuses" "exit $rc"

"$TOOL" --max-age soon >/dev/null 2>&1; rc=$?
[ "$rc" = 2 ] && pass "b) non-numeric --max-age refuses" || fail "b) non-numeric --max-age refuses" "exit $rc"

cat >"$T/ps" <<'PS'
101 14:02:11 puma 7.2.1 (tcp://0.0.0.0:3001) [backend-x]
102 1-02:00:00 next-server (v14.2.35)
103 03:00:00 node /w/node_modules/.bin/../next/dist/bin/next dev --port 3000
104 1:59:59 puma 7.2.1 (tcp://0.0.0.0:3002) [backend-y]
105 9-00:00:00 node /w/node_modules/.bin/../next/dist/bin/next build
106 5-00:00:00 /usr/sbin/sshd
107 20:00:00 puma 7.2.1 (tcp://0.0.0.0:3003) [backend-kept]
PS
touch "$THOVEN_REAPER_KEEP_DIR/107"
run --dry-run
for pid in 101 102 103; do
	grep -q "stop $pid " "$T/log" && pass "c) stops old server $pid" || fail "c) stops old server $pid" "$(cat "$T/log")"
done
for pid in 104 105 106 107; do
	grep -q "stop $pid " "$T/log" && fail "d) leaves $pid" "listed for stop" || pass "d) leaves $pid (young, build, not a server, or kept)"
done

touch -t "$(date -v-3H +%Y%m%d%H%M 2>/dev/null || date -d '-3 hours' +%Y%m%d%H%M)" "$THOVEN_REAPER_KEEP_DIR/107"
run --dry-run
grep -q "stop 107 " "$T/log" && pass "e) an expired keep marker no longer protects" || fail "e) an expired keep marker no longer protects" "$(cat "$T/log")"

sleep 300 &
victim=$!
printf '%s 3:00:00 next-server (v14.2.35)\n' "$victim" >"$T/ps"
run
sleep 1
kill -0 "$victim" 2>/dev/null && fail "f) really stops an old server" "pid $victim alive" || pass "f) really stops an old server"

[ "$failures" = 0 ] && echo "ALL PASS" || { echo "$failures FAILED"; exit 1; }
