#!/usr/bin/env bash
# Admission gate for heavy jobs: waits for a free slot, free memory and a calm load average,
# then runs the command. Replaces the per-session $TMPDIR/dispatch/heavy.sh lock.
set -uo pipefail

usage() {
  cat <<'USAGE'
usage: thoven-load-gate [--profile FILE] [--slots N] [--weight N] [--min-free PCT]
                        [--max-load N] [--wait SECS] [--name LABEL] [--check-only]
                        -- <command...>

  --profile FILE   JSON host profile; its slots, minFreePct, maxLoad, waitSeconds,
                   blockAtPressure and minDiskFreeGiB replace the defaults below
  --slots N        jobs allowed at once            (default 2,    env THOVEN_GATE_SLOTS)
  --weight N       slots this job takes at once    (default 1)
  --min-free PCT   least system memory free, in %  (default 20,   env THOVEN_GATE_MIN_FREE)
  --max-load N     highest 1-minute load average   (default 12,   env THOVEN_GATE_MAX_LOAD)
  --wait SECS      give up after this long         (default 1500, env THOVEN_GATE_WAIT)
  --name LABEL     name shown to the jobs queued behind this one
  --check-only     wait on the checks only, take no slot; run the command if given
  Also refuses at memory pressure level 4 (blockAtPressure, 0 turns it off) and below
  minDiskFreeGiB free on the volume holding $HOME (default 0, off).
  Flags win over env, env wins over the profile. The command sees THOVEN_GATE_SLOT, the
  lowest slot it holds. THOVEN_GATE_DISABLE=1 runs the command at once.
  THOVEN_GATE_DIR moves the slot directory.
  Exit codes: the command's own, 2 for bad usage, 75 when the wait ran out.
USAGE
}

bad_usage() { usage >&2; exit 2; }

log() { printf 'thoven-load-gate: %s\n' "$*" >&2; }

# Prints "<field> <value>" for each gate field the profile sets; exits non-zero on a bad profile.
read_profile() {
  python3 -I - "$1" <<'PY'
import json, sys
fields = {"slots": int, "minFreePct": int, "maxLoad": float, "waitSeconds": int,
          "blockAtPressure": int, "minDiskFreeGiB": int}
try:
    with open(sys.argv[1]) as f:
        profile = json.load(f)
except (OSError, ValueError) as e:
    sys.exit(f"thoven-load-gate: cannot read profile {sys.argv[1]}: {e}")
if not isinstance(profile, dict):
    sys.exit(f"thoven-load-gate: profile {sys.argv[1]} is not a JSON object")
for key, kind in fields.items():
    if key not in profile:
        continue
    value = profile[key]
    ok = isinstance(value, int) if kind is int else isinstance(value, (int, float))
    if isinstance(value, bool) or not ok or value < 0:
        sys.exit(f"thoven-load-gate: profile {key} must be a non-negative {kind.__name__}")
    print(key, value)
PY
}

slots=2
min_free=20
max_load=12
wait_secs=1500
block_pressure=4
min_disk_gib=0
weight=1
poll="${THOVEN_GATE_POLL:-5}"
dir="${THOVEN_GATE_DIR:-/tmp/thoven-load-gate-$(id -u)}"
profile=""
label=""
check_only=0
unset opt_slots opt_min_free opt_max_load opt_wait

while [ $# -gt 0 ]; do
  case "$1" in
    --profile) [ $# -ge 2 ] || bad_usage; profile="$2"; shift 2 ;;
    --slots) [ $# -ge 2 ] || bad_usage; opt_slots="$2"; shift 2 ;;
    --weight) [ $# -ge 2 ] || bad_usage; weight="$2"; shift 2 ;;
    --min-free) [ $# -ge 2 ] || bad_usage; opt_min_free="$2"; shift 2 ;;
    --max-load) [ $# -ge 2 ] || bad_usage; opt_max_load="$2"; shift 2 ;;
    --wait) [ $# -ge 2 ] || bad_usage; opt_wait="$2"; shift 2 ;;
    --name) [ $# -ge 2 ] || bad_usage; label="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    --check-only) check_only=1; shift ;;
    --) shift; break ;;
    *) bad_usage ;;
  esac
done

if [ -n "$profile" ]; then
  fields="$(read_profile "$profile")" || bad_usage
  while read -r key value; do
    case "$key" in
      slots) slots="$value" ;;
      minFreePct) min_free="$value" ;;
      maxLoad) max_load="$value" ;;
      waitSeconds) wait_secs="$value" ;;
      blockAtPressure) block_pressure="$value" ;;
      minDiskFreeGiB) min_disk_gib="$value" ;;
    esac
  done <<<"$fields"
fi
slots="${opt_slots-${THOVEN_GATE_SLOTS:-$slots}}"
min_free="${opt_min_free-${THOVEN_GATE_MIN_FREE:-$min_free}}"
max_load="${opt_max_load-${THOVEN_GATE_MAX_LOAD:-$max_load}}"
wait_secs="${opt_wait-${THOVEN_GATE_WAIT:-$wait_secs}}"

is_int() { case "$1" in '' | *[!0-9]*) return 1 ;; esac; }
is_num() { case "$1" in '' | *[!0-9.]* | *.*.*) return 1 ;; esac; }
is_int "$slots" && [ "$slots" -ge 1 ] || bad_usage
is_int "$weight" && [ "$weight" -ge 1 ] && [ "$weight" -le "$slots" ] || bad_usage
is_int "$min_free" || bad_usage
is_num "$max_load" || bad_usage
is_int "$wait_secs" || bad_usage
is_int "$poll" && [ "$poll" -ge 1 ] || bad_usage

cmd_text=""
if [ $# -gt 0 ]; then
  cmd_text="$*"
  case "$cmd_text" in *[![:space:]]*) ;; *) bad_usage ;; esac
elif [ "$check_only" = 0 ]; then
  bad_usage
fi

[ -n "$label" ] || label="${cmd_text:0:60}"

if [ "${THOVEN_GATE_DISABLE:-0}" = 1 ]; then
  [ $# -gt 0 ] || exit 0
  exec "$@"
fi

# Fail-open on purpose: an unreadable probe yields empty output and the gate admits.
mem_free() { memory_pressure 2>/dev/null | sed -n 's/.*System-wide memory free percentage: *\([0-9][0-9]*\)%.*/\1/p' | head -n 1; }
load_now() { sysctl -n vm.loadavg 2>/dev/null | awk '$2 ~ /^[0-9.]+$/ { print $2 }'; }
pressure_now() { sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null | awk '$1 ~ /^[0-9]+$/ { print $1; exit }'; }
disk_free_kib() { df -Pk "${HOME:-/}" 2>/dev/null | awk 'NR == 2 && $4 ~ /^[0-9]+$/ { print $4 }'; }

held=""
child=""
# shellcheck disable=SC2329  # runs from the traps below
release() {
  local i
  for i in $held; do rm -rf "$dir/slot.$i"; done
  held=""
}
trap 'release' EXIT
trap '[ -n "$child" ] && kill "$child" 2>/dev/null; release; exit 130' INT
trap '[ -n "$child" ] && kill "$child" 2>/dev/null; release; exit 143' TERM

owner_field() { sed -n "s/^$2=//p" "$1/owner" 2>/dev/null | head -n 1; }

# Returns 0 once the directory is ours, taking it over when its owner pid is dead.
claim() {
  local pid
  mkdir "$1" 2>/dev/null && return 0
  pid="$(owner_field "$1" pid)"
  if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then return 1; fi
  rm -rf "$1"
  mkdir "$1" 2>/dev/null
}

# Takes $weight slots and exports the lowest as THOVEN_GATE_SLOT, or takes none and returns 1.
take_slot() {
  local i taken first
  i=1
  taken=0
  while [ "$i" -le "$slots" ]; do
    if claim "$dir/slot.$i"; then
      printf 'pid=%s\nstart=%s\nlabel=%s\ncommand=%s\n' "$$" "$(date +%s)" "$label" "$cmd_text" > "$dir/slot.$i/owner"
      held="$held $i"
      taken=$((taken + 1))
      [ "$taken" = 1 ] && first="$i"
      if [ "$taken" -ge "$weight" ]; then
        export THOVEN_GATE_SLOT="$first"
        return 0
      fi
    fi
    i=$((i + 1))
  done
  release
  return 1
}

# Sets $why to the reasons admission is refused, empty when admitted.
check() {
  local mem load pressure disk busy nbusy i d pid since now
  why=""
  mem="$(mem_free)"
  if [ -n "$mem" ] && [ "$mem" -lt "$min_free" ]; then why="memory free ${mem}% < ${min_free}%"; fi
  load="$(load_now)"
  if [ -n "$load" ] && [ "$(awk -v l="$load" -v m="$max_load" 'BEGIN { print (l > m) }')" = 1 ]; then
    why="${why:+$why; }load $load > $max_load"
  fi
  if [ "$block_pressure" -gt 0 ]; then
    pressure="$(pressure_now)"
    if [ -n "$pressure" ] && [ "$pressure" -ge "$block_pressure" ]; then
      why="${why:+$why; }memory pressure level $pressure >= $block_pressure"
    fi
  fi
  if [ "$min_disk_gib" -gt 0 ]; then
    disk="$(disk_free_kib)"
    if [ -n "$disk" ] && [ "$disk" -lt $((min_disk_gib * 1048576)) ]; then
      why="${why:+$why; }disk free $((disk / 1048576))GiB < ${min_disk_gib}GiB"
    fi
  fi
  [ -n "$why" ] && return 1
  [ "$check_only" = 1 ] && return 0
  take_slot && return 0
  busy=""
  nbusy=0
  now="$(date +%s)"
  i=1
  while [ "$i" -le "$slots" ]; do
    d="$dir/slot.$i"
    if [ -d "$d" ]; then
      pid="$(owner_field "$d" pid)"
      since="$(owner_field "$d" start)"
      busy="$busy${busy:+, }pid ${pid:-?} \"$(owner_field "$d" label)\" $((now - ${since:-$now}))s"
      nbusy=$((nbusy + 1))
    fi
    i=$((i + 1))
  done
  why="slots $nbusy/$slots busy${busy:+: $busy}"
  [ "$weight" -gt 1 ] && why="$why; weight $weight needs $weight free"
  return 1
}

if [ "$check_only" = 0 ]; then mkdir -p "$dir" || { log "cannot create $dir"; exit 2; }; fi

start="$(date +%s)"
next_msg=30
while ! check; do
  elapsed=$(($(date +%s) - start))
  if [ "$elapsed" -ge "$wait_secs" ]; then
    log "gave up after ${elapsed}s, nothing was run ($why)"
    exit 75
  fi
  if [ "$elapsed" -ge "$next_msg" ]; then
    log "queued ${elapsed}s ($why)"
    next_msg=$((next_msg + 30))
  fi
  left=$((wait_secs - elapsed))
  sleep "$([ "$left" -lt "$poll" ] && echo "$left" || echo "$poll")"
done

[ $# -gt 0 ] || exit 0
"$@" <&0 &
child=$!
wait "$child"
rc=$?
child=""
exit "$rc"
