#!/usr/bin/env bash
# Exercises thoven-worktree against throwaway repos under a temp dir; never reads or writes
# the real ~/thoven checkouts.
set -uo pipefail

TOOL="$(cd "$(dirname "$0")" && pwd)/thoven-worktree"
T=$(mktemp -d /tmp/thv974.XXXXXX) || exit 1
case "$T" in /tmp/thv974.*) ;; *) exit 1 ;; esac
trap 'rm -rf "$T"' EXIT
TMP="$(cd "$T" && pwd -P)"

export THOVEN_ROOT="$TMP"
export THOVEN_WORKTREE_SKIP_INSTALL=1
export GIT_CONFIG_GLOBAL="$TMP/gitconfig"
export GIT_CONFIG_NOSYSTEM=1
git config --file "$GIT_CONFIG_GLOBAL" user.name test
git config --file "$GIT_CONFIG_GLOBAL" user.email test@example.com
git config --file "$GIT_CONFIG_GLOBAL" init.defaultBranch main

# Postgres and install stubs log to $TMP instead of touching a real server or registry.
STUB="$TMP/stubbin"
mkdir -p "$STUB"
# shellcheck disable=SC2016
printf '#!/bin/sh\necho "npx $*" >> "$TMP/installs"\n' > "$STUB/npx"
# shellcheck disable=SC2016
printf '#!/bin/sh\n[ "$1" = check ] && exit "${BUNDLE_CHECK_RC:-1}"\necho "bundle $*" >> "$TMP/installs"\n' > "$STUB/bundle"
# shellcheck disable=SC2016
printf '#!/bin/sh\necho "createdb $*" >> "$TMP/db.log"\nexit "${CREATEDB_RC:-0}"\n' > "$STUB/createdb"
# shellcheck disable=SC2016
printf '#!/bin/sh\necho "dropdb $*" >> "$TMP/db.log"\n' > "$STUB/dropdb"
# shellcheck disable=SC2016
printf '#!/bin/sh\ncat "$TMP/dbs" 2>/dev/null\n' > "$STUB/psql"
chmod +x "$STUB"/*
export TMP PATH="$STUB:$PATH"
installs() { cat "$TMP/installs" 2>/dev/null; }
dblog() { cat "$TMP/db.log" 2>/dev/null; }
env_line() { grep "^$2=" "$1"; }

ok() { printf 'ok %s\n' "$1"; }
fail() { printf 'FAIL %s: got %s\n' "$1" "$2"; exit 1; }
expect() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "'$2' (want '$3')"; fi; }
has_line() {
  if printf '%s\n' "$2" | grep -qxF -- "$3"; then ok "$1"; else fail "$1" "'$2' (want a line '$3')"; fi
}
BANG_LINE='^!{20,}$'
loud() {
  if printf '%s\n' "$2" | grep -qE "$BANG_LINE" && printf '%s\n' "$2" | grep -qxF -- "$3" &&
    printf '%s\n' "$2" | grep -qxF -- "$4"; then ok "$1"; else fail "$1" "'$2' (want a line of ! then '$3' and '$4')"; fi
}

# make_repo <name> <setup-fn>: bare origin with one commit on main, cloned to $TMP/<name>
make_repo() {
  local name="$1" seed="$TMP/seed-$1"
  git init -q "$seed"
  (cd "$seed" && "$2" && git add -A && git commit -qm init)
  git clone -q --bare "$seed" "$TMP/origin-$name.git"
  git clone -q "$TMP/origin-$name.git" "$TMP/$name"
}
seed_frontend() {
  printf '{ "name": "fe", "packageManager": "npm@10.9.9" }\n' > package.json
  printf '.env.local\n' > .gitignore
}
seed_backend() {
  printf "source 'https://rubygems.org'\n" > Gemfile
  mkdir storage && touch storage/.keep
  mkdir -p bin db/migrate && touch db/migrate/.keep
  # shellcheck disable=SC2016
  printf '#!/bin/sh\necho "rails $* TEST_DATABASE_URL=$TEST_DATABASE_URL in $PWD" >> "$TMP/installs"\n' > bin/rails
  chmod +x bin/rails
  printf '.env\nstorage/*\n!storage/.keep\n' > .gitignore
}

make_repo frontend seed_frontend
printf 'X=1\n' > "$TMP/frontend/.env.local"
make_repo backend seed_backend
mkdir -p "$TMP/backend/storage/ab"
printf 'blob\n' > "$TMP/backend/storage/ab/blob"
printf 'Y=1\nDATABASE_URL=postgresql://localhost/thoven_development\nTEST_DATABASE_URL=postgresql://localhost/neondb_test\n' > "$TMP/backend/.env"

FE="$TMP/frontend-thv-969"
out="$("$TOOL" create fe tooling 969 2>/dev/null)"; code=$?
expect "create fe exit" "$code" 0
expect "create fe stdout is only the path" "$out" "$FE"
expect "create fe last line" "$(printf '%s\n' "$out" | tail -n 1)" "$FE"
expect "fe branch" "$(git -C "$FE" branch --show-current)" "tooling/thv-969"
expect "fe HEAD is origin/main" "$(git -C "$FE" rev-parse HEAD)" "$(git -C "$TMP/origin-frontend.git" rev-parse main)"
if up="$(git -C "$FE" rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then fail "fe has no upstream" "$up"; else ok "fe has no upstream"; fi
expect "fe .env.local copied" "$(cat "$FE/.env.local")" "X=1"

printf 'X=2\n' > "$FE/.env.local"
out="$("$TOOL" create fe tooling 969 2>/dev/null)"; code=$?
expect "second create exit" "$code" 0
expect "second create same path" "$out" "$FE"
expect "existing .env.local kept" "$(cat "$FE/.env.local")" "X=2"

BE="$TMP/backend-thv-970"
out="$("$TOOL" create be api 970 2>/dev/null)"; code=$?
expect "create be exit" "$code" 0
expect "create be path" "$out" "$BE"
expect "be branch" "$(git -C "$BE" branch --show-current)" "api/thv-970"
if [ -L "$BE/storage/ab" ]; then ok "be storage/ab is a symlink"; else fail "be storage/ab is a symlink" "$(ls -ld "$BE/storage/ab" 2>&1)"; fi
expect "be storage/ab target" "$(readlink "$BE/storage/ab")" "$TMP/backend/storage/ab"
if [ -e "$BE/storage/.keep" ] && [ ! -L "$BE/storage/.keep" ]; then ok "be .keep not linked"; else fail "be .keep not linked" "$(ls -ld "$BE/storage/.keep" 2>&1)"; fi
expect "be .env copied" "$(env_line "$BE/.env" Y)" "Y=1"
expect "be gets its own test database" "$(env_line "$BE/.env" TEST_DATABASE_URL)" \
  "TEST_DATABASE_URL=postgresql://localhost/neondb_test_api_thv970"
expect "be test database is set once" "$(grep -c '^TEST_DATABASE_URL=' "$BE/.env")" "1"
# backend's THV-89 boot guard refuses a branch whose explicit DATABASE_URL names thoven_development,
# and allows database.yml's fallback to that same shared database.
expect "be without migrations drops the explicit shared DATABASE_URL" "$(env_line "$BE/.env" DATABASE_URL)" ""
expect "be without migrations copies no database" "$(dblog)" ""
expect "main .env untouched" "$(env_line "$TMP/backend/.env" TEST_DATABASE_URL)" \
  "TEST_DATABASE_URL=postgresql://localhost/neondb_test"
expect "main .env keeps its DATABASE_URL" "$(env_line "$TMP/backend/.env" DATABASE_URL)" \
  "DATABASE_URL=postgresql://localhost/thoven_development"

"$TOOL" create be live-lessons 973 >/dev/null 2>&1
expect "hyphenated area becomes an identifier" "$(env_line "$TMP/backend-thv-973/.env" TEST_DATABASE_URL)" \
  "TEST_DATABASE_URL=postgresql://localhost/neondb_test_live_lessons_thv973"

out="$(printf '{"name":"tooling-thv-971","cwd":"%s"}' "$TMP/frontend" | "$TOOL" hook 2>/dev/null; printf x)"
out="${out%x}"
expect "hook stdout exact" "$out" "$TMP/frontend-thv-971"$'\n'
expect "hook branch" "$(git -C "$TMP/frontend-thv-971" branch --show-current)" "tooling/thv-971"

out="$(printf '{"name":"api/thv-972","cwd":"%s"}' "$TMP/backend" | "$TOOL" hook 2>/dev/null)"
expect "hook <area>/thv-<n> on backend" "$out" "$TMP/backend-thv-972"

out="$(printf '{"name":"bold-oak-a3f2","cwd":"%s"}' "$TMP/frontend" | "$TOOL" hook 2>/dev/null)"; code=$?
expect "hook generated name exit" "$code" 0
expect "hook generated name is a scratch worktree" "$out" "$TMP/frontend/.claude/worktrees/bold-oak-a3f2"
expect "scratch branch" "$(git -C "$out" branch --show-current)" "worktree-bold-oak-a3f2"
expect "scratch .env.local copied" "$(cat "$out/.env.local")" "X=1"

out="$(printf '{"name":"calm-fir-b1c2","cwd":"%s"}' "$TMP/backend" | "$TOOL" hook 2>/dev/null)"
expect "backend scratch shares main's databases" "$(cat "$out/.env")" "$(cat "$TMP/backend/.env")"

out="$(printf '{"name":"../escape","cwd":"%s"}' "$TMP/frontend" | "$TOOL" hook 2>/dev/null)"; code=$?
expect "hook unsafe name exit" "$code" 2
expect "hook unsafe name stdout empty" "$out" ""

out="$("$TOOL" create fe BAD_area 1 2>/dev/null)"; code=$?
expect "create bad area exit" "$code" 2
expect "create bad area stdout empty" "$out" ""

mkdir -p "$TMP/frontend-thv-5"
"$TOOL" create fe tooling 5 >/dev/null 2>&1; code=$?
expect "non-worktree path exit" "$code" 1

"$TOOL" >/dev/null 2>&1; code=$?
expect "no args exit" "$code" 2

FE="$TMP/frontend-thv-969"
mkdir -p "$TMP/elsewhere/node_modules"
ln -s "$TMP/elsewhere/node_modules" "$FE/node_modules"
env -u THOVEN_WORKTREE_SKIP_INSTALL "$TOOL" bootstrap "$FE" >/dev/null 2>&1
expect "rerun with node_modules symlink runs no npm ci" "$(installs)" ""
expect "linked node_modules left intact" "$(readlink "$FE/node_modules")" "$TMP/elsewhere/node_modules"
rm "$FE/node_modules"
env -u THOVEN_WORKTREE_SKIP_INSTALL "$TOOL" bootstrap "$FE" >/dev/null 2>&1
expect "no node_modules runs npm ci" "$(installs)" "npx -y npm@10.9.9 ci"
rm -f "$TMP/installs"
env -u THOVEN_WORKTREE_SKIP_INSTALL BUNDLE_CHECK_RC=0 "$TOOL" bootstrap "$BE" >/dev/null 2>&1
expect "satisfied bundle runs no bundle install, then prepares its own test database" "$(installs)" \
  "rails db:test:prepare TEST_DATABASE_URL=postgresql://localhost/neondb_test_api_thv970 in $BE"
rm -f "$TMP/installs"
env -u THOVEN_WORKTREE_SKIP_INSTALL BUNDLE_CHECK_RC=1 "$TOOL" bootstrap "$BE" >/dev/null 2>&1
expect "unsatisfied bundle runs bundle install" "$(installs | head -n 1)" "bundle install"

# A Codex desktop worktree: detached at a stale local main, then its setup step runs bootstrap.
git clone -q "$TMP/origin-backend.git" "$TMP/upstream-backend"
push_upstream() {
  (cd "$TMP/upstream-backend" && printf '%s\n' "$RANDOM" >> Gemfile && git commit -qam next && git push -q origin main)
}
STALE="$(git -C "$TMP/backend" rev-parse HEAD)"
push_upstream
CODEX="$TMP/codex/wt1/backend"
git -C "$TMP/backend" worktree add -q --detach "$CODEX" "$STALE"
"$TOOL" bootstrap "$CODEX" >/dev/null 2>&1; code=$?
expect "codex bootstrap exit" "$code" 0
expect "fresh behind worktree moves to origin/main" "$(git -C "$CODEX" rev-parse HEAD)" \
  "$(git -C "$TMP/origin-backend.git" rev-parse main)"
expect "local main is not moved by bootstrap" "$(git -C "$TMP/backend" rev-parse HEAD)" "$STALE"
if [[ "$(env_line "$CODEX/.env" TEST_DATABASE_URL)" =~ ^TEST_DATABASE_URL=postgresql://localhost/neondb_test_wt_[0-9a-f]{8}$ ]]; then
  ok "non-ticket worktree gets a test database named for its path"
else
  fail "non-ticket worktree gets a test database named for its path" "$(env_line "$CODEX/.env" TEST_DATABASE_URL)"
fi

OWN="$TMP/codex/wt2/backend"
git -C "$TMP/backend" worktree add -q --detach "$OWN" "$STALE"
(cd "$OWN" && printf 'x\n' > mine && git add mine && git commit -qm mine)
OWN_HEAD="$(git -C "$OWN" rev-parse HEAD)"
err="$("$TOOL" bootstrap "$OWN" 2>&1 >/dev/null)"
expect "worktree with its own commit is not moved" "$(git -C "$OWN" rev-parse HEAD)" "$OWN_HEAD"
loud "worktree with its own commit gets a loud warning" "$err" \
  "WARNING: $OWN is 1 commits behind origin/main" "Rebase onto origin/main before you build on it."

DIRTY="$TMP/codex/wt3/backend"
git -C "$TMP/backend" worktree add -q --detach "$DIRTY" "$STALE"
printf 'edit\n' >> "$DIRTY/Gemfile"
err="$("$TOOL" bootstrap "$DIRTY" 2>&1 >/dev/null)"
expect "worktree with edits is not moved" "$(git -C "$DIRTY" rev-parse HEAD)" "$STALE"
expect "worktree edits kept" "$(tail -n 1 "$DIRTY/Gemfile")" "edit"
loud "worktree with edits gets a loud warning" "$err" \
  "WARNING: $DIRTY is 1 commits behind origin/main" "Rebase onto origin/main before you build on it."

SHARED="$TMP/codex/shared/backend"
git -C "$TMP/backend" push -q origin "$STALE:refs/heads/shared"
git -C "$TMP/backend" fetch -q origin shared:refs/remotes/origin/shared
git -C "$TMP/backend" worktree add -q -b shared "$SHARED" origin/shared
err="$("$TOOL" bootstrap "$SHARED" 2>&1 >/dev/null)"
expect "branch that exists on origin is not moved" "$(git -C "$SHARED" rev-parse HEAD)" "$STALE"
loud "branch that exists on origin gets a loud warning" "$err" \
  "WARNING: $SHARED is 1 commits behind origin/main" "Rebase onto origin/main before you build on it."

# post-checkout runs from lefthook inside the checked-out tree; it can only warn.
post_checkout() { (cd "$1" && "$TOOL" post-checkout 0000000 "$(git rev-parse HEAD)" "$2" >/dev/null) 2>&1; }
PC="$TMP/codex/wt4/backend"
git -C "$TMP/backend" worktree add -q --detach "$PC" "$STALE"
err="$(post_checkout "$PC" 1)"; code=$?
expect "post-checkout on a stale tree exit" "$code" 0
loud "post-checkout on a stale tree warns loudly" "$err" \
  "WARNING: $PC is 1 commits behind origin/main" "Run: git merge --ff-only origin/main"
err="$(post_checkout "$PC" 0)"; code=$?
expect "post-checkout of a file exit" "$code" 0
expect "post-checkout of a file is silent" "$err" ""
err="$(post_checkout "$CODEX" 1)"; code=$?
expect "post-checkout on a current tree exit" "$code" 0
expect "post-checkout on a current tree is silent" "$err" ""
err="$(post_checkout "$OWN" 1)"; code=$?
expect "post-checkout on a tree with its own commits exit" "$code" 0
expect "post-checkout on a tree with its own commits is silent" "$err" ""
err="$(cd "$TMP" && "$TOOL" post-checkout 2>&1 >/dev/null)"; code=$?
expect "post-checkout outside a repo, without args, exit" "$code" 0

# A branch that adds a migration gets its own dev database, copied from thoven_development.
(cd "$BE" && touch db/migrate/20260930000000_add_thing.rb && git add db/migrate && git commit -qm migration)
rm -f "$TMP/db.log"
"$TOOL" bootstrap "$BE" >/dev/null 2>&1
expect "migration branch copies the dev database" "$(dblog)" "createdb -T thoven_development thoven_dev_api_thv970"
expect "migration branch points DATABASE_URL at its copy" "$(env_line "$BE/.env" DATABASE_URL)" \
  "DATABASE_URL=postgresql://localhost/thoven_dev_api_thv970"
# The match comes first and the list is long, so a grep -q that quits early would SIGPIPE psql.
{ printf 'thoven_dev_api_thv970\n'; seq 1 50000 | sed 's/^/filler_/'; } > "$TMP/dbs"
rm -f "$TMP/db.log"
"$TOOL" bootstrap "$BE" >/dev/null 2>&1
expect "an existing copy is reused" "$(dblog)" ""
rm -f "$TMP/dbs"

BUSY="$TMP/backend-thv-974"
"$TOOL" create be busy 974 >/dev/null 2>&1
(cd "$BUSY" && touch db/migrate/20260930000001_other.rb && git add db/migrate && git commit -qm migration)
CREATEDB_RC=1 "$TOOL" bootstrap "$BUSY" >/dev/null 2>&1; code=$?
expect "a failed copy still bootstraps" "$code" 0
expect "a failed copy leaves the shared fallback" "$(env_line "$BUSY/.env" DATABASE_URL)" ""

OWNDB="$TMP/backend-thv-976"
"$TOOL" create be owndb 976 >/dev/null 2>&1
(cd "$OWNDB" && touch db/migrate/20260930000002_mine.rb && git add db/migrate && git commit -qm migration)
printf 'DATABASE_URL=postgresql://localhost/my_own_db\n' >> "$OWNDB/.env"
rm -f "$TMP/db.log"
"$TOOL" bootstrap "$OWNDB" >/dev/null 2>&1
expect "a migration branch keeps a DATABASE_URL it chose" "$(env_line "$OWNDB/.env" DATABASE_URL)" \
  "DATABASE_URL=postgresql://localhost/my_own_db"
expect "a migration branch with its own DATABASE_URL copies nothing" "$(dblog)" ""

LINKED="$TMP/codex/wt5/backend"
git -C "$TMP/backend" worktree add -q --detach "$LINKED" "$(git -C "$TMP/origin-backend.git" rev-parse main)"
ln -s "$TMP/backend/.env" "$LINKED/.env"
MAIN_ENV="$(cat "$TMP/backend/.env")"
err="$("$TOOL" bootstrap "$LINKED" 2>&1 >/dev/null)"
expect "a symlinked .env leaves main's .env alone" "$(cat "$TMP/backend/.env")" "$MAIN_ENV"
if [ -L "$LINKED/.env" ]; then ok "a symlinked .env stays a symlink"; else fail "a symlinked .env stays a symlink" "$(ls -l "$LINKED/.env")"; fi
has_line "a symlinked .env is reported" "$err" "thoven-worktree: leaving it, .env is a symlink (shared)"
rm -f "$TMP/installs"
env -u THOVEN_WORKTREE_SKIP_INSTALL BUNDLE_CHECK_RC=0 "$TOOL" bootstrap "$LINKED" >/dev/null 2>&1
expect "a symlinked .env never reaches db:test:prepare" "$(installs)" ""

# orphan-dbs lists what no live worktree's .env names, and drops nothing.
printf '%s\n' neondb_test neondb_test2 neondb_test_api_thv970 neondb_test_old thoven_development \
  thoven_dev_api_thv970 thoven_prod_rehearsal postgres > "$TMP/dbs"
rm -f "$TMP/db.log"
out="$("$TOOL" orphan-dbs 2>/dev/null)"; code=$?
expect "orphan-dbs exit" "$code" 0
expect "orphan-dbs lists only unreferenced Thoven databases" "$out" \
  "$(printf '%s\n' neondb_test2 neondb_test_old thoven_prod_rehearsal)"
expect "orphan-dbs drops nothing" "$(dblog)" ""

# The shared databases are reached through database.yml's fallback, so no .env need name them.
mkdir -p "$TMP/bare-root" && git init -q "$TMP/bare-root/backend"
printf '%s\n' neondb_test thoven_development neondb_test_old > "$TMP/dbs"
out="$(THOVEN_ROOT="$TMP/bare-root" "$TOOL" orphan-dbs 2>/dev/null)"
expect "orphan-dbs never lists the shared databases" "$out" "neondb_test_old"
printf '%s\n' neondb_test neondb_test2 neondb_test_api_thv970 neondb_test_old thoven_development \
  thoven_dev_api_thv970 thoven_prod_rehearsal postgres > "$TMP/dbs"

# remove drops the worktree's own databases, never a shared one, and nothing when git refuses.
printf 'edit\n' >> "$BUSY/Gemfile"
"$TOOL" remove "$BUSY" >/dev/null 2>&1; code=$?
expect "remove of an edited worktree fails" "$code" 1
expect "failed remove drops nothing" "$(dblog)" ""
if [ -d "$BUSY" ]; then ok "failed remove keeps the tree"; else fail "failed remove keeps the tree" "gone"; fi

"$TOOL" remove "$TMP/backend" >/dev/null 2>&1; code=$?
expect "remove refuses the main checkout" "$code" 1

FOREIGN="$TMP/backend-thv-975"
"$TOOL" create be foreign 975 >/dev/null 2>&1
printf 'TEST_DATABASE_URL=postgresql://localhost/neondb_test_someone_thv1\n' >> "$FOREIGN/.env"
rm -f "$TMP/db.log"
"$TOOL" remove "$FOREIGN" >/dev/null 2>&1; code=$?
expect "remove of a worktree naming another's database exit" "$code" 0
expect "remove drops no database named for another worktree" "$(dblog)" ""

"$TOOL" remove "$BE" >/dev/null 2>&1; code=$?
expect "remove exit" "$code" 0
if [ -e "$BE" ]; then fail "remove deletes the tree" "still there"; else ok "remove deletes the tree"; fi
expect "remove drops the worktree's own databases" "$(dblog)" \
  "$(printf '%s\n' "dropdb --if-exists neondb_test_api_thv970" "dropdb --if-exists thoven_dev_api_thv970")"

echo "all passed"
