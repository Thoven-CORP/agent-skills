#!/usr/bin/env bash
# Keeps ~/thoven/frontend and ~/thoven/backend at origin/main. Local main is never merged into or
# committed on, so it only ever fast-forwards, and only when it is on main and clean. Every other
# worktree is only read: one with uncommitted work is reported. herdr and Codex desktop cut new
# worktrees from the local checkout's HEAD, so a stale local main made them start days behind GitHub.
# Every line also goes, timestamped, to $THOVEN_SYNC_LOG (default ~/.thoven/sync.log).
set -uo pipefail

THOVEN_ROOT="${THOVEN_ROOT:-$HOME/thoven}"
REPOS=(frontend backend)
LOCK="${TMPDIR:-/tmp}/thoven-sync.lock"
LOG="${THOVEN_SYNC_LOG:-$HOME/.thoven/sync.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null

emit() {
  printf '%s\n' "$1"
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$LOG" 2>/dev/null
}

# Two runs at once would race on the same fetch and ref locks.
take_lock() {
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; return 0; }
  local pid
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    emit "another thoven-sync (pid $pid) is running, skipped"
    return 1
  fi
  rm -rf "$LOCK"
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; return 0; }
  emit "another thoven-sync took the lock, skipped"
  return 1
}

# sync_main <checkout>: fast-forward if safe. Prints what happened, without the path.
sync_main() {
  local main="$1" branch ahead behind
  git -C "$main" fetch --quiet --prune origin || { echo "skipped, git fetch --prune origin failed"; return; }
  git -C "$main" rev-parse --verify --quiet origin/main >/dev/null || { echo "skipped, no origin/main"; return; }
  branch="$(git -C "$main" symbolic-ref --quiet --short HEAD)"
  [ "$branch" = main ] || { echo "skipped, on '${branch:-detached HEAD}', not main"; return; }
  [ -z "$(git -C "$main" status --porcelain)" ] || { echo "skipped, uncommitted changes"; return; }
  ahead="$(git -C "$main" rev-list --count origin/main..HEAD)"
  if [ "$ahead" -gt 0 ]; then
    echo "skipped, main has $ahead commit(s) origin/main lacks; local main only fast-forwards, so move them to a branch by hand"
    return
  fi
  behind="$(git -C "$main" rev-list --count HEAD..origin/main)"
  [ "$behind" -gt 0 ] || { echo "at origin/main"; return; }
  if git -C "$main" merge --ff-only --quiet origin/main >/dev/null 2>&1; then
    echo "fast-forwarded $behind commit(s) to origin/main"
  else
    echo "skipped, git merge --ff-only origin/main failed"
  fi
}

# worktrees <checkout>: "<path>\t<branch or detached>" for every other live worktree.
worktrees() {
  local main="$1" path="" head="" branch="" line seen=0
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "HEAD "*) head="${line#HEAD }" ;;
      "branch "*) branch="${line#branch refs/heads/}" ;;
      "")
        # git lists the main worktree first
        seen=$((seen + 1))
        if [ "$seen" -gt 1 ] && [ -n "$head" ] && [ -d "$path" ]; then
          printf '%s\t%s\n' "$path" "${branch:-detached}"
        fi
        path="" head="" branch=""
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain; echo)
}

# --no-optional-locks keeps status from refreshing, and so writing, another session's index.
dirty_count() {
  git --no-optional-locks -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' '
}

report() {
  local repo main path branch count
  for repo in "${REPOS[@]}"; do
    main="$THOVEN_ROOT/$repo"
    git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || { emit "$main: not a git checkout, skipped"; continue; }
    main="$(cd "$main" && pwd -P)"
    emit "$main: $(sync_main "$main")"
    while IFS=$'\t' read -r path branch; do
      count="$(dirty_count "$path")"
      [ "$count" -gt 0 ] && emit "$path ($branch): $count uncommitted file(s)"
    done < <(worktrees "$main")
  done
}

case "${1:-}" in
  "")
    take_lock || exit 0
    trap 'rm -rf "$LOCK"' EXIT
    report
    ;;
  *) echo "usage: thoven-sync" >&2; exit 2 ;;
esac
