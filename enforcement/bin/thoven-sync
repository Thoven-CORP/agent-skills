#!/usr/bin/env bash
# Keeps ~/thoven/frontend and ~/thoven/backend at origin/main. Local main is never merged into or
# committed on, so it only ever fast-forwards, and only when it is on main and clean. Every other
# worktree is only read: one with uncommitted work is reported. herdr and Codex desktop cut new
# worktrees from the local checkout's HEAD, so a stale local main made them start days behind GitHub.
# Every line also goes, timestamped, to $THOVEN_SYNC_LOG (default ~/.thoven/sync.log).
set -uo pipefail

THOVEN_ROOT="${THOVEN_ROOT:-$HOME/thoven}"
REPOS=(frontend backend)
LOCK="${TMPDIR:-/tmp}/thoven-sync.lock"
LOG="${THOVEN_SYNC_LOG:-$HOME/.thoven/sync.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null

emit() {
  printf '%s\n' "$1"
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$LOG" 2>/dev/null
}

# Two runs at once would race on the same fetch and ref locks.
take_lock() {
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; return 0; }
  local pid
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    emit "another thoven-sync (pid $pid) is running, skipped"
    return 1
  fi
  rm -rf "$LOCK"
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; return 0; }
  emit "another thoven-sync took the lock, skipped"
  return 1
}

# install_after <checkout> <old HEAD>: a fast-forward that changes pnpm-lock.yaml leaves
# node_modules behind it, so imports fail. pnpm install replaces packages under a running dev
# server, so a dev server on these packages skips it. Prints "; <what happened>" or nothing.
install_after() {
  local main="$1" before="$2" pid
  [ -f "$main/pnpm-lock.yaml" ] || return 0
  git -C "$main" diff --quiet "$before" HEAD -- pnpm-lock.yaml && return 0
  if pid="$(dev_server "$main")"; then
    printf "; pnpm-lock.yaml changed, pnpm install skipped: dev server pid %s uses this tree's node_modules. Stop it, then run: cd %s && pnpm install --frozen-lockfile" "$pid" "$main"
  elif (cd "$main" && pnpm install --frozen-lockfile) >/dev/null 2>&1; then
    printf '; pnpm-lock.yaml changed, ran pnpm install --frozen-lockfile'
  else
    printf '; pnpm-lock.yaml changed, but pnpm install --frozen-lockfile failed. Run: cd %s && pnpm install --frozen-lockfile' "$main"
  fi
}

# package_trees <checkout>: the checkout and every worktree whose node_modules links into its own.
package_trees() {
  local main="$1" path branch
  printf '%s\n' "$main"
  while IFS=$'\t' read -r path branch; do
    [ "$(cd "$path/node_modules" 2>/dev/null && pwd -P)" = "$main/node_modules" ] &&
      (cd "$path" && pwd -P)
  done < <(worktrees "$main")
}

# dev_server <checkout>: the pid of a dev server (next, vite) working in a tree on its packages.
dev_server() {
  local trees pid cwd tree
  trees="$(package_trees "$1")"
  while read -r pid _; do
    cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
    [ -n "$cwd" ] || continue
    while IFS= read -r tree; do
      case "$cwd/" in "$tree"/*) echo "$pid"; return 0 ;; esac
    done <<<"$trees"
  done < <(ps -axo pid=,command= | awk '/next dev|next-server|vite/ && !/awk/')
  return 1
}

# sync_main <checkout>: fast-forward if safe. Prints what happened, without the path.
sync_main() {
  local main="$1" branch ahead behind before err
  git -C "$main" fetch --quiet --prune origin || { echo "skipped, git fetch --prune origin failed"; return; }
  git -C "$main" rev-parse --verify --quiet origin/main >/dev/null || { echo "skipped, no origin/main"; return; }
  branch="$(git -C "$main" symbolic-ref --quiet --short HEAD)"
  [ "$branch" = main ] || { echo "skipped, on '${branch:-detached HEAD}', not main"; return; }
  # A fast-forward never touches untracked files, and refuses on its own to overwrite one.
  [ -z "$(git --no-optional-locks -C "$main" status --porcelain --untracked-files=no)" ] ||
    { echo "skipped, uncommitted changes"; return; }
  ahead="$(git -C "$main" rev-list --count origin/main..HEAD)"
  if [ "$ahead" -gt 0 ]; then
    echo "skipped, main has $ahead commit(s) origin/main lacks; local main only fast-forwards, so move them to a branch by hand"
    return
  fi
  behind="$(git -C "$main" rev-list --count HEAD..origin/main)"
  [ "$behind" -gt 0 ] || { echo "at origin/main"; return; }
  before="$(git -C "$main" rev-parse HEAD)"
  if err="$(git -C "$main" merge --ff-only --quiet origin/main 2>&1 >/dev/null)"; then
    echo "fast-forwarded $behind commit(s) to origin/main$(install_after "$main" "$before")"
  else
    echo "skipped, git merge --ff-only origin/main failed: ${err%%$'\n'*}"
  fi
}

# worktrees <checkout>: "<path>\t<branch or detached>" for every other live worktree.
worktrees() {
  local main="$1" path="" head="" branch="" line seen=0
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "HEAD "*) head="${line#HEAD }" ;;
      "branch "*) branch="${line#branch refs/heads/}" ;;
      "")
        # git lists the main worktree first
        seen=$((seen + 1))
        if [ "$seen" -gt 1 ] && [ -n "$head" ] && [ -d "$path" ]; then
          printf '%s\t%s\n' "$path" "${branch:-detached}"
        fi
        path="" head="" branch=""
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain; echo)
}

# --no-optional-locks keeps status from refreshing, and so writing, another session's index.
dirty_count() {
  git --no-optional-locks -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' '
}

report() {
  local repo main path branch count
  for repo in "${REPOS[@]}"; do
    main="$THOVEN_ROOT/$repo"
    git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || { emit "$main: not a git checkout, skipped"; continue; }
    main="$(cd "$main" && pwd -P)"
    emit "$main: $(sync_main "$main")"
    while IFS=$'\t' read -r path branch; do
      count="$(dirty_count "$path")"
      if [ "$count" -gt 0 ]; then emit "$path ($branch): $count uncommitted file(s)"; fi
    done < <(worktrees "$main")
  done
}

case "${1:-}" in
  "")
    take_lock || exit 0
    trap 'rm -rf "$LOCK"' EXIT
    report
    ;;
  *) echo "usage: thoven-sync" >&2; exit 2 ;;
esac
