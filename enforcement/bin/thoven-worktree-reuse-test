#!/usr/bin/env bash
# Proves thoven-worktree's reuse decision table with real git on throwaway repos. It runs create
# only under --dry-run or on a path that ends before any install, so it needs no pnpm, bundle,
# database or network. Stubs for those tools record any call, and the test fails if one happens.
# pass never fails, so A && pass || flunk is a safe if-else here.
# shellcheck disable=SC2015
set -uo pipefail

TOOL="$(cd "$(dirname "$0")" && pwd)/thoven-worktree"
T=$(mktemp -d /tmp/thvreuse.XXXXXX) || exit 1
case "$T" in /tmp/thvreuse.*) ;; *) exit 1 ;; esac
trap 'rm -rf "$T"' EXIT
TMP="$(cd "$T" && pwd -P)"

export THOVEN_ROOT="$TMP"
export THOVEN_WORKTREE_SKIP_INSTALL=1
export THOVEN_WORKTREE_REGISTRY="$TMP/projects.tsv"
# thoven-branch-prune has its own test; here a stub records each call.
printf '#!/bin/sh\necho "prune $*" >> "$TMP/prunes"\n' > "$TMP/prune-stub" && chmod +x "$TMP/prune-stub"
export THOVEN_BRANCH_PRUNE="$TMP/prune-stub"
export GIT_CONFIG_GLOBAL="$TMP/gitconfig"
export GIT_CONFIG_NOSYSTEM=1
git config --file "$GIT_CONFIG_GLOBAL" user.name test
git config --file "$GIT_CONFIG_GLOBAL" user.email test@example.com
git config --file "$GIT_CONFIG_GLOBAL" init.defaultBranch main

STUB="$TMP/stubbin"
mkdir -p "$STUB"
for tool in pnpm npx bundle createdb dropdb psql; do
  # shellcheck disable=SC2016
  printf '#!/bin/sh\necho "%s $*" >> "$TMP/forbidden"\nexit 1\n' "$tool" > "$STUB/$tool"
done
chmod +x "$STUB"/*
export TMP PATH="$STUB:$PATH"

git init -q "$TMP/seed"
(cd "$TMP/seed" && echo hi > README && git add -A && git commit -qm init)
git clone -q --bare "$TMP/seed" "$TMP/origin.git"
git clone -q "$TMP/origin.git" "$TMP/backend"
# A Project branch counts only when origin has it, so the fixture pushes the one the tree is on.
git -C "$TMP/backend" branch int/proj origin/main
git -C "$TMP/backend" push -q origin int/proj
git -C "$TMP/backend" worktree add -q "$TMP/proj-tree" int/proj
git -C "$TMP/backend" worktree add -q -b tooling/thv-70 "$TMP/other-tree" origin/main
PROJ_TREE="$(cd "$TMP/proj-tree" && pwd -P)"

FAILS=0
pass() { printf 'PASS %s\n' "$1"; }
flunk() { printf 'FAIL %s: %s\n' "$1" "$2"; FAILS=$((FAILS + 1)); }
# run <cmd...>: sets RC, OUT (stdout), ERR (stderr).
run() {
  OUT="$("$@" 2>"$TMP/err")"
  RC=$?
  ERR="$(cat "$TMP/err")"
}
check() { # <name> <want rc> <pattern in stderr+stdout, or empty>
  local name="$1" want="$2" pat="$3"
  if [ "$RC" != "$want" ]; then flunk "$name" "exit $RC, want $want. stderr: $ERR"; return; fi
  if [ -n "$pat" ] && ! printf '%s\n%s\n' "$OUT" "$ERR" | grep -qF -- "$pat"; then
    flunk "$name" "output lacks '$pat'. stdout: $OUT stderr: $ERR"
    return
  fi
  pass "$name"
}

run "$TOOL" register-project Proj be int/proj
check "register-project writes a row" 0 "registered"

# a
run "$TOOL" create be tooling 11 --kind review
check "a: review kind refuses with exit 3 and a read recipe" 3 "archive origin/main"
[ -z "$OUT" ] && pass "a: refusal prints no path on stdout" || flunk "a: stdout" "$OUT"
run "$TOOL" create be tooling 11 --project Proj --kind audit
check "a: audit with a known Project points at its tree" 3 "$PROJ_TREE"

# b
run "$TOOL" create be tooling 12 --kind design
check "b: design kind refuses and names the Writes to line" 3 "Writes to:"

# c
run "$TOOL" create be tooling 13 --kind research --new "need my own"
check "c: --new does not override research" 3 "--new does not apply"
run "$TOOL" create be tooling 13 --kind plan --new "need my own"
check "c: --new does not override plan" 3 "--new does not apply"

# d
run "$TOOL" create be tooling 14 --project Proj --kind build
check "d: build with a registered tree exits 4" 4 "end every commit with THV-14"
[ "$(printf '%s\n' "$OUT" | tail -n 1)" = "$PROJ_TREE" ] && pass "d: last stdout line is the tree path" ||
  flunk "d: last stdout line" "'$OUT' (want $PROJ_TREE)"
printf '%s\n' "$ERR" | grep -qF "$TMP/other-tree" && pass "d: lists the other tooling/ tree" ||
  flunk "d: candidates" "$ERR"
run "$TOOL" create be tooling 14 --project Proj --kind fix
check "d: fix is treated like build" 4 ""

# e
run "$TOOL" create be tooling 15 --project Proj --kind build --new "parallel hotfix" --dry-run
check "e: --new passes the reuse check" 0 "Reason: parallel hotfix"
printf '%s\n' "$ERR" | grep -qF "worktree add --no-track -b tooling/thv-15 $TMP/backend-thv-15 origin/main" &&
  pass "e: the plan cuts from origin/main" || flunk "e: plan" "$ERR"
run "$TOOL" create be tooling 15 --project Proj --kind build --new "" --dry-run
check "e: an empty --new reason is a usage error" 2 ""

# f
run "$TOOL" register-project Gone be int/gone
run "$TOOL" create be tooling 16 --project Gone --kind build --dry-run
check "f: a stale row is reported and falls through" 0 "stale row: branch int/gone"
run "$TOOL" where Gone be
check "f: where reports the stale row" 1 "stale row"
run "$TOOL" where Nobody be
check "f: where with no row and no branch names the derived default" 1 "nobody/integration is not on origin"
run "$TOOL" where Proj be
check "f: where prints the validated path" 0 "$PROJ_TREE"
git -C "$TMP/backend" branch int/lonely origin/main
git -C "$TMP/backend" push -q origin int/lonely
run "$TOOL" register-project Lonely be int/lonely
run "$TOOL" where Lonely be
check "f: where reports a branch with no tree" 1 "no worktree has int/lonely"
run "$TOOL" create be tooling 17 --project Lonely --kind build --dry-run
check "f: row 4 plans a tree on the existing branch" 0 "worktree add $TMP/backend-lonely int/lonely"
git -C "$TMP/backend" worktree remove --force "$TMP/other-tree"
rm -rf "$TMP/proj-tree"
run "$TOOL" where Proj be
check "f: a tree missing on disk is stale" 1 "gone from disk"

# g
run "$TOOL" register-project "" be b
check "g: register-project with an empty project exits 2" 2 ""
run "$TOOL" register-project Proj be ""
check "g: register-project with an empty branch exits 2" 2 ""
run "$TOOL" register-project Proj xx b
check "g: register-project with a bad repo exits 2" 2 ""
run "$TOOL" where "" be
check "g: where with an empty project exits 2" 2 ""
run "$TOOL" register-project Proj be int/proj
[ "$(grep -c '^Proj	be	' "$THOVEN_WORKTREE_REGISTRY")" = 1 ] && pass "g: register-project is idempotent" ||
  flunk "g: idempotent" "$(cat "$THOVEN_WORKTREE_REGISTRY")"
! grep -q "$TMP" "$THOVEN_WORKTREE_REGISTRY" &&
  pass "g: the registry holds no absolute path" || flunk "g: no absolute path" "$(cat "$THOVEN_WORKTREE_REGISTRY")"

# h
run "$TOOL" create be tooling 18 --dry-run
check "h: the old call shape reaches the create path" 0 "dry-run: would fetch origin main"
[ "$(printf '%s\n' "$OUT" | tail -n 1)" = "$TMP/backend-thv-18" ] && pass "h: last stdout line is the tree path" ||
  flunk "h: last stdout line" "$OUT"
[ ! -e "$TMP/backend-thv-18" ] && pass "h: dry-run created nothing" || flunk "h: dry-run" "tree exists"
run "$TOOL" create be tooling
check "h: too few arguments is a usage error" 2 ""
run "$TOOL" create be tooling 19 --kind bogus
check "h: an unknown kind is a usage error" 2 ""

# i: a Project's integration branch is its row's, else <slug>/integration, and it counts only when
# origin has it.
run "$TOOL" create be tooling 20 --project "Academy Positioning & Public Pages" --kind build --dry-run
check "i: no row plans <slug>/integration at <repo>-<slug>" 0 \
  "worktree add --no-track -b academy-positioning-public-pages/integration $TMP/backend-academy-positioning-public-pages origin/main"
check "i: the dry-run plans the push" 0 "push -u origin academy-positioning-public-pages/integration"
[ "$(printf '%s\n' "$OUT" | tail -n 1)" = "$TMP/backend-academy-positioning-public-pages" ] &&
  pass "i: last stdout line is the Project tree path" || flunk "i: last stdout line" "$OUT"
! printf '%s\n' "$ERR" | grep -qF "register-project" && pass "i: no register-project nag" || flunk "i: nag" "$ERR"
[ ! -e "$TMP/backend-academy-positioning-public-pages" ] && pass "i: dry-run created no tree" || flunk "i: dry-run tree" "exists"
[ -z "$(git -C "$TMP/origin.git" ls-remote . refs/heads/academy-positioning-public-pages/integration)" ] &&
  pass "i: dry-run pushed nothing" || flunk "i: dry-run push" "origin has the branch"

# The frontend-thv-1355 case: a row whose branch lives in a local tree but not on origin.
git -C "$TMP/backend" worktree add -q -b academy-positioning/thv-1355 "$TMP/backend-thv-1355" origin/main
run "$TOOL" register-project Academy be academy-positioning/thv-1355
run "$TOOL" where Academy be
check "i: a row whose branch is local only is stale" 1 "academy-positioning/thv-1355 exists locally but not on origin"
[ -z "$OUT" ] && pass "i: where prints no path for a stale row" || flunk "i: stale where stdout" "$OUT"
run "$TOOL" create be tooling 21 --project Academy --kind build --dry-run
check "i: create refuses a local-only row branch" 1 "Push it if it is live work"

# PR #361: origin deleted the branch, and the remote-tracking ref was left behind.
git -C "$TMP/backend" push -q origin origin/main:refs/heads/int/leftover
git -C "$TMP/backend" fetch -q origin
git -C "$TMP/origin.git" branch -D -q int/leftover
git -C "$TMP/backend" show-ref --verify --quiet refs/remotes/origin/int/leftover &&
  pass "i: fixture keeps refs/remotes/origin/int/leftover" || flunk "i: fixture" "no remote-tracking ref"
run "$TOOL" register-project Leftover be int/leftover
run "$TOOL" where Leftover be
check "i: a left-behind remote-tracking ref is stale" 1 "stale row: branch int/leftover is not on origin"
run "$TOOL" create be tooling 22 --project Leftover --kind build --dry-run
check "i: a stale row with nothing local is cut afresh from origin/main" 0 \
  "worktree add --no-track -b int/leftover $TMP/backend-leftover origin/main"
mv "$TMP/origin.git" "$TMP/origin.git.off"
run "$TOOL" where Leftover be
check "i: with origin unreachable, the remote-tracking ref decides" 1 "no worktree has int/leftover"
mv "$TMP/origin.git.off" "$TMP/origin.git"

# A derived branch that exists locally only is never reused silently.
git -C "$TMP/backend" branch local-only/integration origin/main
run "$TOOL" create be tooling 23 --project "Local Only" --kind build --dry-run
check "i: dry-run refuses a local-only derived branch" 1 "local-only/integration exists locally but not on origin"
run "$TOOL" create be tooling 23 --project "Local Only" --kind build
check "i: create refuses a local-only derived branch" 1 "delete it if it landed"
[ ! -e "$TMP/backend-local-only" ] && [ ! -e "$TMP/backend-thv-23" ] && pass "i: the refusal cut no tree" ||
  flunk "i: refusal tree" "$(ls "$TMP")"

# Empty input is refused, never read as a live branch.
run "$TOOL" where "" be
check "i: where with an empty project exits 2" 2 ""
run "$TOOL" where "&&&" be
check "i: where with a punctuation-only project exits 2" 2 ""
run "$TOOL" create be tooling 24 --project " !!! " --kind build --dry-run
check "i: create with a punctuation-only project exits 2" 2 ""
printf 'Blank\tbe\t\n' >> "$THOVEN_WORKTREE_REGISTRY"
run "$TOOL" where Blank be
check "i: a row with an empty branch is not live" 1 "blank/integration is not on origin"
[ -z "$OUT" ] && pass "i: an empty-branch row prints no path" || flunk "i: empty-branch where stdout" "$OUT"
run "$TOOL" create be tooling 25 --project Blank --kind build --dry-run
check "i: an empty-branch row plans the derived default" 0 "worktree add --no-track -b blank/integration $TMP/backend-blank origin/main"

[ ! -e "$TMP/forbidden" ] && pass "no install or database tool was called" || flunk "forbidden tools" "$(cat "$TMP/forbidden")"

if [ "$FAILS" -eq 0 ]; then echo "ALL PASS"; else echo "$FAILS FAILED"; fi
[ "$FAILS" -eq 0 ]
