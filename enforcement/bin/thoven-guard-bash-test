#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2088 # test commands are text handed to the guard, unexpanded on purpose
# Runs thoven-guard-bash in each dialect against a temp HOME, so the shared-worktree check
# sees $HOME/thoven/... without touching the real trees.
set -uo pipefail

GUARD="$(cd "$(dirname "$0")/.." && pwd)/hooks/thoven-guard-bash"
TMP="$(cd "$(mktemp -d)" && pwd -P)"
SESSION="guard-test-$$"
trap 'rm -rf "$TMP" "/tmp/claude-thoven/$SESSION" "/tmp/claude-thoven/$SESSION-other" "/tmp/thv984-escape-$$"' EXIT
export HOME="$TMP"
WT="$TMP/thoven/frontend-thv-1"
mkdir -p "$WT"
unset DEVIN_PROJECT_DIR
# A stub gh on PATH, so the merged-PR check never reaches GitHub (THV-1067). It logs its args to
# $HOME/gh-args, exits with $HOME/gh-rc when that exists, else prints $HOME/gh-out (no file: no PR).
mkdir -p "$TMP/bin"
cat >"$TMP/bin/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$HOME/gh-args"
[ -f "$HOME/gh-rc" ] && exit "$(cat "$HOME/gh-rc")"
cat "$HOME/gh-out" 2>/dev/null
exit 0
STUB
chmod +x "$TMP/bin/gh"
export PATH="$TMP/bin:$PATH"

ok() { printf 'ok %s\n' "$1"; }
fail() { printf 'FAIL %s: got %s\n' "$1" "$2"; failed=1; }
failed=0
expect() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "'$2' (want '$3')"; fi; }

# run <dialect> <payload> [dir to run in]: prints "rc=<n> <stdout>"
run() {
  local out rc
  out=$(cd "${3:-$TMP}" && printf '%s' "$2" | "$GUARD" --dialect "$1" 2>/dev/null); rc=$?
  printf 'rc=%s %s' "$rc" "$(printf '%s' "$out" | jq -c . 2>/dev/null || printf '%s' "$out")"
}
claude_payload() { jq -nc --arg c "$1" --arg d "$2" --arg s "$SESSION" '{session_id:$s,cwd:$d,tool_input:{command:$c}}'; }
cursor_payload() { jq -nc --arg c "$1" --arg d "$2" --arg s "$SESSION" '{command:$c,cwd:$d,conversation_id:$s}'; }
devin_payload() { jq -nc --arg c "$1" --arg s "$SESSION" '{hook_event_name:"PreToolUse",tool_name:"exec",tool_input:{command:$c,shell_id:"main"},session_id:$s}'; }

deny_reason=$(run claude "$(claude_payload "git stash push" "$WT")" | sed 's/^rc=0 //' | jq -r .hookSpecificOutput.permissionDecision)
expect "claude denies git stash push" "$deny_reason" "deny"
expect "claude allows git status silently" "$(run claude "$(claude_payload "git status" "$WT")")" "rc=0 "

expect "cursor denies git stash push" "$(run cursor "$(cursor_payload "git stash push" "$WT")" | sed 's/^rc=0 //' | jq -r .permission)" "deny"
expect "cursor allow is explicit" "$(run cursor "$(cursor_payload "git status" "$WT")")" 'rc=0 {"permission":"allow"}'
expect "cursor allow outside ~/thoven is explicit" "$(run cursor "$(cursor_payload "git stash push" "/tmp")")" 'rc=0 {"permission":"allow"}'

expect "devin with DEVIN_PROJECT_DIR blocks" "$(DEVIN_PROJECT_DIR="$WT" run devin "$(devin_payload "git stash push")")" "rc=2 "
expect "devin without DEVIN_PROJECT_DIR judges from its working dir" "$(run devin "$(devin_payload "git stash push")" "$WT")" "rc=2 "
expect "devin allows git status" "$(run devin "$(devin_payload "git status")" "$WT")" "rc=0 "

g() { git -c user.name=t -c user.email=t@t -c commit.gpgsign=false -c core.hooksPath=/dev/null "$@"; }
ORIGIN="$TMP/origin.git"
REPO="$TMP/thoven/backend"
g init -q --bare "$ORIGIN"
g init -q -b main "$REPO"
g -C "$REPO" commit -q --allow-empty -m init
g -C "$REPO" remote add origin "$ORIGIN"
g -C "$REPO" push -q -u origin main
g -C "$REPO" branch pushed && g -C "$REPO" push -q origin pushed
g -C "$REPO" branch local-only && g -C "$REPO" worktree add -q "$TMP/thoven/wt-dirty" pushed
g -C "$REPO" worktree add -q "$TMP/thoven/wt-clean" -b clean-pushed main && g -C "$REPO" push -q origin clean-pushed
g -C "$REPO" worktree add -q "$TMP/thoven/wt-ahead" -b ahead main
g -C "$TMP/thoven/wt-ahead" commit -q --allow-empty -m "not pushed"
echo scratch >"$TMP/thoven/wt-dirty/notes.md"
g -C "$REPO" branch unpushed-commit ahead
# A squash merge leaves the branch's commits off origin: squash-merged is the tip that merged,
# squash-plus carries one more local commit on top of it.
g -C "$REPO" branch squash-merged ahead
g -C "$REPO" branch squash-plus "$(g -C "$REPO" commit-tree "ahead^{tree}" -p ahead -m "after the merge")"
decision() {
  local out
  out=$(run "$1" "$(claude_payload "$2" "${3:-$REPO}")" | sed 's/^rc=0 //')
  [ -n "$out" ] && jq -r .hookSpecificOutput.permissionDecision <<<"$out" || echo allow
}

expect "worktree remove --force refuses untracked files" "$(decision claude "git worktree remove --force ../wt-dirty")" "deny"
expect "worktree remove -f refuses commits not on origin" "$(decision claude "git worktree remove -f $TMP/thoven/wt-ahead")" "deny"
expect "worktree remove --force allows a clean, pushed tree" "$(decision claude "git worktree remove --force ../wt-clean")" "allow"
expect "plain worktree remove of a clean, pushed tree is allowed" "$(decision claude "git worktree remove ../wt-clean")" "allow"
expect "branch -D refuses commits not on origin" "$(decision claude "git branch -D unpushed-commit")" "deny"
expect "branch --delete --force refuses commits not on origin" "$(decision claude "git branch --delete --force unpushed-commit")" "deny"
expect "git -C <repo> branch -D is judged in that repo" "$(decision claude "git -C $REPO branch -D unpushed-commit" "$WT")" "deny"
expect "cd <repo> && git branch -D is judged in that repo" "$(decision claude "cd $REPO && git branch -D unpushed-commit" "$WT")" "deny"
expect "branch -D allows a branch whose commits are on origin" "$(decision claude "git branch -D pushed local-only")" "allow"
expect "branch -d is left to git's own merged check" "$(decision claude "git branch -d unpushed-commit")" "allow"
expect "worktree remove -ff (bundled) refuses untracked files" "$(decision claude "git worktree remove -ff ../wt-dirty")" "deny"
expect "abbreviated --del --forc with a quoted branch refuses unpushed work" "$(decision claude "git branch --del --forc 'unpushed-commit'")" "deny"
expect "(cd \$HOME/... && git branch -D) is judged in that repo" "$(decision claude '(cd $HOME/thoven/backend && git branch -D unpushed-commit)' "$WT")" "deny"
expect "cursor denies branch -D of unpushed work" "$(run cursor "$(cursor_payload "git branch -D unpushed-commit" "$REPO")" | sed 's/^rc=0 //' | jq -r .permission)" "deny"
expect "devin blocks worktree remove --force of a dirty tree" "$(run devin "$(devin_payload "git worktree remove --force ../wt-dirty")" "$REPO")" "rc=2 "

expect "echo \$(git stash) is denied" "$(decision claude 'echo $(git stash)')" "deny"
expect "x=\$(git reset --hard) is denied" "$(decision claude 'x=$(git reset --hard)')" "deny"
expect "git -C <path> reset --hard is denied" "$(decision claude "git -C $TMP/thoven/wt-clean reset --hard" "$WT")" "deny"
expect "git -C <path> clean -fd is denied" "$(decision claude "git -C $TMP/thoven/wt-clean clean -fd" "$WT")" "deny"
expect "git -C <path> stash is denied" "$(decision claude "git -C $TMP/thoven/wt-clean stash" "$WT")" "deny"
expect "git -C <path> checkout -- <unedited path> is denied" "$(decision claude "git -C $TMP/thoven/wt-dirty checkout -- notes.md" "$WT")" "deny"
expect "git -C <path> restore <unedited path> is denied" "$(decision claude "git -C $TMP/thoven/wt-dirty restore notes.md" "$WT")" "deny"
expect "cd <path> then git reset --hard is denied" "$(decision claude "cd $TMP/thoven/wt-clean && git reset --hard" "$WT")" "deny"
mkdir -p "/tmp/claude-thoven/$SESSION" && printf '%s\n' "$TMP/thoven/wt-dirty/notes.md" >"/tmp/claude-thoven/$SESSION/edited"
expect "git -C <path> stash push -- <edited path> is allowed" "$(decision claude "git -C $TMP/thoven/wt-dirty stash push -- notes.md" "$WT")" "allow"
expect "cd <path> then git restore <edited path> is allowed" "$(decision claude "cd $TMP/thoven/wt-dirty && git restore notes.md" "$WT")" "allow"
expect "git -C <path> checkout -- <edited path> is allowed" "$(decision claude "git -C $TMP/thoven/wt-dirty checkout -- notes.md" "$WT")" "allow"
expect "git -C <path> restore --staged is allowed" "$(decision claude "git -C $TMP/thoven/wt-dirty restore --staged notes.md" "$WT")" "allow"
expect "git -C <path> stash list is allowed" "$(decision claude "git -C $TMP/thoven/wt-clean stash list" "$WT")" "allow"

# fast <command>: the verdict from $REPO, or "hang" when the guard runs past 5s
fast() {
  local out rc
  out=$(claude_payload "$1" "$REPO" | perl -e 'alarm 5; exec @ARGV' "$GUARD" --dialect claude 2>/dev/null); rc=$?
  [ "$rc" -ge 128 ] && { echo hang; return; }
  [ -n "$out" ] && jq -r .hookSpecificOutput.permissionDecision <<<"$out" || echo allow
}
expect "git -C with no directory returns and allows" "$(fast "git -C")" "allow"
expect "git -c with no setting returns and allows" "$(fast "git -c")" "allow"

expect "~/thoven itself is guarded: reset --hard" "$(decision claude "git reset --hard" "$TMP/thoven")" "deny"
expect "~/thoven itself is guarded: worktree remove -f" "$(decision claude "git worktree remove -f wt-dirty" "$TMP/thoven")" "deny"

ESC="thv984-escape-$$"
esc_payload=$(jq -nc --arg c "git stash" --arg d "$WT" --arg s "../../../tmp/$ESC" '{session_id:$s,cwd:$d,tool_input:{command:$c}}')
expect "a session id with ../ is still guarded" "$(run claude "$esc_payload" | sed 's/^rc=0 //' | jq -r .hookSpecificOutput.permissionDecision)" "deny"
if [ -e "/tmp/$ESC" ]; then fail "a session id with ../ writes nothing outside /tmp/claude-thoven" "/tmp/$ESC exists"; else ok "a session id with ../ writes nothing outside /tmp/claude-thoven"; fi

# branch -D after a squash merge (THV-1067)
reason() { run claude "$(claude_payload "$1" "$REPO")" | sed 's/^rc=0 //' | jq -r '.hookSpecificOutput.permissionDecisionReason // empty'; }
g -C "$REPO" rev-parse ahead >"$HOME/gh-out"
expect "branch -D allows a branch whose merged PR head is its tip" "$(decision claude "git branch -D squash-merged")" "allow"
expect "the merged check asks gh for that branch's merged PRs" "$(grep -c -- '--head squash-merged --state merged' "$HOME/gh-args")" "1"
expect "branch -D refuses a merged branch with a commit added after the merge" "$(decision claude "git branch -D squash-plus")" "deny"
rm -f "$HOME/gh-out"
expect "branch -D refuses when gh finds no merged PR" "$(decision claude "git branch -D squash-merged")" "deny"
case "$(reason "git branch -D squash-merged")" in *"merged PR"*) ok "the refusal names the merged-PR check" ;; *) fail "the refusal names the merged-PR check" "$(reason "git branch -D squash-merged")" ;; esac
g -C "$REPO" rev-parse ahead >"$HOME/gh-out"; echo 1 >"$HOME/gh-rc"
expect "branch -D refuses when gh fails" "$(decision claude "git branch -D squash-merged")" "deny"
rm -f "$HOME/gh-out" "$HOME/gh-rc"

expect "a for loop's do does not hide branch -D" "$(decision claude "for b in x; do git branch -D unpushed-commit; done")" "deny"
expect "branch -D of a variable the guard cannot resolve is refused" "$(decision claude 'for b in x y; do git branch -D $b; done')" "deny"
expect "then does not hide reset --hard" "$(decision claude "if true; then git reset --hard; fi")" "deny"
expect "a loop of harmless git stays allowed" "$(decision claude "for b in x; do git status; done")" "allow"

# Whole-suite runs (THV-1047)
expect "pnpm vitest run with no path is refused" "$(decision claude "pnpm vitest run")" "deny"
expect "npx vitest with no path is refused" "$(decision claude "npx vitest")" "deny"
expect "pnpm run test:run with no path is refused" "$(decision claude "pnpm run test:run")" "deny"
expect "pnpm test:coverage is refused" "$(decision claude "pnpm test:coverage")" "deny"
expect "bundle exec rspec with no path is refused" "$(decision claude "bundle exec rspec")" "deny"
expect "bin/rspec after cd is refused" "$(decision claude "cd backend && bin/rspec --fail-fast")" "deny"
expect "vitest run on a file is allowed" "$(decision claude "pnpm vitest run __tests__/route-list.test.ts")" "allow"
expect "test:run with a path is allowed" "$(decision claude "pnpm run test:run __tests__/a.test.ts")" "allow"
expect "rspec on a spec is allowed" "$(decision claude "bundle exec rspec spec/models/user_spec.rb")" "allow"
expect "THOVEN_FULL_SUITE=1 allows the full suite" "$(decision claude "THOVEN_FULL_SUITE=1 bundle exec rspec")" "allow"
expect "prose naming vitest run stays allowed" "$(decision claude "echo pnpm vitest run")" "allow"

# A separator inside quotes, or a line of a heredoc body, is not a command boundary.
expect "a quoted pipe in a pgrep pattern is not a command" "$(decision claude 'pgrep -fl "vitest|rspec|rails runner"')" "allow"
expect "a quoted pipe in a grep pattern is not a command" "$(decision claude "grep -E 'x|git stash|y' notes.md")" "allow"
expect "a quoted pipe in a ps | grep pattern is not a command" "$(decision claude 'ps aux | grep -E "node.*vitest|rspec"')" "allow"
expect "a heredoc body read by python is not judged" "$(decision claude $'python3 - <<\'PY\'\nimport subprocess\nbundle exec rspec\ngit stash push\ngit checkout -- app\nPY')" "allow"
expect "a <<- heredoc body written by cat is not judged" "$(decision claude $'cat > notes.md <<-EOF\n\tbundle exec rspec\n\tgit stash push\n\tgit checkout -- app\n\tEOF\necho done')" "allow"
expect "a heredoc body with an apostrophe does not hide the command after it" "$(decision claude $'cat <<\'EOF\' > notes.md\nit\'s here\nEOF\ngit stash push')" "deny"
expect "a heredoc body read by bash is judged" "$(decision claude $'bash <<\'EOF\'\necho cleaning\ngit clean -fd\nEOF')" "deny"
expect "a heredoc body piped to sh is judged" "$(decision claude $'cat <<\'EOF\' | sh\ngit clean -fd\nEOF')" "deny"
expect "sh -c runs its argument" "$(decision claude "sh -c 'git stash push'")" "deny"
expect "sh -c runs every command in its argument" "$(decision claude "sh -c 'git stash; git clean -fd'")" "deny"
expect "bash -c runs its argument" "$(decision claude 'bash -c "pnpm vitest run"')" "deny"
expect "env and bash -lc do not hide the argument" "$(decision claude "env FOO=1 bash -lc 'bundle exec rspec'")" "deny"
expect "xargs sh -c does not hide the argument" "$(decision claude "echo x | xargs sh -c 'git clean -fd'")" "deny"
expect "a bash -c newline separates commands" "$(decision claude $'bash -c \'echo hi\ngit stash push\'')" "deny"
expect "eval runs its argument" "$(decision claude 'eval "git reset --hard"')" "deny"
expect "bash -c of a harmless command stays allowed" "$(decision claude "bash -c 'git status; echo ok'")" "allow"
expect "a for loop over quoted suite strings is allowed" "$(decision claude "for c in 'bundle exec rspec' 'pnpm vitest run'; do echo \"\$c\"; done")" "allow"
expect "an unquoted ; still separates a suite run" "$(decision claude "echo hi; bundle exec rspec")" "deny"
expect "a multi-line commit message naming git clean is allowed" "$(decision claude $'git commit -m "Refuse stray cleans\n\nThe guard now judges ; git clean -fd only as a command."')" "allow"
expect "an apostrophe in a comment does not hide the next line" "$(decision claude $'# don\'t stash yet\ngit stash push')" "deny"
expect "a quote in a \$(cat <<EOF) body does not hide the command after it" "$(decision claude $'git commit -m "$(cat <<\'EOF\'\nsay "hi\nEOF\n)"; git stash push')" "deny"
expect "an arithmetic shift is not a heredoc" "$(decision claude $'echo $((1<<2))\ngit stash push')" "deny"
expect "an unterminated quote fails closed" "$(decision claude 'echo "unterminated; git stash push')" "deny"

# Command substitution is judged with the same quote and heredoc awareness as the top level.
expect "a \$(cat <<'EOF') commit message naming guarded commands is allowed" "$(decision claude $'git commit -m "$(cat <<\'EOF\'\nTighten the guard\n\ngit stash push\nbundle exec rspec\nEOF\n)"')" "allow"
expect "\$(git stash push) is denied" "$(decision claude "echo \"\$(git stash push)\"")" "deny"
expect "a backtick git clean is denied" "$(decision claude "echo \`git clean -fd\`")" "deny"
expect "a single-quoted \$(git stash) is literal and allowed" "$(decision claude "echo '\$(git stash)'")" "allow"
expect "\$( ) in an unquoted heredoc body is denied" "$(decision claude $'cat > notes.md <<EOF\n$(git stash push)\nEOF')" "deny"
expect "\$( ) in a quoted heredoc body is literal and allowed" "$(decision claude $'cat > notes.md <<\'EOF\'\n$(git stash push)\nEOF')" "allow"
# Wrappers in front of a command do not hide it.
expect "timeout 60 bash -c runs its argument" "$(decision claude "timeout 60 bash -c 'git stash push'")" "deny"
expect "sudo git clean is denied" "$(decision claude "sudo git clean -fd")" "deny"
expect "env X=1 git stash push is denied" "$(decision claude "env X=1 git stash push")" "deny"
expect "nice -n 5 bundle exec rspec is denied" "$(decision claude "nice -n 5 bundle exec rspec")" "deny"
expect "a whole suite inside a loop body is denied" "$(decision claude "for f in x; do bundle exec rspec; done")" "deny"
# A redirection is not a path.
expect "pnpm vitest run 2>&1 is denied" "$(decision claude "pnpm vitest run 2>&1")" "deny"
expect "bundle exec rspec > out.log is denied" "$(decision claude "bundle exec rspec > out.log")" "deny"
expect "a redirection with no target is not a path" "$(decision claude "bundle exec rspec >")" "deny"
expect "rspec on a spec with 2>&1 is allowed" "$(decision claude "bundle exec rspec spec/x_spec.rb 2>&1")" "allow"
# Text piped into a shell is run.
expect "echo text piped to bash is judged" "$(decision claude "echo \"git stash push\" | bash")" "deny"
expect "a 20 KB heredoc returns within 5 s" "$(fast $'python3 - <<\'PY\'\n'"$(printf 'print("step")  # bundle exec rspec, git stash push, x | y; z\n%.0s' $(seq 330))"$'\nPY')" "allow"

# Undoing your own files (THV-1361). Every edited file here is dirty, so only the edited list can
# allow it; clean.txt and lib/ are clean, other.txt is another session's dirty file.
RR="$TMP/thoven/shared"
g init -q -b main "$RR"
mkdir -p "$RR/db" "$RR/lib"
for f in tsconfig.json db/structure.sql a.txt b.txt clean.txt other.txt lib/x.txt; do echo x >"$RR/$f"; done
g -C "$RR" add . && g -C "$RR" commit -q -m files
for f in tsconfig.json db/structure.sql a.txt b.txt other.txt; do echo y >>"$RR/$f"; done
echo new >"$RR/untracked.txt"
printf "$RR/%s\n" tsconfig.json db/structure.sql a.txt b.txt >>"/tmp/claude-thoven/$SESSION/edited"
expect "restore <edited> 2>/dev/null is allowed" "$(decision claude "git restore tsconfig.json 2>/dev/null" "$RR")" "allow"
expect "restore <edited> > /dev/null 2>&1 is allowed" "$(decision claude "git restore a.txt b.txt > /dev/null 2>&1" "$RR")" "allow"
expect "restore <edited> 2>&1 | tail is allowed" "$(decision claude "git restore db/structure.sql 2>&1 | tail -2" "$RR")" "allow"
expect "restore ./<edited> is allowed" "$(decision claude "git restore ./tsconfig.json" "$RR")" "allow"
expect "checkout -- <edited> >/dev/null is allowed" "$(decision claude "git checkout -- a.txt >/dev/null" "$RR")" "allow"
expect "stash push -- <edited> 2> err.log is allowed" "$(decision claude "git stash push -- b.txt 2> err.log" "$RR")" "allow"
expect "restore <another session's file> 2>/dev/null is denied" "$(decision claude "git restore other.txt 2>/dev/null" "$RR")" "deny"
expect "sed -i then restore of a clean file is allowed" "$(decision claude "sed -i '' s/x/z/ clean.txt; git restore clean.txt" "$RR")" "allow"
expect "sed -i then restore of another session's dirty file is denied" "$(decision claude "sed -i '' s/x/z/ other.txt; git restore other.txt" "$RR")" "deny"
expect "stash push -u of an untracked file is denied" "$(decision claude "git stash push -u -- untracked.txt" "$RR")" "deny"
expect "restore of a clean directory is denied" "$(decision claude "git restore lib" "$RR")" "deny"
expect "restore \$f is denied" "$(decision claude 'for f in clean.txt; do git restore $f; done' "$RR")" "deny"
expect "pnpm vitest run 2>&1 | tail stays a whole suite" "$(decision claude "pnpm vitest run 2>&1 | tail")" "deny"

# branch -D of a branch this session created (THV-1361). Each starts at ahead, so it holds a commit
# that is not on origin and gh finds no merged PR: only the session's own record can allow it.
as_session() { run claude "$(jq -nc --arg c "$1" --arg d "$REPO" --arg s "$2" '{session_id:$s,cwd:$d,tool_input:{command:$c}}')" | sed 's/^rc=0 //' | jq -r '.hookSpecificOutput.permissionDecision // "allow"'; }
expect "a chain that creates then deletes a branch is allowed" "$(decision claude "git branch scratch/x ahead && git log -1 scratch/x && git branch -D scratch/x")" "allow"
g -C "$REPO" branch scratch/x ahead
expect "branch -D of a branch this session created is allowed" "$(decision claude "git branch -D scratch/x")" "allow"
decision claude "git branch unpushed-commit ahead" >/dev/null
expect "branch -D of a branch that existed before the session's git branch <name> is denied" "$(decision claude "git branch -D unpushed-commit")" "deny"
OTHER="$TMP/thoven/other"
g init -q -b main "$OTHER" && g -C "$OTHER" commit -q --allow-empty -m init
decision claude "git branch scratch/y" "$OTHER" >/dev/null
g -C "$OTHER" branch scratch/y && g -C "$REPO" branch scratch/y ahead
expect "branch -D of a name the session created in another repo is denied" "$(decision claude "git branch -D scratch/y")" "deny"
decision claude "git checkout -b scratch/co ahead" >/dev/null
g -C "$REPO" branch scratch/co ahead
expect "branch -D of a branch made by checkout -b is allowed" "$(decision claude "git branch -D scratch/co")" "allow"
decision claude "git switch -c scratch/sw ahead" >/dev/null
g -C "$REPO" branch scratch/sw ahead
expect "branch -D of a branch made by switch -c is allowed" "$(decision claude "git branch -D scratch/sw")" "allow"
decision claude "git worktree add ../wt-scratch -b scratch/wt ahead" "$TMP/thoven/wt-clean" >/dev/null
g -C "$TMP/thoven/wt-clean" worktree add -q ../wt-scratch -b scratch/wt ahead
expect "branch -D in the main checkout of a branch worktree add -b made from a linked tree is allowed" "$(decision claude "git branch -D scratch/wt")" "allow"
decision claude "git branch scratch/s ahead" >/dev/null
g -C "$REPO" branch scratch/s ahead
expect "branch -D of a branch another session created is denied" "$(as_session "git branch -D scratch/s" "$SESSION-other")" "deny"
as_session "git branch scratch/n ahead" "" >/dev/null
g -C "$REPO" branch scratch/n ahead
expect "a call with no session id records no branch" "$(as_session "git branch -D scratch/n" "")" "deny"

[ "$failed" -eq 0 ] || exit 1
echo "all passed"
