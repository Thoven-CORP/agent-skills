#!/usr/bin/env bash
# Makes Thoven worktrees: a ticket's at <repo>-thv-<n> on branch <area>/thv-<n>, a Project's at
# <repo>-<slug> on its integration branch, <slug>/integration by default. Claude's --worktree would
# otherwise create branch worktree-<name>, and git never carries .env files or installed
# dependencies into a new worktree, so a fresh one cannot boot without this.
set -euo pipefail

THOVEN_ROOT="${THOVEN_ROOT:-$HOME/thoven}"
DEFAULT_NPM_VERSION="10.9.9"
NAME_HINT="name the worktree <area>-thv-<n>, e.g. claude --worktree tooling-thv-969"

# kind -> "<repo dir> <env file>"
repo_table() {
  case "$1" in
    fe) echo "frontend .env.local" ;;
    be) echo "backend .env" ;;
    *) return 1 ;;
  esac
}

log() { printf 'thoven-worktree: %s\n' "$*" >&2; }
die() { local code="$1"; shift; log "$*"; exit "$code"; }

usage() {
  cat >&2 <<'EOF'
usage: thoven-worktree create <fe|be> <area> <n> [--project <name>] [--kind <kind>]
                              [--new "<reason>"] [--dry-run]
       thoven-worktree register-project <project> <fe|be> <branch>
       thoven-worktree where <project> <fe|be>
                                       (prints the Project's integration tree, validated)
       thoven-worktree bootstrap <path>
       thoven-worktree remove <path>   (archives its gitignored docs and untracked files to
                                       ~/thoven/archive first, and drops the worktree's own
                                       databases. Refuses tracked edits, a detached HEAD's own
                                       commits and a process working inside it)
       thoven-worktree orphan-dbs      (lists local databases no worktree uses; drops nothing)
       thoven-worktree hook            (Claude Code WorktreeCreate; JSON on stdin)
       thoven-worktree post-checkout <prev> <new> <flag>
                                       (git post-checkout; warns when a checkout lands behind origin/main)

create decides by the ticket's Linear Project and Kind. One tree serves a Project's integration branch.
  --kind meta|review|audit|research|verify   no tree: exit 3, with where to read
  --kind design|plan                    no tree: exit 3, write at the "Writes to:" path of the issue
  --kind build|fix (the default) with --project:
      the Project's tree exists       exit 4, its path is the last stdout line. Work there and end
                                      commits with the ticket id
      its branch, no tree             cut <repo>-<slug> on that branch
      no branch on origin             cut <slug>/integration from origin/main at <repo>-<slug>, push it
      its branch is local only        exit 1: push it if it is live work, delete it if it landed
  no --project                          its own tree <repo>-thv-<n> from origin/main (hotfix, scratch)
  --new "<reason>" cuts a fresh tree from origin/main for build or fix even when a tree exists.
                   It does not apply to review, audit, research, verify, design or plan.
  --dry-run        print the plan on stderr, change nothing

A Project's integration branch is its registry row's, else <slug>/integration: the name lowercased,
each run outside [a-z0-9] one '-', ends trimmed. A branch counts only when origin has it (git
ls-remote). The registry (enforcement/worktree-projects.tsv, or THOVEN_WORKTREE_REGISTRY) caches
Linear's Project to branch mapping, branch names only, and needs a row only when the confirmed name
differs from the slug. A branch gone from origin, or a tree gone from disk, is stale.

exit codes: 0 created, or the tree already exists   1 failure   2 usage error
            3 refused, read-only or docs-only kind  4 reuse an existing tree (path on stdout)
EOF
  exit 2
}

physical() { (cd "$1" 2>/dev/null && pwd -P); }

main_of() { git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1; }

# warn_behind <path> <behind> <reason> <remedy>: a one-line log scrolls past unread.
warn_behind() {
  local bangs='!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
  printf '%s\nWARNING: %s is %s commits behind origin/main\n%s\n%s\n%s\n' "$bangs" "$1" "$2" "$3" "$4" "$bangs" >&2
}

# Codex desktop cuts a detached worktree from the chosen branch's local HEAD, which can be days
# behind GitHub. A tree with no commits of its own, no edits and no branch on origin moves up to
# origin/main; any other tree is warned, because moving a shared branch rewrites what others pull.
freshen() {
  local path="$1" behind branch
  git -C "$path" fetch --quiet origin main || log "warning: git fetch origin main failed, using the last fetched origin/main"
  git -C "$path" rev-parse --verify --quiet origin/main >/dev/null || return 0
  behind="$(git -C "$path" rev-list --count HEAD..origin/main)"
  [ "$behind" -gt 0 ] || return 0
  if [ -n "$(git -C "$path" rev-list -n 1 HEAD --not origin/main)" ]; then
    warn_behind "$path" "$behind" "It has commits of its own, so it was left where it is." \
      "Rebase onto origin/main before you build on it."
  elif [ -n "$(git -C "$path" status --porcelain)" ]; then
    warn_behind "$path" "$behind" "It has uncommitted changes, so it was left where it is." \
      "Rebase onto origin/main before you build on it."
  elif branch="$(git -C "$path" symbolic-ref --quiet --short HEAD)" &&
    git -C "$path" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
    warn_behind "$path" "$behind" "Its branch $branch also exists on origin, so it was left where it is." \
      "Rebase onto origin/main before you build on it."
  elif git -C "$path" merge --ff-only --quiet origin/main >&2; then
    log "moved $behind commit(s) forward to origin/main"
  fi
}

# <area>_thv<n> on a ticket branch, else a hash of the path, so every worktree names its own.
# post_checkout <prev> <new> <flag>: runs inside the checked-out tree. A hook cannot block the
# checkout, and it must not fetch, so it only compares against the last fetched origin/main.
post_checkout() {
  local top behind
  [ "${3:-}" = 1 ] || return 0
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  git rev-parse --verify --quiet origin/main >/dev/null || return 0
  behind="$(git rev-list --count HEAD..origin/main 2>/dev/null)" || return 0
  [ "${behind:-0}" -gt 0 ] || return 0
  [ -z "$(git rev-list -n 1 HEAD --not origin/main 2>/dev/null)" ] || return 0
  warn_behind "$top" "$behind" "It has no commits of its own, so it can move up." "Run: git merge --ff-only origin/main"
}

db_suffix() {
  local path="$1" branch area
  branch="$(git -C "$path" branch --show-current)"
  if [[ "$branch" =~ ^([a-z0-9][a-z0-9-]*)/thv-([0-9]+)$ ]]; then
    area="${BASH_REMATCH[1]}"
    printf '%s_thv%s\n' "${area//-/_}" "${BASH_REMATCH[2]}"
  else
    printf 'wt_%s\n' "$(printf '%s' "$path" | shasum | cut -c1-8)"
  fi
}

# set_env <file> <key> <value>: replace the key's line, or append one. An empty value deletes it.
set_env() {
  local file="$1" tmp
  tmp="$(mktemp)"
  awk -v k="$2" -v v="$3" 'index($0, k "=") == 1 { if (!done && v != "") print k "=" v; done = 1; next }
    { print } END { if (!done && v != "") print k "=" v }' "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

# strip_prod_env <file>: drop every PROD_ key. Production credentials stay in the main checkout,
# so no agent in a worktree inherits a connection to production.
strip_prod_env() {
  local file="$1" tmp
  grep -qE '^(export )?PROD_' "$file" || return 0
  tmp="$(mktemp)"
  grep -vE '^(export )?PROD_' "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
  log "removed PROD_ keys from $file"
}

# env_db <file> <key>: the database name at the end of that key's URL.
env_db() {
  sed -n "s/^$2=//p" "$1" | tail -n 1 | sed -E 's#^.*/([^/?]*)(\?.*)?$#\1#'
}

local_dbs() { psql -d postgres -XtAc "select datname from pg_database"; }

# Every database a live worktree's .env names, the main checkout's shared ones included.
referenced_dbs() {
  local wt key
  git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r wt; do
    [ -f "$wt/.env" ] || continue
    for key in DATABASE_URL TEST_DATABASE_URL; do env_db "$wt/.env" "$key"; done
  done | sort -u
}

# branch_migrations <path>: db/migrate files the branch adds, counted as backend's
# lib/worktree_db_guard.rb counts them. A plain diff against origin/main also lists, as deletions,
# the migrations main gained since a stale branch was cut. --no-renames: a new migration similar to
# one main gained would read as a rename. Untracked ones count: `rails g migration` then migrate.
branch_migrations() {
  git -C "$1" diff --name-only --no-renames --diff-filter=A origin/main -- db/migrate 2>/dev/null
  git -C "$1" ls-files --others --exclude-standard -- db/migrate
}

# Two sessions running rspec on one shared neondb_test truncate each other's data.
isolate_db() {
  local path="$1" env="$1/.env" suffix dev_db current all
  [ -f "$env" ] || { log "no .env, so no database of its own"; return 0; }
  # set_env would write through the link into the checkout it points at.
  [ -L "$env" ] && { log "leaving it, .env is a symlink (shared)"; return 0; }
  suffix="$(db_suffix "$path")"
  set_env "$env" TEST_DATABASE_URL "postgresql://localhost/neondb_test_$suffix"
  log "TEST_DATABASE_URL points at neondb_test_$suffix"
  # Single-mode Puma: the dev default of 4 forked workers per pane swamps a 16 GB laptop.
  set_env "$env" WEB_CONCURRENCY 0
  # The dev database stays shared, but backend's THV-89 boot guard refuses a branch whose explicit
  # DATABASE_URL names thoven_development. database.yml's fallback reaches the same database and
  # the guard lets it boot.
  if [ "$(env_db "$env" DATABASE_URL)" = thoven_development ]; then
    set_env "$env" DATABASE_URL ""
    log "dropped DATABASE_URL, so the shared thoven_development is reached through database.yml's fallback"
  fi
  [ -n "$(branch_migrations "$path")" ] || return 0
  dev_db="thoven_dev_$suffix"
  current="$(env_db "$env" DATABASE_URL)"
  case "$current" in
    "" | thoven_development | "$dev_db") ;;
    *) log "the branch adds a migration, but DATABASE_URL names $current, leaving it"; return 0 ;;
  esac
  # Captured first: grep -q quits early, and under pipefail psql's SIGPIPE would fail the test.
  all="$(local_dbs 2>/dev/null)" || true
  if grep -qxF "$dev_db" <<<"$all" || createdb -T thoven_development "$dev_db" >&2; then
    set_env "$env" DATABASE_URL "postgresql://localhost/$dev_db"
    log "the branch adds a migration, so DATABASE_URL points at $dev_db, a copy of thoven_development"
  else
    log "warning: createdb -T thoven_development $dev_db failed; a live connection to thoven_development (a dev server) blocks the copy. DATABASE_URL still points at the shared database. Stop the server and rerun: thoven-worktree bootstrap $path"
  fi
}

bootstrap() {
  local path="$1"
  [ -d "$path" ] || die 1 "bootstrap: $path is not a directory"
  path="$(cd "$path" && pwd)"

  local main
  main="$(main_of "$path")"
  [ -n "$main" ] || die 1 "bootstrap: $path is not inside a git worktree"
  # A scratch worktree mirrors its parent session's HEAD and databases.
  local own=1
  { [ "${THOVEN_WORKTREE_SCRATCH:-}" = 1 ] || [ "$(physical "$path")" = "$(physical "$main")" ]; } && own=0
  [ "$own" = 1 ] && freshen "$path"

  # Gemfile wins because a Rails app can grow a package.json; a frontend never grows a Gemfile.
  local kind
  if [ -f "$path/Gemfile" ]; then
    kind=be
  elif [ -f "$path/package.json" ]; then
    kind=fe
  else
    die 1 "bootstrap: $path has neither package.json nor Gemfile"
  fi

  local env_file
  env_file="$(repo_table "$kind" | cut -d' ' -f2)"
  if [ -e "$path/$env_file" ]; then
    log "$env_file already present, leaving it"
  elif [ -f "$main/$env_file" ]; then
    cp "$main/$env_file" "$path/$env_file"
    log "copied $env_file from $main"
  else
    log "warning: $main has no $env_file to copy"
  fi
  # The main checkout keeps its PROD_ keys. A symlinked .env is main's own file, so it is left too.
  if [ "$kind" = be ] && [ "$(physical "$path")" != "$(physical "$main")" ] &&
    [ -f "$path/$env_file" ] && [ ! -L "$path/$env_file" ]; then
    strip_prod_env "$path/$env_file"
  fi

  if [ "$kind" = be ] && [ -d "$main/storage" ]; then
    mkdir -p "$path/storage"
    local entry name
    for entry in "$main"/storage/* "$main"/storage/.[!.]*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      name="$(basename "$entry")"
      [ "$name" = ".keep" ] && continue
      if [ -e "$path/storage/$name" ] || [ -L "$path/storage/$name" ]; then
        continue
      fi
      ln -s "$entry" "$path/storage/$name"
    done
    log "linked storage blobs from $main/storage"
  fi

  [ "$kind" = be ] && [ "$own" = 1 ] && isolate_db "$path"

  if [ "${THOVEN_WORKTREE_SKIP_INSTALL:-}" = 1 ]; then
    log "THOVEN_WORKTREE_SKIP_INSTALL=1, skipping dependency install and db:test:prepare"
    return 0
  fi
  install_deps "$path" "$kind"
  # A symlinked .env names the shared test database, and db:test:prepare purges it.
  if [ "$kind" = be ] && [ "$own" = 1 ] && [ -f "$path/.env" ] && [ ! -L "$path/.env" ]; then
    local test_url
    test_url="$(sed -n 's/^TEST_DATABASE_URL=//p' "$path/.env" | tail -n 1)"
    log "bin/rails db:test:prepare on $(env_db "$path/.env" TEST_DATABASE_URL)"
    (cd "$path" && TEST_DATABASE_URL="$test_url" bin/rails db:test:prepare) >&2 ||
      log "warning: db:test:prepare failed; rerun: cd $path && bin/rails db:test:prepare"
  fi
}

install_deps() {
  local path="$1" kind="$2"

  # A rerun must not reinstall: a worktree's node_modules can be a symlink into another live
  # tree, and npm ci and pnpm install both replace node_modules.
  if [ "$kind" = fe ] && { [ -e "$path/node_modules" ] || [ -L "$path/node_modules" ]; }; then
    log "node_modules already present, skipping install"
    return 0
  fi
  if [ "$kind" = be ] && (cd "$path" && bundle check >/dev/null 2>&1); then
    log "bundle check passes, skipping bundle install"
    return 0
  fi

  # The lockfile picks the installer, so a branch cut before THV-973 still installs with npm.
  if [ "$kind" = fe ] && [ -f "$path/pnpm-lock.yaml" ]; then
    log "pnpm install --frozen-lockfile in $path"
    (cd "$path" && pnpm install --frozen-lockfile) >&2 ||
      log "warning: pnpm install failed; the worktree exists, rerun: cd $path && pnpm install --frozen-lockfile"
  elif [ "$kind" = fe ]; then
    local version
    version="$(jq -r '.packageManager // empty' "$path/package.json" 2>/dev/null || true)"
    case "$version" in
      npm@*) version="${version#npm@}"; version="${version%%+*}" ;;
      *) version="" ;;
    esac
    version="${version:-$DEFAULT_NPM_VERSION}"
    log "npm@$version ci in $path"
    (cd "$path" && npx -y "npm@$version" ci) >&2 || log "warning: npm ci failed; the worktree exists, rerun: cd $path && npx -y npm@$version ci"
  else
    log "bundle install in $path"
    (cd "$path" && bundle install) >&2 || log "warning: bundle install failed; the worktree exists, rerun: cd $path && bundle install"
  fi
}

# The registry caches Linear's Project to integration-branch mapping: branch names, never paths.
registry_file() {
  local src="${BASH_SOURCE[0]}" d
  if [ -n "${THOVEN_WORKTREE_REGISTRY:-}" ]; then printf '%s\n' "$THOVEN_WORKTREE_REGISTRY"; return; fi
  while [ -L "$src" ]; do
    d="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" = /* ]] || src="$d/$src"
  done
  printf '%s/../worktree-projects.tsv\n' "$(cd "$(dirname "$src")" && pwd)"
}

# plain_arg <name> <value>: usage error on an empty value or one holding a tab or newline.
plain_arg() {
  [ -n "$2" ] || die 2 "$1 must not be empty"
  case "$2" in *$'\t'* | *$'\n'*) die 2 "$1 must not contain a tab or newline" ;; esac
}

register_project() {
  [ $# -eq 3 ] || usage
  local project="$1" repo="$2" branch="$3" file tmp
  plain_arg project "$project"
  plain_arg repo "$repo"
  plain_arg branch "$branch"
  repo_table "$repo" >/dev/null || die 2 "repo must be fe or be, got '$repo'"
  file="$(registry_file)"
  if [ ! -f "$file" ]; then
    printf '# project\trepo\tintegration_branch\t(a cache of Linear: branch names only, never paths)\n' > "$file" ||
      die 1 "cannot write $file"
  fi
  tmp="$(mktemp)"
  awk -F'\t' -v OFS='\t' -v p="$project" -v r="$repo" -v b="$branch" '
    /^#/ || NF < 3 { print; next }
    $1 == p && $2 == r { if (!done) print p, r, b; done = 1; next }
    { print }
    END { if (!done) print p, r, b }' "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
  log "registered $project ($repo) -> $branch in $file"
}

# project_slug <name>: lowercased, each run outside [a-z0-9] one '-', ends trimmed. Empty is a usage error.
project_slug() {
  local slug
  slug="$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  [ -n "$slug" ] || die 2 "project '$1' has no letter or digit to name a branch with"
  printf '%s\n' "$slug"
}

# on_origin <main> <branch>: whether origin has the branch, and ORIGIN_WHY when it does not. A
# local-only branch is stale: its PR merged and GitHub deleted it, or it was never pushed. Only when
# origin cannot be reached does the last fetched remote-tracking ref decide.
on_origin() {
  local rc=0
  ORIGIN_WHY=""
  [ -n "$2" ] || { ORIGIN_WHY="the branch name is empty"; return 1; }
  git -C "$1" ls-remote --exit-code --heads origin "refs/heads/$2" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    2) ORIGIN_WHY="git ls-remote origin has no refs/heads/$2"; return 1 ;;
  esac
  if git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$2"; then
    log "warning: git ls-remote origin failed (exit $rc), so the last fetched origin/$2 counts as live"
    return 0
  fi
  ORIGIN_WHY="git ls-remote origin failed (exit $rc) and there is no refs/remotes/origin/$2"
  return 1
}

# tree_for_branch <main> <branch>: the first worktree of that repo with the branch checked out.
tree_for_branch() {
  git -C "$1" worktree list --porcelain | awk -v B="refs/heads/$2" '
    /^worktree / { p = substr($0, 10) }
    $1 == "branch" && $2 == B { print p; exit }'
}

# lookup_tree <main> <project> <repo> <slug> sets TREE_STATE, TREE_BRANCH, TREE_PATH, TREE_WHY.
# ok: on origin with a tree. notree: on origin, no tree. stale: a row's or local branch that origin
# lacks, or a tree gone from disk. new: no branch yet, so the first Build ticket cuts it.
lookup_tree() {
  local main="$1" project="$2" repo="$3" file row="" label=stale
  TREE_STATE="" TREE_BRANCH="" TREE_PATH="" TREE_WHY=""
  file="$(registry_file)"
  if [ -f "$file" ]; then
    row="$(awk -F'\t' -v p="$project" -v r="$repo" '!/^#/ && $1 == p && $2 == r { b = $3 } END { print b }' "$file")"
  fi
  [ -z "$row" ] || label="stale row"
  TREE_BRANCH="${row:-$4/integration}"
  if ! on_origin "$main" "$TREE_BRANCH"; then
    if git -C "$main" show-ref --verify --quiet "refs/heads/$TREE_BRANCH"; then
      TREE_PATH="$(tree_for_branch "$main" "$TREE_BRANCH")"
      TREE_STATE=stale TREE_WHY="$label: branch $TREE_BRANCH exists locally but not on origin ($ORIGIN_WHY)${TREE_PATH:+, checked out at $TREE_PATH}. Push it if it is live work: git -C $main push -u origin $TREE_BRANCH. Remove its tree and delete it if it landed"
      TREE_PATH=""
    elif [ -n "$row" ]; then
      TREE_STATE=stale TREE_WHY="stale row: branch $TREE_BRANCH is not on origin ($ORIGIN_WHY)"
    else
      TREE_STATE=new TREE_WHY="$TREE_BRANCH is not on origin ($ORIGIN_WHY). The Project's first Build ticket cuts it"
    fi
    return 0
  fi
  TREE_PATH="$(tree_for_branch "$main" "$TREE_BRANCH")"
  if [ -z "$TREE_PATH" ]; then
    TREE_STATE=notree TREE_WHY="no worktree has $TREE_BRANCH checked out"
  elif [ ! -d "$TREE_PATH" ]; then
    TREE_STATE=stale TREE_WHY="stale: $TREE_PATH for $TREE_BRANCH is gone from disk (git worktree prune clears it)"
    TREE_PATH=""
  else
    TREE_STATE=ok
  fi
}

where_tree() {
  [ $# -eq 2 ] || usage
  local project="$1" repo="$2" row root main slug
  plain_arg project "$project"
  slug="$(project_slug "$project")" || exit 2
  row="$(repo_table "$repo")" || die 2 "repo must be fe or be, got '$repo'"
  root="$(cd "$THOVEN_ROOT" 2>/dev/null && pwd)" || die 1 "THOVEN_ROOT $THOVEN_ROOT does not exist"
  main="$root/${row%% *}"
  git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || die 1 "$main is not a git checkout"
  lookup_tree "$main" "$project" "$repo" "$slug"
  [ "$TREE_STATE" = ok ] || die 1 "$TREE_WHY"
  printf '%s\n' "$TREE_PATH"
}

# read_recipe <main> <project-tree-or-empty>: where to read code without a tree of one's own.
read_recipe() {
  if [ -n "$2" ]; then
    log "read it in the Project's integration tree: $2"
  else
    log "read it without a tree, from the latest origin/main:"
  fi
  log "  git -C $1 fetch origin main && git -C $1 show origin/main:<path>"
  log "  git -C $1 archive origin/main <dir> | tar -x -C \"\$(mktemp -d)\""
}

create() {
  local kind="" area="" n="" project="" slug="" tkind="" reason="" new=0 dry=0 pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) [ $# -ge 2 ] || die 2 "--project needs a name"; project="$2"; shift 2 ;;
      --kind) [ $# -ge 2 ] || die 2 "--kind needs a kind"; tkind="$2"; shift 2 ;;
      --new) [ $# -ge 2 ] || die 2 "--new needs a one-line reason"; reason="$2"; new=1; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --*) die 2 "unknown flag $1" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [ "${#pos[@]}" -eq 3 ] || usage
  kind="${pos[0]}" area="${pos[1]}" n="${pos[2]}"
  local row
  row="$(repo_table "$kind")" || die 2 "repo must be fe or be, got '$kind'"
  [[ "$area" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die 2 "area must match ^[a-z0-9][a-z0-9-]*\$, got '$area'"
  [[ "$n" =~ ^[0-9]+$ ]] || die 2 "n must be digits, got '$n'"
  if [ "$new" = 1 ]; then plain_arg "--new reason" "$reason"; fi
  if [ -n "${project:-}" ]; then
    plain_arg "--project" "$project"
    slug="$(project_slug "$project")" || exit 2
  fi
  tkind="$(printf '%s' "$tkind" | tr '[:upper:]' '[:lower:]')"
  case "$tkind" in
    "" | meta | build | fix | review | audit | research | verify | design | plan) ;;
    *) die 2 "kind must be meta, build, fix, review, audit, research, verify, design or plan, got '$tkind'" ;;
  esac

  local repo="${row%% *}"
  local root
  root="$(cd "$THOVEN_ROOT" 2>/dev/null && pwd)" || die 1 "THOVEN_ROOT $THOVEN_ROOT does not exist"
  local main="$root/$repo"
  local path="$root/$repo-thv-$n"
  local branch="$area/thv-$n"
  local have_git=1
  git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || have_git=0

  local known=0
  if [ -n "$project" ] && [ "$have_git" = 1 ]; then
    lookup_tree "$main" "$project" "$kind" "$slug"
    known=1
  fi

  # Rows 1 and 2: read-only and docs-only work gets no tree, and --new does not change that.
  case "$tkind" in
    meta | review | audit | research | verify)
      log "refused: a $tkind ticket needs no worktree of its own."
      [ "$new" = 1 ] && log "--new does not apply to a $tkind ticket"
      read_recipe "$main" "$([ "$known" = 1 ] && [ "$TREE_STATE" = ok ] && printf '%s' "$TREE_PATH")"
      exit 3 ;;
    design | plan)
      log "refused: a $tkind ticket needs no worktree. Write the document at the path in the issue's \"Writes to:\" line."
      [ "$new" = 1 ] && log "--new does not apply to a $tkind ticket"
      exit 3 ;;
  esac

  [ "$have_git" = 1 ] || die 1 "$main is not a git checkout"

  # Row 3: the Project's tree exists, so work there.
  if [ "$known" = 1 ]; then
    if [ "$TREE_STATE" = ok ] && [ "$new" = 1 ]; then
      log "--new: cutting a fresh tree from origin/main instead of reusing $TREE_PATH. Reason: $reason"
    elif [ "$new" = 1 ]; then
      log "--new: $reason"
    elif [ "$TREE_STATE" = ok ]; then
      log "reuse the tree for $project: $TREE_PATH on branch $TREE_BRANCH"
      log "work there, and end every commit with THV-$n. To use it: cd $TREE_PATH"
      local other
      other="$(git -C "$main" worktree list --porcelain | awk -v A="refs/heads/$area/" -v skip="$TREE_PATH" '
        /^worktree / { p = substr($0, 10) }
        $1 == "branch" && index($2, A) == 1 && p != skip { print "  " p " (" substr($2, 12) ")" }')"
      [ -z "$other" ] || { log "other open $area/ trees in $repo:"; printf '%s\n' "$other" >&2; }
      log "to cut a fresh tree anyway: thoven-worktree create $kind $area $n --project \"$project\" --new \"<reason>\""
      printf '%s\n' "$TREE_PATH"
      exit 4
    fi
  elif [ "$new" = 1 ]; then
    log "--new: $reason"
  fi

  # Row 4: the first Build ticket cuts the Project's canonical tree, and its remote branch if origin
  # has none. A local-only branch may be landed work or unpushed work, so it is never reused.
  local base="origin/main" existing=0 push=0
  if [ "$known" = 1 ] && [ "$new" = 0 ]; then
    branch="$TREE_BRANCH"
    path="$root/$repo-$slug"
    case "$TREE_STATE" in
      notree)
        existing=1
        log "first ticket for $project: cutting its tree on integration branch $branch" ;;
      new)
        push=1
        log "first ticket for $project: cutting integration branch $branch from $base and pushing it" ;;
      stale)
        git -C "$main" show-ref --verify --quiet "refs/heads/$branch" && die 1 "$TREE_WHY. Nothing was cut."
        push=1
        log "$TREE_WHY. Cutting it afresh from $base and pushing it" ;;
    esac
  fi

  if [ -e "$path" ]; then
    local top current common main_common
    top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
    current="$(git -C "$path" branch --show-current 2>/dev/null || true)"
    common="$(cd "$path" && physical "$(git rev-parse --git-common-dir 2>/dev/null || echo /nonexistent)" || true)"
    main_common="$(cd "$main" && physical "$(git rev-parse --git-common-dir)")"
    if [ "$top" = "$(physical "$path")" ] && [ "$current" = "$branch" ] && [ "$common" = "$main_common" ]; then
      log "$path already a $repo worktree on $branch, bootstrapping only"
      if [ "$dry" = 1 ]; then log "dry-run: would bootstrap $path"; printf '%s\n' "$path"; return 0; fi
    else
      die 1 "$path exists but is not a $repo worktree on $branch (branch: '${current:-none}')"
    fi
  elif [ "$dry" = 1 ]; then
    if [ "$existing" = 1 ]; then
      log "dry-run: would run: git -C $main worktree add $path $branch"
    else
      log "dry-run: would fetch origin main, then run: git -C $main worktree add --no-track -b $branch $path $base"
    fi
    [ "$push" = 0 ] || log "dry-run: would run: git -C $path push -u origin $branch"
    log "dry-run: would bootstrap $path"
    printf '%s\n' "$path"
    return 0
  elif [ "$existing" = 1 ]; then
    if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$main" worktree add "$path" "$branch" >&2
    else
      git -C "$main" fetch origin "refs/heads/$branch:refs/remotes/origin/$branch" >&2 ||
        log "warning: git fetch origin $branch failed, using the last fetched origin/$branch"
      git -C "$main" worktree add --track -b "$branch" "$path" "origin/$branch" >&2
    fi
  else
    log "fetching origin main in $main"
    git -C "$main" fetch origin main >&2
    git -C "$main" worktree add --no-track -b "$branch" "$path" "$base" >&2
    # -u, so a later deletion on GitHub shows as [gone].
    if [ "$push" = 1 ]; then
      git -C "$path" push -u origin "$branch" >&2 ||
        die 1 "git push -u origin $branch failed. $path is cut on a branch origin lacks; push it: git -C $path push -u origin $branch"
      log "pushed integration branch $branch to origin"
    fi
  fi

  bootstrap "$path"
  printf '%s\n' "$path"
}

# Gitignored notes (plans, specs, review reports) live only in their tree, and git worktree remove
# deletes them with it. Installed packages, build output and nested worktrees can be rebuilt, so
# they are never walked.
ARCHIVE_PRUNE=(.git node_modules .pnpm-store .next '.next-*' .turbo build dist out coverage tmp log storage vendor
  playwright-report test-results .worktrees graphify-out)
ARCHIVE_DOCS=(md mdx markdown txt html)

archive_dest() {
  local dest
  dest="$THOVEN_ROOT/archive/$(basename "$1")-$(date +%Y-%m-%d)"
  [ -e "$dest" ] && dest="$dest-$(date +%H%M%S)"
  printf '%s\n' "$dest"
}

# archive_docs <path> <dest>: copies <path>'s gitignored docs to <dest>, keeping their paths.
# Tracked files are never listed by check-ignore.
archive_docs() {
  local path="$1" dest="$2" name prune=() docs=() f n=0 found ignored rc
  for name in "${ARCHIVE_PRUNE[@]}"; do prune+=(-name "$name" -o); done
  for name in "${ARCHIVE_DOCS[@]}"; do docs+=(-name "*.$name" -o); done
  # Listed to files first: check-ignore exits 1 when nothing matches, and anything above 1 means the
  # list is incomplete, so the tree must not be removed on the strength of it.
  found="$(mktemp)" && ignored="$(mktemp)" || return 1
  (cd "$path" && find . \( "${prune[@]}" -path ./.claude/worktrees \) -prune -o \
    -type f \( "${docs[@]}" -false \) -print0) >"$found" || { rm -f "$found" "$ignored"; return 1; }
  (cd "$path" && git check-ignore -z --stdin) <"$found" >"$ignored"
  rc=$?
  rm -f "$found"
  [ "$rc" -le 1 ] || { rm -f "$ignored"; return 1; }
  rc=0
  while IFS= read -r -d '' f; do
    if ! { mkdir -p "$dest/$(dirname "$f")" && cp -p "$path/$f" "$dest/$f"; }; then rc=1; break; fi
    n=$((n + 1))
  done <"$ignored"
  rm -f "$ignored"
  [ "$rc" -eq 0 ] || return 1
  if [ "$n" -gt 0 ]; then
    log "archived $n gitignored doc(s) to $dest"
  else
    log "no gitignored docs to archive"
  fi
}

# in_pruned_dir <relative path>: whether a directory on the path is an ARCHIVE_PRUNE name.
in_pruned_dir() {
  local rest="${1%/*}" part name
  [ "$rest" != "$1" ] || return 1
  while [ -n "$rest" ]; do
    part="${rest%%/*}"
    if [ "$part" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
    for name in "${ARCHIVE_PRUNE[@]}"; do
      # shellcheck disable=SC2254
      case "$part" in $name) return 0 ;; esac
    done
  done
  return 1
}

# archive_untracked <path> <dest>: copies untracked, non-ignored files to <dest>, keeping their
# paths, because remove --force deletes them. A nested repository fails it: its own uncommitted work
# would go with it.
archive_untracked() {
  local path="$1" dest="$2" list f n=0 rc=0
  list="$(mktemp)" || return 1
  git -C "$path" ls-files -z --others --exclude-standard >"$list" || { rm -f "$list"; return 1; }
  while IFS= read -r -d '' f; do
    case "$f" in */) log "$path/$f is a nested repository; move it out first"; rc=1; break ;; esac
    in_pruned_dir "$f" && continue
    if ! { mkdir -p "$dest/$(dirname "$f")" && cp -pP "$path/$f" "$dest/$f"; }; then rc=1; break; fi
    n=$((n + 1))
  done <"$list"
  rm -f "$list"
  [ "$rc" -eq 0 ] || return 1
  [ "$n" -eq 0 ] || log "archived $n untracked file(s) to $dest"
}

# procs_inside <path>: "  pid <pid> (<command>)" for each process whose cwd is in <path>.
procs_inside() {
  command -v lsof >/dev/null || { log "lsof is not installed, so processes inside $1 cannot be checked"; return 1; }
  # lsof exits 1 when some processes are unreadable, and the readable ones are still listed.
  { lsof -d cwd -Fpcn 2>/dev/null || true; } | awk -v P="$1" '
    /^p/ { pid = substr($0, 2) } /^c/ { cmd = substr($0, 2) }
    /^n/ { n = substr($0, 2); if (n == P || index(n, P "/") == 1) print "  pid " pid " (" cmd ")" }'
}

# remove converges whenever nothing unrecoverable would be lost: tracked edits and a detached HEAD's
# own commits are refused, everything untracked is archived, then git removes the tree with --force.
remove() {
  local path main db key suffix dbs=() dirty ahead procs dest
  path="$(physical "$1")" || die 1 "remove: $1 is not a directory"
  [ "$(physical "$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)")" = "$path" ] ||
    die 1 "remove: $path is not the top of a git worktree"
  main="$(physical "$(main_of "$path")")"
  [ "$path" != "$main" ] || die 1 "remove: $path is the main checkout"
  # Neither this script nor lsof may count as a process inside the tree.
  cd /
  dirty="$(git -C "$path" status --porcelain --untracked-files=no)" || die 1 "remove: git status failed in $path"
  [ -z "$dirty" ] || die 1 "remove: $path has tracked changes, so nothing was removed. Commit and push them, or restore them:
$dirty"
  # The branch outlives its tree, so a commit on a branch is kept (a squash-merged ticket's are on
  # no origin branch). Only a detached HEAD can hold commits that removing the tree strands.
  ahead="$(git -C "$path" rev-list --count HEAD --not --branches --remotes=origin)" || die 1 "remove: git rev-list failed in $path"
  [ "$ahead" = 0 ] || die 1 "remove: $path has a detached HEAD with $ahead commit(s) no branch holds, so nothing was removed. Keep them on a branch: git -C $path switch -c <branch>"
  # A dev server writing during the delete left a partial delete with 176 MB behind.
  procs="$(procs_inside "$path")" || die 1 "remove: nothing was removed"
  [ -z "$procs" ] || die 1 "remove: these processes work inside $path, so nothing was removed. Stop them, or cd out, and rerun:
$procs"
  dest="$(archive_dest "$path")"
  archive_docs "$path" "$dest" || die 1 "remove: archiving $path's gitignored docs failed, so nothing was removed"
  archive_untracked "$path" "$dest" || die 1 "remove: archiving $path's untracked files failed, so nothing was removed"
  # Only the names bootstrap gives this tree: a .env copied from another tree names that tree's.
  suffix="$(db_suffix "$path")"
  if [ -f "$path/.env" ]; then
    for key in TEST_DATABASE_URL DATABASE_URL; do
      db="$(env_db "$path/.env" "$key")"
      { [ "$db" = "neondb_test_$suffix" ] || [ "$db" = "thoven_dev_$suffix" ]; } && dbs+=("$db")
    done
  fi
  git -C "$main" worktree remove --force "$path" >&2 || die 1 "git worktree remove --force $path failed, so no database was dropped"
  log "removed $path"
  # A database another live worktree still names is shared, not this one's to drop.
  local still
  still="$(referenced_dbs "$main")"
  for db in ${dbs[@]+"${dbs[@]}"}; do
    if grep -qxF "$db" <<<"$still"; then
      log "kept $db, another worktree uses it"
    elif dropdb --if-exists "$db" >&2; then
      log "dropped $db"
    else
      log "warning: dropdb $db failed"
    fi
  done
}

orphan_dbs() {
  local main="$THOVEN_ROOT/backend" all referenced
  git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || die 1 "$main is not a git checkout"
  all="$(local_dbs)" || die 1 "psql could not list the local databases"
  # Shared by design: worktrees reach them through database.yml's fallback, so no .env names them.
  referenced="$(referenced_dbs "$main"; printf '%s\n' thoven_development neondb_test)"
  grep -E '^(neondb|thoven)_' <<<"$all" | LC_ALL=C sort | grep -vxF -f <(printf '%s\n' "$referenced") || true
  log "these are not dropped. Drop by hand after checking: dropdb <name>"
}

# The hook also fires for subagent isolation worktrees, whose names are generated (bold-oak-a3f2).
# Those are not tickets: give them Claude's default layout so isolation keeps working.
scratch() {
  local cwd="$1" name="$2"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die 2 "$NAME_HINT"
  local top path
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || die 2 "$cwd is not inside a git repo"
  path="$top/.claude/worktrees/$name"
  log "'$name' is not <area>-thv-<n>, so this is a scratch worktree on worktree-$name. $NAME_HINT for a ticket"
  if [ ! -e "$path" ]; then
    git -C "$top" worktree add -b "worktree-$name" "$path" HEAD >&2
  fi
  THOVEN_WORKTREE_SKIP_INSTALL=1 THOVEN_WORKTREE_SCRATCH=1 bootstrap "$path"
  printf '%s\n' "$path"
}

hook() {
  local input name cwd
  input="$(cat)"
  name="$(jq -r '.name // empty' <<<"$input")"
  cwd="$(jq -r '.cwd // empty' <<<"$input")"

  [ -n "$cwd" ] && [ -d "$cwd" ] || die 2 "hook cwd '$cwd' is not a directory"

  local area n
  if [[ "$name" =~ ^([a-z0-9][a-z0-9-]*)[-/]thv-([0-9]+)$ ]]; then
    area="${BASH_REMATCH[1]}"
    n="${BASH_REMATCH[2]}"
  else
    scratch "$cwd" "$name"
    return
  fi
  local common owner
  common="$(cd "$cwd" && git rev-parse --git-common-dir 2>/dev/null)" || die 2 "$cwd is not inside a git repo"
  common="$(cd "$cwd" && physical "$common")"
  owner="$(dirname "$common")"

  local kind="" k
  for k in fe be; do
    if [ "$owner" = "$(physical "$THOVEN_ROOT/$(repo_table "$k" | cut -d' ' -f1)")" ]; then
      kind="$k"
    fi
  done
  [ -n "$kind" ] || die 2 "$cwd belongs to $owner, not $THOVEN_ROOT/frontend or $THOVEN_ROOT/backend"

  create "$kind" "$area" "$n"
}

case "${1:-}" in
  create) shift; create "$@" ;;
  register-project) shift; register_project "$@" ;;
  where) shift; where_tree "$@" ;;
  bootstrap) shift; [ $# -eq 1 ] || usage; bootstrap "$1" ;;
  remove) shift; [ $# -eq 1 ] || usage; remove "$1" ;;
  orphan-dbs) orphan_dbs ;;
  hook) hook ;;
  post-checkout) shift; post_checkout "$@" || true; exit 0 ;;
  *) usage ;;
esac
