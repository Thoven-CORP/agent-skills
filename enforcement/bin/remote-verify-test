#!/usr/bin/env bash
# Exercises remote-verify end to end with ssh stubbed: a bare origin, a "MacBook" clone and a
# "mini" clone, all under one mktemp directory. The stub ssh runs the remote command locally and
# keeps a copy of what was sent. bin/verify in the fixture is a stub that reports the tree it saw.
set -uo pipefail

TOOL="$(cd "$(dirname "$0")" && pwd)/remote-verify"
T=$(mktemp -d /tmp/remote-verify-test.XXXXXX) || exit 1
case "$T" in /tmp/remote-verify-test.*) ;; *) exit 1 ;; esac
trap 'rm -rf "$T"' EXIT

failures=0
pass() { printf 'PASS %s\n' "$1"; }
fail() { printf 'FAIL %s: %s\n' "$1" "$2"; failures=$((failures + 1)); }
expect_rc() { if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "exit $2, want $3"; fi; }
has() { if grep -qF -- "$3" "$2"; then pass "$1"; else fail "$1" "'$3' not in $(basename "$2")"; fi; }
lacks() { if grep -qF -- "$3" "$2"; then fail "$1" "'$3' found in $(basename "$2")"; else pass "$1"; fi; }

export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
export GIT_CONFIG_GLOBAL="$T/gitconfig" GIT_CONFIG_NOSYSTEM=1
git config --file "$T/gitconfig" init.defaultBranch main
g() { git -c advice.detachedHead=false "$@"; }

# Stub ssh: records argv, saves stdin, then runs the remote command here.
mkdir -p "$T/shim"
cat > "$T/shim/ssh" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$T/ssh.args"
cat > "$T/ssh.stdin"
for last; do :; done
bash -c "\$last" < "$T/ssh.stdin"
SH
chmod +x "$T/shim/ssh"
export PATH="$T/shim:$PATH"

# Stub gate: records its argv and runs what follows --.
cat > "$T/gate" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$T/gate.args"
while [ "\$1" != -- ]; do shift; done; shift
exec "\$@"
SH
chmod +x "$T/gate"
export THOVEN_LOAD_GATE="$T/gate"

g init -q --bare "$T/origin.git"
g clone -q "$T/origin.git" "$T/laptop" 2>/dev/null
L="$T/laptop"
mkdir -p "$L/bin" "$L/src"
cat > "$L/bin/verify" <<'SH'
#!/usr/bin/env bash
echo "stub verify running"
printf '%s\n' "$@" > "$REMOTE_VERIFY_TEST_DIR/verify.args"
pwd > "$REMOTE_VERIFY_TEST_DIR/verify.pwd"
files=$(find . -path ./.git -prune -o -type f -print | sed 's|^\./||' | sort | while read -r f; do printf '%s=%s ' "$f" "$(git hash-object "$f")"; done)
echo THOVEN_VERIFY_BEGIN
echo "{\"head\":\"$(git rev-parse HEAD)\",\"files\":\"$files\"}"
echo THOVEN_VERIFY_END
[ -f FAIL ] && exit 1
exit 0
SH
chmod +x "$L/bin/verify"
echo one > "$L/src/a.ts"
printf '\x00\x01\x02png' > "$L/src/logo.png"
echo 'EXAMPLE=1' > "$L/.env.example"
g -C "$L" add bin/verify src/a.ts src/logo.png .env.example
g -C "$L" commit -q -m init
g -C "$L" push -q origin main 2>/dev/null
g -C "$L" checkout -q -b feature
echo two >> "$L/src/a.ts"
g -C "$L" commit -q -am feature
g -C "$L" push -q -u origin feature 2>/dev/null

# The mini clone is made before the feature push lands there, so remote-verify must fetch.
mkdir -p "$T/mini"
g clone -q "$T/origin.git" "$T/mini/frontend" 2>/dev/null
g -C "$T/mini/frontend" reset -q --hard "$(g -C "$L" rev-parse main)"
g -C "$T/mini/frontend" update-ref -d refs/remotes/origin/feature

export TMPDIR="$T" REMOTE_VERIFY_ROOT="$T/mini" REMOTE_VERIFY_INSTALL=none REMOTE_VERIFY_TEST_DIR="$T"
NOPROFILE=(--profile "$T/no-such-profile.json")
run() { (cd "$L" && "$TOOL" "$@") > "$T/out" 2> "$T/err"; }
worktrees_clean() { # worktrees_clean <label>
  local n
  n=$(g -C "$T/mini/frontend" worktree list | wc -l | tr -d ' ')
  if [ "$n" = 1 ]; then pass "$1: mini worktree removed"; else fail "$1: mini worktree removed" "$n worktrees listed"; fi
  if ls -d "$T"/mini/runs/*/tree >/dev/null 2>&1; then fail "$1: tree dir removed" "$(ls -d "$T"/mini/runs/*/tree)"
  else pass "$1: tree dir removed"; fi
}

"$TOOL" --help >/dev/null 2>&1; expect_rc "a) --help exits 0" $? 0
(cd "$T" && "$TOOL") >/dev/null 2>&1; expect_rc "a) outside a checkout exits 2" $? 2

run "${NOPROFILE[@]}"; expect_rc "b) clean pushed tree passes" $? 0
has "b) ssh gets the default host" "$T/ssh.args" thoven-mini-ssh
has "b) ssh runs in batch mode" "$T/ssh.args" BatchMode=yes
has "b) block printed" "$T/out" THOVEN_VERIFY_BEGIN
has "b) block carries HEAD" "$T/out" "$(g -C "$L" rev-parse HEAD)"
if grep -Eqv '^(THOVEN_VERIFY_BEGIN|THOVEN_VERIFY_END|\{.*)$' "$T/out"; then fail "b) stdout is only the block" "$(cat "$T/out")"
else pass "b) stdout is only the block"; fi
has "b) verify progress goes to stderr" "$T/err" "stub verify running"
case "$(cat "$T/verify.pwd")" in "$T"/mini/runs/remote-verify-*/tree) pass "b) runs in a throwaway worktree under runs/" ;;
  *) fail "b) runs in a throwaway worktree under runs/" "$(cat "$T/verify.pwd")" ;; esac
worktrees_clean "b)"
if ls "$T"/mini/runs/remote-verify-*/verify.log >/dev/null 2>&1; then pass "b) log kept"; else fail "b) log kept" "no verify.log"; fi

# Dirty tree: modified text, modified binary, new binary, new test file, and secrets.
echo three >> "$L/src/a.ts"
printf '\x00\xff\xfe\x00changed' > "$L/src/logo.png"
printf '\x89PNG\x00\x00new' > "$L/src/new.png"
echo 'test("x", () => {})' > "$L/src/a.test.ts"
echo 'SECRET=do-not-send' > "$L/.env.local"
echo 'EXAMPLE=2' > "$L/.env.example"
mkdir -p "$L/config" "$L/node_modules/x"
echo 'deadbeef' > "$L/config/master.key"
echo 'PRIVATE' > "$L/id_ed25519"
echo 'cached' > "$L/node_modules/x/index.js"
run "${NOPROFILE[@]}"; expect_rc "c) dirty tree passes" $? 0
for f in src/a.ts src/logo.png src/new.png src/a.test.ts; do
  has "c) mini saw laptop's $f" "$T/out" "$f=$(g -C "$L" hash-object "$f")"
done
mkdir -p "$T/sent"; tar -xf "$T/ssh.stdin" -C "$T/sent"
if [ -f "$T/sent/untracked.tar" ]; then tar -tf "$T/sent/untracked.tar" > "$T/sent/untracked.list"; else : > "$T/sent/untracked.list"; fi
has "c) untracked test file sent" "$T/sent/untracked.list" src/a.test.ts
has "c) untracked binary sent" "$T/sent/untracked.list" src/new.png
has "c) patch is binary" "$T/sent/patch" "GIT binary patch"
for f in .env.local master.key id_ed25519 node_modules; do
  lacks "c) $f not in untracked tar" "$T/sent/untracked.list" "$f"
  lacks "c) $f not on the mini" "$T/out" "$f="
done
lacks "c) tracked .env.example change not in patch" "$T/sent/patch" ".env.example"
if grep -rqF do-not-send "$T/sent" "$T/mini"; then fail "c) secret value never transferred" "found under sent or mini"
else pass "c) secret value never transferred"; fi
has "c) skipped .env.local named" "$T/err" "skipped .env.local"
has "c) skipped tracked .env.example named" "$T/err" "skipped .env.example"
worktrees_clean "c)"

# Arguments: --base resolves to a SHA here, other args pass through, --host reaches ssh.
run "${NOPROFILE[@]}" --host other-host --base main --full; expect_rc "d) args run" $? 0
has "d) --base sent as a SHA" "$T/verify.args" "$(g -C "$L" rev-parse main)"
has "d) other args pass through" "$T/verify.args" --full
has "d) --host reaches ssh" "$T/ssh.args" other-host

# A profile on the mini and a verify that does not read it: the gate wraps bin/verify.
echo '{"slots":3}' > "$T/profile.json"
rm -f "$T/gate.args"
run --profile "$T/profile.json"; expect_rc "e) profile run passes" $? 0
has "e) gate gets the profile" "$T/gate.args" "$T/profile.json"
has "e) gate runs bin/verify" "$T/gate.args" bin/verify

# Failure inside verify and failure during setup both remove the worktree.
touch "$L/FAIL"
run "${NOPROFILE[@]}"; expect_rc "f) verify failure passes its exit code through" $? 1
has "f) block still printed" "$T/out" THOVEN_VERIFY_END
worktrees_clean "f) after verify failure"
rm -f "$L/FAIL"
REMOTE_VERIFY_INSTALL=false run "${NOPROFILE[@]}"; expect_rc "f) install failure exits 4" $? 4
worktrees_clean "f) after install failure"
ls -d "$T"/remote-verify.* >/dev/null 2>&1 && fail "f) bundle dir removed" "$(ls -d "$T"/remote-verify.*)" || pass "f) bundle dir removed"

# Unpushed HEAD is refused before anything is sent.
g -C "$L" stash -q -u
echo local >> "$L/src/a.ts"
g -C "$L" commit -q -am unpushed
rm -f "$T/ssh.args"
run "${NOPROFILE[@]}"; expect_rc "g) unpushed HEAD exits 3" $? 3
has "g) refusal names the branch" "$T/err" "branch 'feature' is not pushed"
if [ -e "$T/ssh.args" ]; then fail "g) nothing sent" "ssh was called"; else pass "g) nothing sent"; fi
g -C "$L" checkout -q --detach
run "${NOPROFILE[@]}"; expect_rc "g) unpushed detached HEAD exits 3" $? 3
has "g) detached refusal says so" "$T/err" "detached HEAD"

if [ "$failures" -eq 0 ]; then echo "all cases passed"; exit 0; fi
echo "$failures case(s) failed"; exit 1
