#!/usr/bin/env bash
# Stops local dev servers (Rails puma, next dev, next-server) older than --max-age, from any
# session, and renices the younger ones to 10. launchd runs it every 30 minutes
# (co.thoven.server-reaper). A session that needs a server longer runs
# `mkdir -p ~/.thoven/server-keep && touch ~/.thoven/server-keep/<pid>`, which keeps that pid
# for another --max-age from the touch. (Andres, 2026-10-29: a mock-run puma sat at 98% CPU
# for 14 hours.)
#
# Usage: thoven-server-reaper [--max-age SECONDS] [--dry-run]
# Test seams: THOVEN_REAPER_PS names a file of "pid etime command" lines read instead of ps;
# THOVEN_REAPER_KEEP_DIR moves the keep markers; THOVEN_REAPER_GRACE is the TERM-to-KILL wait.
set -uo pipefail

MAX_AGE=7200
DRY=0
while [ $# -gt 0 ]; do
	case "$1" in
		--max-age) MAX_AGE="${2:-}"; shift 2 ;;
		--dry-run) DRY=1; shift ;;
		*) echo "thoven-server-reaper: unknown argument $1" >&2; exit 2 ;;
	esac
done
case "$MAX_AGE" in '' | *[!0-9]*) echo "thoven-server-reaper: --max-age needs whole seconds" >&2; exit 2 ;; esac

KEEP_DIR="${THOVEN_REAPER_KEEP_DIR:-$HOME/.thoven/server-keep}"
GRACE="${THOVEN_REAPER_GRACE:-10}"
LOG="${THOVEN_REAPER_LOG:-$HOME/.thoven/server-reaper.log}"
mkdir -p "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" | tee -a "$LOG"; }

# etime is [[dd-]hh:]mm:ss
seconds() {
	local t="$1" d=0 h=0 m=0 s=0
	case "$t" in *-*) d="${t%%-*}"; t="${t#*-}" ;; esac
	IFS=: read -r a b c <<<"$t"
	if [ -n "${c:-}" ]; then h=$a; m=$b; s=$c; elif [ -n "${b:-}" ]; then m=$a; s=$b; else return 1; fi
	echo $((10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s))
}

is_server() {
	case "$1" in
		puma\ [0-9]*'(tcp://'*) return 0 ;;
		next-server*) return 0 ;;
		*/next\ dev* | *next/dist/bin/next\ dev*) return 0 ;;
	esac
	return 1
}

kept() {
	local marker="$KEEP_DIR/$1" now mtime
	[ -f "$marker" ] || return 1
	now=$(date +%s)
	mtime=$(stat -f %m "$marker" 2>/dev/null || stat -c %Y "$marker")
	[ $((now - mtime)) -lt "$MAX_AGE" ]
}

if [ -n "${THOVEN_REAPER_PS:-}" ]; then
	table=$(cat "$THOVEN_REAPER_PS" 2>/dev/null)
else
	table=$(ps -axo pid=,etime=,command=)
fi
# ps always lists at least this script, so an empty table means ps failed: stop nothing.
if [ -z "$(printf '%s' "$table" | tr -d '[:space:]')" ]; then
	echo "thoven-server-reaper: empty process table, refusing to act" >&2
	exit 2
fi

while read -r pid etime cmd; do
	[ -n "${pid:-}" ] || continue
	is_server "$cmd" || continue
	age=$(seconds "$etime") || { log "skip $pid: unreadable etime $etime"; continue; }
	if [ "$age" -lt "$MAX_AGE" ] || kept "$pid"; then
		[ "$DRY" = 1 ] || renice 10 -p "$pid" >/dev/null 2>&1 || true
		continue
	fi
	log "stop $pid (up ${etime}): ${cmd:0:120}"
	[ "$DRY" = 1 ] && continue
	kill -TERM "$pid" 2>/dev/null || continue
	for _ in $(seq 1 "$GRACE"); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
	if kill -0 "$pid" 2>/dev/null; then
		kill -KILL "$pid" 2>/dev/null && log "force-stopped $pid after ${GRACE}s"
	fi
done <<<"$table"

exit 0
