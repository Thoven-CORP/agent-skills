#!/usr/bin/env bash
# Pins the exit codes in the README table with cheap invocations. Every path it touches is under
# one mktemp directory: the gate gets a temp slot directory, thoven-worktree gets a temp
# THOVEN_ROOT and runs only refusals that end before any git, install or database step.
set -uo pipefail

BIN="$(cd "$(dirname "$0")" && pwd)"
T=$(mktemp -d /tmp/thoven-exit-codes-test.XXXXXX) || exit 1
case "$T" in /tmp/thoven-exit-codes-test.*) ;; *) exit 1 ;; esac
trap 'rm -rf "$T"' EXIT

export THOVEN_GATE_DIR="$T/slots"
export THOVEN_GATE_POLL=1
export THOVEN_ROOT="$T/root"
export THOVEN_WORKTREE_SKIP_INSTALL=1
export THOVEN_WORKTREE_REGISTRY="$T/projects.tsv"
mkdir -p "$THOVEN_ROOT"
unset THOVEN_GATE_DISABLE THOVEN_GATE_SLOTS THOVEN_GATE_MIN_FREE THOVEN_GATE_MAX_LOAD THOVEN_GATE_WAIT

failures=0
row() { # row <label> <want> <command...>
  local label="$1" want="$2" got
  shift 2
  "$@" >/dev/null 2>&1
  got=$?
  if [ "$got" = "$want" ]; then printf 'PASS %s: exit %s\n' "$label" "$got"
  else printf 'FAIL %s: exit %s, want %s\n' "$label" "$got" "$want"; failures=$((failures + 1)); fi
}

row "thoven-load-gate, no args" 2 "$BIN/thoven-load-gate"
row "thoven-load-gate --help" 0 "$BIN/thoven-load-gate" --help
row "thoven-load-gate, wait ran out" 75 "$BIN/thoven-load-gate" --min-free 101 --wait 2 -- true
row "thoven-worktree, no args" 2 "$BIN/thoven-worktree"
row "thoven-worktree create --kind review" 3 "$BIN/thoven-worktree" create fe x 1 --kind review --dry-run
row "thoven-evidence-dedupe, no args" 2 "$BIN/thoven-evidence-dedupe"
printf 'SKIP thoven-worktree exit 4 (reuse): needs a real git repo with a Project tree, covered by thoven-worktree-reuse-test\n'

if [ "$failures" -gt 0 ]; then printf '%s row(s) failed\n' "$failures"; exit 1; fi
printf 'all rows passed\n'
