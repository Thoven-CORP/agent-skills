#!/usr/bin/env bash
# Runs thoven-andres-mode against a throwaway HOME holding a fake andres-mode skill.
set -uo pipefail

HOOK="$(cd "$(dirname "$0")/.." && pwd)/hooks/thoven-andres-mode"
T=$(mktemp -d /tmp/thv1361.XXXXXX) || exit 1
case "$T" in /tmp/thv1361.*) ;; *) exit 1 ;; esac
trap 'rm -rf "$T"' EXIT
H="$(cd "$T" && pwd -P)/home"
mkdir -p "$H/.agents/skills/andres-mode" "$H/thoven/frontend" "$T/elsewhere"
SKILL="$H/.agents/skills/andres-mode/SKILL.md"
{
  printf -- '---\nname: andres-mode\ndescription: x\n---\n\n# Andres mode\n\nIntro.\n\n## Pitfalls\n\n- Pitfall one.\n- Pitfall two.\n\n## Steps\n\n'
  for _ in $(seq 400); do echo '- A long rule line that pads the skill well past any hook output limit.'; done
  echo '- Last rule.'
} > "$SKILL"

ok() { printf 'ok %s\n' "$1"; }
fail() { printf 'FAIL %s: got %s\n' "$1" "$2"; exit 1; }
expect() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "'$2' (want '$3')"; fi; }
run() { HOME="$H" "$HOOK" <<<"$1"; }
payload() { jq -nc --arg c "$1" '{session_id:"s",hook_event_name:"SessionStart",source:"startup",cwd:$c}'; }

out="$(run "$(payload "$H/thoven/frontend")")"; code=$?
expect "a Thoven session exits 0" "$code" 0
expect "the first line tells the agent to read the skill file" \
  "$(head -n 1 <<<"$out" | grep -c "Read $SKILL in full")" 1
expect "the Pitfalls section is inline" "$(grep -c '^- Pitfall two\.$' <<<"$out")" 1
expect "the output ends with the last pitfall" "$(tail -n 1 <<<"$out")" "- Pitfall two."
expect "the rest of the skill stays in the file" "$(grep -c -e '^## Steps' -e 'Last rule' -e '^name:' <<<"$out")" 0
expect "the output stays under 4 KB, so no CLI cuts it" "$(( $(wc -c <<<"$out") < 4096 ))" 1
expect "a session in HOME gets it too" "$(run "$(payload "$H")" | grep -c '^- Pitfall one\.$')" 1
expect "a session elsewhere gets nothing" "$(run "$(payload "$T/elsewhere")")" ""
expect "a sibling of thoven gets nothing" "$(run "$(payload "$H/thoven-notes")")" ""
out="$(cd "$T/elsewhere" && run "")"; code=$?
expect "empty input outside Thoven exits 0" "$code" 0
expect "empty input outside Thoven prints nothing" "$out" ""
expect "empty input falls back to the working directory" \
  "$(cd "$H/thoven/frontend" && run "" | grep -c '^- Pitfall one\.$')" 1
rm "$SKILL"
out="$(run "$(payload "$H/thoven/frontend")")"; code=$?
expect "a missing skill exits 0" "$code" 0
expect "a missing skill prints nothing" "$out" ""

echo "all passed"
