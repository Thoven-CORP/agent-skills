#!/usr/bin/env bash
set -euo pipefail

source_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/thoven-stale-refs"
source_helper="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/thoven-stale-ref-calls.py"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
workspace="$tmp/workspace"
mkdir -p "$workspace"/{frontend,backend,.workspace,agent-skills/enforcement/bin,agent-skills/skills}
cp "$source_script" "$workspace/agent-skills/enforcement/bin/thoven-stale-refs"
cp "$source_helper" "$workspace/agent-skills/enforcement/bin/thoven-stale-ref-calls.py"
chmod +x "$workspace/agent-skills/enforcement/bin/thoven-stale-ref-calls.py"
touch "$workspace/.workspace/CLAUDE-root.md" "$workspace/.workspace/AGENTS-root.md" \
  "$workspace/.workspace/CONTEXT-MAP.md" "$workspace/CI_CD.md"
scanner="$workspace/agent-skills/enforcement/bin/thoven-stale-refs"

expect_status() {
  local wanted="$1"; shift
  local output="$tmp/output" error="$tmp/error" actual=0
  "$@" >"$output" 2>"$error" || actual=$?
  if [ "$actual" -ne "$wanted" ]; then
    cat "$output" "$error" >&2
    printf 'expected exit %s, got %s\n' "$wanted" "$actual" >&2
    exit 1
  fi
}

# The relocated default scans its own checkout and sibling roots, then succeeds clean.
expect_status 0 "$scanner" --count

# A stale live instruction under the default checkout turns the default red.
printf 'old: %s\n' "$(printf 'thoven%s' '2.0')" > "$workspace/agent-skills/skills/live.md"
expect_status 1 "$scanner" --count
rm "$workspace/agent-skills/skills/live.md"

# Explicit roots cannot silently disappear from the scan.
expect_status 2 "$scanner" --count "$tmp/missing"
expect_status 2 "$scanner" --count ''

# A removed export with one live import is found against the base, then clears when repaired.
repo="$workspace/agent-skills"
git -C "$repo" init -b main >/dev/null
git -C "$repo" config user.email verify@example.test
git -C "$repo" config user.name 'Verify Test'
mkdir -p "$repo/lib" "$repo/src"
printf 'export const oldName = 1\n' > "$repo/lib/module.ts"
printf "import { oldName } from '../lib/module'\nvoid oldName\n" > "$repo/src/caller.ts"
git -C "$repo" add lib/module.ts src/caller.ts
git -C "$repo" commit -m base >/dev/null
git -C "$repo" update-ref refs/remotes/origin/main HEAD
printf 'export const newName = 1\n' > "$repo/lib/module.ts"
expect_status 1 "$scanner" --count --base origin/main -- "$repo"
printf "import { newName } from '../lib/module'\nvoid newName\n" > "$repo/src/caller.ts"
expect_status 0 "$scanner" --count --base origin/main -- "$repo"

# A same-named declaration elsewhere cannot hide a removed export import.
printf 'export const oldName = 9\n' > "$repo/lib/unrelated.ts"
printf "import { oldName } from '../lib/module'\nvoid oldName\n" > "$repo/src/caller.ts"
printf 'export const newName = 1\n' > "$repo/lib/module.ts"
expect_status 1 "$scanner" --count --base origin/main -- "$repo"
rm "$repo/lib/unrelated.ts"
printf "import { newName } from '../lib/module'\nvoid newName\n" > "$repo/src/caller.ts"
expect_status 0 "$scanner" --count --base origin/main -- "$repo"

# An untracked live file is scanned correctly even when invoked from another cwd.
printf 'live route thoven2.0\n' > "$repo/live.md"
actual=0
(cd "$tmp" && "$scanner" --count -- "$repo") >"$tmp/output" 2>"$tmp/error" || actual=$?
if [ "$actual" -ne 1 ]; then
  cat "$tmp/output" "$tmp/error" >&2
  printf 'external-cwd canary expected exit 1, got %s\n' "$actual" >&2
  exit 1
fi
rm "$repo/live.md"

# A deleted/renamed path with a caller is red until its import points at the new path.
git -C "$repo" mv lib/module.ts lib/renamed.ts
expect_status 1 "$scanner" --count --base origin/main -- "$repo"
printf "import { newName } from '../lib/renamed'\nvoid newName\n" > "$repo/src/caller.ts"
expect_status 0 "$scanner" --count --base origin/main -- "$repo"

# Deleted Python and Ruby declarations are checked against callers in their modules.
language_repo="$workspace/language-fixtures"
git -C "$workspace" init -b main language-fixtures >/dev/null
git -C "$language_repo" config user.email verify@example.test
git -C "$language_repo" config user.name 'Verify Test'
mkdir -p "$language_repo/lib" "$language_repo/src"
printf 'def old_name():\n    return 1\n' > "$language_repo/lib/python_module.py"
printf 'from lib.python_module import old_name\nold_name()\n' > "$language_repo/src/python_caller.py"
printf 'def old_name\n  1\nend\n' > "$language_repo/lib/ruby_module.rb"
printf "require_relative '../lib/ruby_module'\nold_name\n" > "$language_repo/src/ruby_caller.rb"
git -C "$language_repo" add .
git -C "$language_repo" commit -m base >/dev/null
git -C "$language_repo" update-ref refs/remotes/origin/main HEAD
printf 'def new_name():\n    return 1\n' > "$language_repo/lib/python_module.py"
printf 'def new_name\n  1\nend\n' > "$language_repo/lib/ruby_module.rb"
expect_status 1 "$scanner" --count --base origin/main -- "$language_repo"
printf 'from lib.python_module import new_name\nnew_name()\n' > "$language_repo/src/python_caller.py"
printf "require_relative '../lib/ruby_module'\nnew_name\n" > "$language_repo/src/ruby_caller.rb"
expect_status 0 "$scanner" --count --base origin/main -- "$language_repo"

# A default export reshaped inside its module (a Suspense wrapper re-adds it lower down) is
# still exported at HEAD, so its importers are live. Removing it for real is still red.
default_repo="$workspace/default-fixture"
git -C "$workspace" init -b main default-fixture >/dev/null
git -C "$default_repo" config user.email verify@example.test
git -C "$default_repo" config user.name 'Verify Test'
mkdir -p "$default_repo/app/book"
printf 'export default function Page() {\n  return 1\n}\n' > "$default_repo/app/book/page.tsx"
printf "import Page from './page'\nvoid Page\n" > "$default_repo/app/book/page.test.tsx"
git -C "$default_repo" add .
git -C "$default_repo" commit -m base >/dev/null
git -C "$default_repo" update-ref refs/remotes/origin/main HEAD
printf 'function Content() {\n  return 1\n}\n\nexport default function Page() {\n  return Content()\n}\n' > "$default_repo/app/book/page.tsx"
expect_status 0 "$scanner" --count --base origin/main -- "$default_repo"
printf 'export function Page() {\n  return 1\n}\n' > "$default_repo/app/book/page.tsx"
expect_status 1 "$scanner" --count --base origin/main -- "$default_repo"

# A frontend snapshot under another name (bin/verify's thoven-verify-fe-*) keeps its history
# exemption, for text hits and for deleted-path callers; the same lines in a live file stay red.
snapshot="$workspace/thoven-verify-fe-snapshot"
git -C "$workspace" init -b main thoven-verify-fe-snapshot >/dev/null
git -C "$snapshot" config user.email verify@example.test
git -C "$snapshot" config user.name 'Verify Test'
mkdir -p "$snapshot/lib" "$snapshot/docs/superpowers/qa"
touch "$snapshot/next.config.mjs"
printf 'export const Gone = 1\n' > "$snapshot/lib/gone.ts"
git -C "$snapshot" add .
git -C "$snapshot" commit -m base >/dev/null
git -C "$snapshot" update-ref refs/remotes/origin/main HEAD
git -C "$snapshot" rm -q lib/gone.ts
printf "old: thoven2.0\nimport { Gone } from '@/lib/gone'\n" > "$snapshot/docs/superpowers/qa/record.md"
expect_status 0 "$scanner" --count --base origin/main -- "$snapshot"
cp "$snapshot/docs/superpowers/qa/record.md" "$snapshot/docs/live.md"
expect_status 1 "$scanner" --count -- "$snapshot"
expect_status 1 "$scanner" --count --base origin/main -- "$snapshot"
rm "$snapshot/docs/live.md"
printf "import { Gone } from '@/lib/gone'\n" > "$snapshot/docs/live.md"
expect_status 1 "$scanner" --count --base origin/main -- "$snapshot"

# An empty base is refused, never read as "no base" and a skipped caller check.
expect_status 2 "$scanner" --count --base '' -- "$default_repo"
expect_status 2 "$source_helper" '' "$default_repo"
expect_status 2 "$source_helper"

printf 'thoven-stale-refs default-root checks passed\n'
