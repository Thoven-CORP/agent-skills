#!/usr/bin/env bash
# Blocks vitest --exclude, git clean/reset --hard, stash/checkout/restore that could discard other sessions' work,
# and a forced worktree remove or branch -D of work that is not on origin.
# One guard for every harness. Claude and Codex send tool_input.command and read the default
# output. Cursor's beforeShellExecution sends a top-level command and reads {"permission":"deny"}.
# Devin sends no cwd (it sets DEVIN_PROJECT_DIR and runs the hook in the project) and blocks only
# on exit 2. Cursor's allow is an explicit {"permission":"allow"}, as in its sample hooks.
#   thoven-guard-bash [--dialect claude|cursor|devin]
set -o pipefail

dialect=claude
[ "${1:-}" = "--dialect" ] && dialect="${2:-claude}"

payload="$(cat)"
cwd="$(jq -r '.cwd // empty' <<<"$payload")"
[ -n "$cwd" ] || cwd="${DEVIN_PROJECT_DIR:-$PWD}"

allow() {
  [ "$dialect" = cursor ] && printf '{"permission":"allow"}\n'
  exit 0
}
session_id="$(jq -r '.session_id // .conversation_id // empty' <<<"$payload")"
# The id names a directory under /tmp/claude-thoven; one that could climb out of it keeps no state.
case "$session_id" in */*|.*) session_id="" ;; esac

case "$cwd" in
  "$HOME"/thoven|"$HOME"/thoven/*|"$HOME"/.herdr/worktrees/*) ;;
  *) allow ;;
esac

state="/tmp/claude-thoven/${session_id:-unknown}"
mkdir -p "$state"
[ -f "$state/started" ] || touch "$state/started"
edited_file="$state/edited"

command="$(jq -r '.tool_input.command // .command // empty' <<<"$payload")"
[ -n "$command" ] || allow

deny() {
  local reason="$1"
  case "$dialect" in
    cursor)
      jq -n --arg reason "$reason" '{permission:"deny",user_message:$reason,agent_message:$reason}'
      ;;
    devin)
      printf '%s\n' "$reason" >&2
      exit 2
      ;;
    *)
      jq -n --arg reason "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}'
      ;;
  esac
  exit 0
}

# Split a command into its subcommands, one line each: S, the VAR=val words in front of the command,
# \037, then the command from its head word on, past VAR=val, wrappers (env, timeout, sudo, nice,
# nohup, time, command, xargs) and do/then/else/elif. Only an unquoted ; & | or newline separates,
# so `pgrep -f "vitest|rspec"` is one command. Code a shell runs comes back as Q with its newlines
# as \036, to be judged like a top-level command: a $( ) or backtick body outside single quotes,
# bash -c, eval, a here-string, a heredoc fed to a shell, and echo or printf text piped to one. A
# heredoc body is otherwise data; an unquoted one comes back as H, to be scanned for $( ) and
# backticks only (mode H). A parse that ends inside a quote, a $( , a backtick or an unterminated
# heredoc has lost track of bash, so the old split on every separator is added and the guard fails
# closed. awk, because a bash char loop is O(n^2).
split_subcommands() {
  printf '%s' "$1" | LC_ALL=C awk -v mode="${2:-C}" '
    function flush_to(j) { if (j > seg) buf = buf substr(s, seg, j - seg); seg = j }
    function word_end(j) { if (inword) { wn++; ws[wn] = wstart; we[wn] = j - 1; wb[wn] = wbuf; inword = 0 } }
    function word(k) { return substr(s, ws[k], we[k] - ws[k] + 1) }
    function bare(w) { gsub(/["\047\\]/, "", w); return w }
    function unq(w,   f) {
      if (w !~ /^["\047]/) return w
      f = substr(w, 1, 1)
      if (substr(w, length(w), 1) != f) sub(/\)+$/, "", w)
      if (length(w) >= 2 && substr(w, length(w), 1) == f) return substr(w, 2, length(w) - 2)
      return w
    }
    function requeue(t) { gsub(/\n/, "\036", t); if (t ~ /[^ \t\036]/) print "Q" t }
    function trim(t) { gsub(/\n/, " ", t); sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t); return t }
    # the command word after VAR=val prefixes, wrappers and their options, as an index into the words
    function head(   k, w, a, pos) {
      k = 1
      while (k <= wn) {
        w = bare(word(k)); sub(/^\(+/, "", w)
        if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { k++; continue }
        sub(/.*\//, "", w)
        if (w ~ /^(do|then|else|elif)$/) { k++; continue }
        if (w ~ /^(env|timeout|nohup|time|command|sudo|nice|xargs)$/) {
          k++; pos = (w == "timeout")
          while (k <= wn) {
            a = bare(word(k))
            if (a == "--") { k++; break }
            if (a ~ /^-/) {
              k++
              if (a ~ /=/) continue
              if ((w == "env" && a ~ /^-[uCPS]$/) || (w == "timeout" && a ~ /^-[sk]$/) || (w == "nice" && a == "-n") ||
                  (w == "sudo" && a ~ /^-[ugpCDrtTU]$/) || (w == "xargs" && a ~ /^-[IdEnLPsaJRS]$/)) k++
              continue
            }
            if (pos) { pos = 0; k++; continue }
            break
          }
          continue
        }
        return k
      }
      return 0
    }
    function emit(k,   a, m, w) {
      if (trim(buf) == "") return
      a = ""
      for (m = 1; m < k || (!k && m <= wn); m++) {
        w = bare(word(m)); sub(/^\(+/, "", w)
        if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/) a = a " " w
      }
      print "S" trim(a) "\037" (k ? trim(substr(buf, wb[k])) : "")
    }
    # the fallback: one piece of the separator split, its words cut on blanks
    function emit_plain(t,   save, L, j, k0) {
      save = s; s = t; buf = t; wn = 0; L = length(t); j = 1
      while (j <= L) {
        while (j <= L && substr(t, j, 1) ~ /[ \t\n]/) j++
        if (j > L) break
        k0 = j; while (j <= L && substr(t, j, 1) !~ /[ \t\n]/) j++
        wn++; ws[wn] = k0; we[wn] = j - 1; wb[wn] = k0
      }
      emit(head()); s = save; wn = 0
    }
    function end_sub(j,   k, hw, m, w, code, found, text) {
      word_end(j); flush_to(j)
      if (trim(buf) == "") { buf = ""; wn = 0; return }
      k = head(); emit(k); buf = ""
      text = ""
      if (k) {
        hw = bare(word(k)); sub(/^\(+/, "", hw); sub(/.*\//, "", hw)
        if (hw ~ /^(bash|sh|zsh|dash|ksh)$/) {
          line_shell = 1; found = 0
          for (m = k + 1; m <= wn; m++) {
            w = word(m)
            if ((w ~ /^-[A-Za-z]*c[A-Za-z]*$/ || w == "<<<") && m < wn) { requeue(unq(word(m + 1))); found = 1; break }
            if (w ~ /^<<</) { requeue(unq(substr(w, 4))); found = 1; break }
          }
          if (!found && piped != "") requeue(piped)
        } else if (hw == "eval") {
          line_shell = 1
          code = ""
          for (m = k + 1; m <= wn; m++) code = code " " unq(word(m))
          requeue(code)
        } else if (hw ~ /^(echo|printf)$/ && ch[j] == "|" && ch[j + 1] != "|" && ch[j - 1] != "|") {
          for (m = k + 1; m <= wn; m++) {
            w = unq(word(m))
            if (hw == "echo" && text == "" && w ~ /^-[neE]+$/) continue
            text = text " " w
          }
          gsub(/\\n/, "\n", text)
        }
      }
      piped = text
      wn = 0
    }
    function push(t) { d++; sq[d] = q; sp[d] = pd; st[d] = t; q = ""; pd = 0 }
    function pop() { q = sq[d]; pd = sp[d]; d-- }
    function open_sub() { push(ch[i + 2] == "(" ? "a" : "c"); i += (st[d] == "a" ? 3 : 2); sb[d] = i; if (st[d] == "c") nc++ }
    # a $( ) closing at j; the outermost one is requeued, and its re-split reaches the ones inside
    function close_sub(j) { if (st[d] == "c" && --nc == 0) requeue(substr(s, sb[d], j - sb[d])); pop() }
    # a backtick at i: requeue its body with \$ \` \\ unescaped, as bash does, and step past it
    function tick(   j, b, o, k, c2) {
      j = i + 1
      while (j <= n && ch[j] != "`") j += (ch[j] == "\\" ? 2 : 1)
      if (j > n) broken = 1
      b = substr(s, i + 1, j - i - 1); o = ""
      for (k = 1; k <= length(b); k++) {
        c2 = substr(b, k, 1)
        if (c2 == "\\" && substr(b, k + 1, 1) ~ /[$`\\]/) c2 = substr(b, ++k, 1)
        o = o c2
      }
      if (!nc) requeue(o)
      i = j + 1
    }
    # read the bodies of the pending heredocs from the line after position j; returns where they end
    function bodies(j,   k, e, line, cmp, body) {
      for (k = 1; k <= hn; k++) {
        body = ""
        while (1) {
          if (j > n) { broken = 1; break }
          e = j; while (e <= n && ch[e] != "\n") e++
          line = substr(s, j, e - j); cmp = line
          if (hx[k]) sub(/^\t+/, "", cmp)
          j = e + 1
          if (cmp == hd[k]) break
          body = body line "\n"
        }
        if (!hnest[k]) {
          if (line_shell) requeue(body)
          else if (!hlit[k] && body ~ /[$`]/) { gsub(/\n/, "\036", body); print "H" body }
        }
      }
      hn = 0
      return j
    }
    { s = (NR == 1 ? $0 : s "\n" $0) }
    END {
      gsub(/\036/, "\n", s)
      n = split(s, ch, "")
      q = (mode == "H" ? "h" : ""); d = 0; pd = 0; st[0] = ""; nc = 0; seg = 1; buf = ""; wn = 0; inword = 0
      hn = 0; broken = 0; line_shell = 0; piped = ""
      i = 1
      while (i <= n) {
        c = ch[i]
        if (q == "\047") { if (c == "\047") q = ""; i++; continue }
        if (q == "$\047") { if (c == "\\") i++; else if (c == "\047") q = ""; i++; continue }
        # inside double quotes, or anywhere in an unquoted heredoc body (q h)
        if (q == "\"" || q == "h") {
          if (c == "\\") i++
          else if (c == "\"" && q == "\"") q = ""
          else if (c == "$" && ch[i + 1] == "(") { open_sub(); continue }
          else if (c == "`") { tick(); continue }
          i++; continue
        }
        sep = (c == ";" || c == "|" || (c == "&" && ch[i - 1] != ">" && ch[i - 1] != "<" && ch[i + 1] != ">"))
        if (d == 0) {
          if (c == " " || c == "\t" || c == "\n" || sep) word_end(i)
          else if (!inword) { inword = 1; wstart = i; wbuf = length(buf) + i - seg + 1 }
        }
        if (c == "\\") {
          if (ch[i + 1] == "\n") { flush_to(i); i += 2; seg = i; continue }
          i += 2; continue
        }
        if (c == "\047") { q = "\047"; i++; continue }
        if (c == "\"") { q = "\""; i++; continue }
        if (c == "$" && ch[i + 1] == "\047") { q = "$\047"; i += 2; continue }
        if (c == "$" && ch[i + 1] == "(") { open_sub(); continue }
        if (c == "`") { tick(); continue }
        if (st[d] == "a") {
          if (c == "(") pd++
          else if (c == ")") { if (pd > 0) pd--; else if (ch[i + 1] == ")") { close_sub(i); i += 2; continue } }
          i++; continue
        }
        if (d > 0 && c == "(") { pd++; i++; continue }
        if (d > 0 && c == ")") { if (pd > 0) pd--; else close_sub(i); i++; continue }
        if (c == "#" && (i == 1 || ch[i - 1] ~ /[ \t\n;&|()]/)) {
          flush_to(i); while (i <= n && ch[i] != "\n") i++; seg = i; continue
        }
        if (c == "<" && ch[i + 1] == "<") {
          if (ch[i + 2] == "<") { i += 3; continue }
          j = i + 2; dash = 0; delim = ""; lit = 0
          if (ch[j] == "-") { dash = 1; j++ }
          while (ch[j] == " " || ch[j] == "\t") j++
          while (j <= n && ch[j] !~ /[ \t\n;&|<>()]/) {
            if (ch[j] == "\047") { lit = 1; j++; while (j <= n && ch[j] != "\047") delim = delim ch[j++]; j++ }
            else if (ch[j] == "\"") { lit = 1; j++; while (j <= n && ch[j] != "\"") { if (ch[j] == "\\") j++; delim = delim ch[j++] } j++ }
            else if (ch[j] == "\\") { lit = 1; j++; delim = delim ch[j++] }
            else delim = delim ch[j++]
          }
          if (delim != "") { hn++; hd[hn] = delim; hx[hn] = dash; hlit[hn] = lit; hnest[hn] = (d > 0); i = j; continue }
          i += 2; continue
        }
        if (c == "\n") {
          if (d == 0) end_sub(i)
          else flush_to(i + 1)
          if (hn > 0) { i = bodies(i + 1); seg = i } else { i++; if (d == 0) seg = i }
          if (d == 0) line_shell = 0
          continue
        }
        if (d == 0 && sep) { end_sub(i); i++; seg = i; continue }
        i++
      }
      if (mode != "H") end_sub(n + 1)
      for (k = 1; k <= d; k++) if (st[k] == "c") { requeue(substr(s, sb[k])); break }
      if ((q != "" && q != "h") || d > 0 || broken) {
        t = s; gsub(/&&|\|\||;|\|/, "\n", t); m = split(t, parts, "\n")
        for (k = 1; k <= m; k++) emit_plain(parts[k])
      }
    }'
}

paths_all_edited() {
  local paths=("$@")
  [ "${#paths[@]}" -gt 0 ] || return 1
  [ -f "$edited_file" ] || return 1
  local p abs
  for p in "${paths[@]}"; do
    abs="$(resolve_in "$git_dir" "$p")"
    grep -qxF "$abs" "$edited_file" || return 1
  done
  return 0
}

# resolve a path against a directory, expanding a leading ~ or $HOME and dropping quotes
resolve_in() {
  local dir="$1" p="${2//[\"\']/}"
  case "$p" in
    "~"|'$HOME'|'${HOME}') p="$HOME" ;;
    "~/"*) p="$HOME/${p#"~/"}" ;;
    '$HOME/'*) p="$HOME/${p#'$HOME/'}" ;;
    '${HOME}/'*) p="$HOME/${p#'${HOME}/'}" ;;
  esac
  case "$p" in
    /*) printf '%s\n' "$p" ;;
    *) printf '%s\n' "$dir/$p" ;;
  esac
}

# commits reachable from a ref in a repo that no origin ref contains
unpushed_count() {
  git -C "$1" rev-list --count "$2" --not --remotes=origin 2>/dev/null || echo 0
}

# merged_at_tip <repo> <branch>: true when GitHub has a merged PR from <branch> whose head is the
# branch's local tip. A squash merge leaves the branch's commits off origin and --delete-branch
# drops the remote, so this is what proves them safe to delete (THV-1067). gh missing, offline,
# slow (10s) or finding nothing is false: the guard fails closed.
merged_at_tip() {
  local tip
  tip="$(git -C "$1" rev-parse -q --verify "refs/heads/$2")" || return 1
  (cd "$1" && GH_PROMPT_DISABLED=1 perl -e 'alarm 10; exec @ARGV' \
    gh pr list --head "$2" --state merged --json headRefOid -q '.[].headRefOid' 2>/dev/null) |
    grep -Fxq "$tip"
}

# git's own arguments after its global options, with the repo dir -C points at
parse_git() {
  local dir="$1"; shift
  git_args=()
  git_dir="$dir"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C)
        [ "$#" -ge 2 ] || break
        git_dir="$(resolve_in "$git_dir" "$2")"; shift 2 ;;
      -c)
        [ "$#" -ge 2 ] || break
        shift 2 ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  git_args=("$@")
}

# work_cwd follows `cd <dir>` across the chain, so `cd repo && git branch -D x` is judged in repo
work_cwd="$cwd"

# gather every subcommand, expanding $( ... ) and the code a shell re-enters recursively. A queue
# entry is its split mode (C a command, H an unquoted heredoc body) followed by its text. The text
# keeps its newlines as \036 for awk to decode: bash 3.2's ${x//a/b} takes 10 s on 20 KB.
declare -a queue=("C$command")
declare -a subcommands=()
while [ "${#queue[@]}" -gt 0 ]; do
  cur="${queue[0]}"
  queue=("${queue[@]:1}")
  while IFS= read -r sub; do
    case "$sub" in
      S*) subcommands+=("${sub:1}") ;;
      Q*) queue+=("C${sub:1}") ;;
      H*) queue+=("H${sub:1}") ;;
    esac
  done < <(split_subcommands "${cur:1}" "${cur:0:1}")
done

for entry in "${subcommands[@]}"; do
  assigns="${entry%%$'\037'*}"
  sub="${entry#*$'\037'}"
  # Matched at command position, so prose naming the flag stays allowed. The
  # substring version denied this repo's own README on 2026-09-18, and denied
  # the edit that fixed it, which is how it got found.
  read -r -a vwords <<<"$sub"
  vrunner=""
  for vw in "${vwords[@]}"; do
    case "$vw" in
      vitest|*/vitest) vrunner="$vw"; break ;;
      npx|pnpm|yarn|bun|npm|run|exec|dlx) continue ;;
      -*) continue ;;
      *) break ;;
    esac
  done
  if [ -n "$vrunner" ] && [[ " ${vwords[*]} " == *" --exclude "* ]]; then
    deny "That flag replaces the config's exclude array and reports failures that do not exist. Run the failing files by path instead."
  fi

  # A whole suite pins the machine every pane shares (retro 2026-10-03, THV-1047). Judged at command
  # position: vitest run, the package test:run / test:coverage scripts, and rspec, each with no path.
  # THOVEN_FULL_SUITE=1, as a prefix or in the environment, is the sanctioned full run.
  fwords=("${vwords[@]}")
  full_ok="${THOVEN_FULL_SUITE:-}"
  [[ " $assigns " == *" THOVEN_FULL_SUITE=1 "* ]] && full_ok=1
  suite=""
  rest=()
  case "${fwords[0]:-}" in
    npx|pnpm|yarn|bun|npm)
      i=1
      while [ "$i" -lt "${#fwords[@]}" ]; do
        case "${fwords[$i]}" in run|exec|dlx|-*) i=$((i + 1)) ;; *) break ;; esac
      done
      case "${fwords[$i]:-}" in
        vitest|*/vitest) suite="vitest"; rest=("${fwords[@]:$((i + 1))}") ;;
        test:run|test:coverage) suite="${fwords[$i]}"; rest=("${fwords[@]:$((i + 1))}") ;;
      esac
      ;;
    vitest|*/vitest) suite="vitest"; rest=("${fwords[@]:1}") ;;
    bundle)
      [ "${fwords[1]:-}" = "exec" ] && case "${fwords[2]:-}" in rspec|bin/rspec) suite="rspec"; rest=("${fwords[@]:3}") ;; esac
      ;;
    rspec|bin/rspec|*/bin/rspec) suite="rspec"; rest=("${fwords[@]:1}") ;;
  esac
  if [ -n "$suite" ] && [ "$full_ok" != 1 ]; then
    # A redirection (2>&1, > out.log, <in) and its target are not a path.
    has_path=""
    target_next=""
    for fw in "${rest[@]}"; do
      [ -n "$target_next" ] && { target_next=""; continue; }
      rt="${fw#"${fw%%[!0-9]*}"}"
      case "$rt" in
        '<'*|'>'*|'&>'*)
          rt="${rt#"${rt%%[!<>&|]*}"}"
          [ -n "$rt" ] || target_next=1
          continue ;;
      esac
      case "$fw" in run|watch|--|-*) ;; *) has_path=1; break ;; esac
    done
    if [ -z "$has_path" ]; then
      deny "That runs the whole $suite suite, which pins the machine every pane shares. Run the spec or test files you changed by path. Main or the integration session can run the full suite with THOVEN_FULL_SUITE=1 in front of the command."
    fi
  fi

  read -r -a words <<<"$sub"
  w0="${words[0]:-}"
  w1="${words[1]:-}"

  # A leading ( opens a subshell: `(cd repo && git branch -D x)`.
  if [ "${w0#(}" = "cd" ] && [ -n "$w1" ]; then
    work_cwd="$(resolve_in "$work_cwd" "$w1")"
  fi

  # Matched at command position, so a doc or script that merely names these stays allowed.
  # Read past git's global options, so `git -C <tree> reset --hard` is judged like `git reset --hard`.
  [ "${w0#(}" = "git" ] || continue
  parse_git "$work_cwd" "${words[@]:1}"
  g1="${git_args[0]:-}"
  g2="${git_args[1]:-}"

  if [ "$g1" = "clean" ] || { [ "$g1" = "reset" ] && [[ " ${git_args[*]} " == *" --hard "* ]]; }; then
    deny "This tree is shared with other sessions. That command discards work you did not write. Undo your own files by path instead."
  fi

  if [ "$g1" = "stash" ]; then
    case "$g2" in
      list|pop|apply|show|drop|clear|branch) : ;;
      *)
        rest=("${git_args[@]:1}")
        [ "$g2" = "push" ] || [ "$g2" = "save" ] && rest=("${git_args[@]:2}")
        paths=()
        seen_dashdash=0
        for a in "${rest[@]}"; do
          if [ "$seen_dashdash" -eq 1 ]; then
            paths+=("$a")
          elif [ "$a" = "--" ]; then
            seen_dashdash=1
          fi
        done
        if [ "$seen_dashdash" -eq 0 ]; then
          for a in "${rest[@]}"; do
            [[ "$a" == -* ]] || paths+=("$a")
          done
        fi
        if ! paths_all_edited "${paths[@]}"; then
          deny "git stash with no paths, or with a path you did not edit this session, takes other sessions' work with it. Stash only your files: git stash push -- <paths you edited>."
        fi
        ;;
    esac
  fi

  if [ "$g1" = "checkout" ]; then
    if [[ " ${git_args[*]} " == *" -- "* ]]; then
      paths=()
      seen_dashdash=0
      for a in "${git_args[@]:1}"; do
        if [ "$seen_dashdash" -eq 1 ]; then
          paths+=("$a")
        elif [ "$a" = "--" ]; then
          seen_dashdash=1
        fi
      done
      if ! paths_all_edited "${paths[@]}"; then
        deny "git checkout -- with no paths, or with a path you did not edit this session, takes other sessions' work with it. Undo only your files: git checkout -- <paths you edited>."
      fi
    fi
  fi

  if [ "$g1" = "restore" ]; then
    if [[ "$sub" != *"--staged"* ]]; then
      paths=()
      seen_dashdash=0
      for a in "${git_args[@]:1}"; do
        if [ "$seen_dashdash" -eq 1 ]; then
          paths+=("$a")
        elif [ "$a" = "--" ]; then
          seen_dashdash=1
        elif [[ "$a" != -* ]]; then
          paths+=("$a")
        fi
      done
      if ! paths_all_edited "${paths[@]}"; then
        deny "git restore with no paths, or with a path you did not edit this session, takes other sessions' work with it. Undo only your files: git restore <paths you edited>."
      fi
    fi
  fi
  if [ "$g1" = "worktree" ] && [ "$g2" = "remove" ]; then
    force=0
    target=""
    for a in "${git_args[@]:2}"; do
      case "$a" in
        --force|--forc|--for|--fo) force=1 ;;
        --*) ;;
        -*f*) force=1 ;;
        -*) ;;
        *) target="${a%)}" ;;
      esac
    done
    tree="$(resolve_in "$git_dir" "$target")"
    if [ "$force" -eq 1 ] && [ -n "$target" ] && git -C "$tree" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      dirty="$(git -C "$tree" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d '[:space:]')"
      ahead="$(unpushed_count "$tree" HEAD)"
      if [ "${dirty:-0}" -gt 0 ] || [ "${ahead:-0}" -gt 0 ]; then
        deny "$target holds work that is not on origin (uncommitted or untracked files: $dirty, unpushed commits: $ahead), which a forced remove destroys; commit and push it, then run git worktree remove $target."
      fi
    fi
  fi

  if [ "$g1" = "branch" ]; then
    delete=0
    force=0
    remote=0
    branches=()
    for a in "${git_args[@]:1}"; do
      a="${a//[\"\']/}"
      a="${a%)}"
      # git accepts any unambiguous prefix of a long option
      case "$a" in
        --delete|--delet|--dele|--del|--de) delete=1 ;;
        --force|--forc|--for|--fo) force=1 ;;
        --remotes|--remote|--remot|--remo|--rem) remote=1 ;;
        --*) ;;
        -*)
          [[ "$a" == *D* ]] && { delete=1; force=1; }
          [[ "$a" == *d* ]] && delete=1
          [[ "$a" == *f* ]] && force=1
          [[ "$a" == *r* ]] && remote=1
          ;;
        *) branches+=("$a") ;;
      esac
    done
    if [ "$delete" -eq 1 ] && [ "$force" -eq 1 ] && [ "$remote" -eq 0 ]; then
      for b in "${branches[@]}"; do
        case "$b" in
          *'$'*|*'`'*) deny "Branch $b is a variable the guard cannot resolve, and git branch -D destroys commits that are not on origin; name the branch, or use git branch -d." ;;
        esac
        git -C "$git_dir" rev-parse --verify -q "refs/heads/$b" >/dev/null || continue
        ahead="$(unpushed_count "$git_dir" "refs/heads/$b")"
        if [ "${ahead:-0}" -gt 0 ] && ! merged_at_tip "$git_dir" "$b"; then
          deny "Branch $b holds work that is not on origin (unpushed commits: $ahead), which git branch -D destroys, and gh shows no merged PR whose head is its tip; push it with git push origin $b first, or use git branch -d if it is merged."
        fi
      done
    fi
  fi
done

allow
