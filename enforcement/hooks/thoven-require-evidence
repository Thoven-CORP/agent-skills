#!/usr/bin/env bash
# Admit a done claim only when each edited code checkout has a fresh local bin/verify receipt.
set -o pipefail

payload="$(cat)"
cwd="$(jq -r '.cwd // empty' <<<"$payload")"
session_id="$(jq -r '.session_id // empty' <<<"$payload")"
last_msg="$(jq -r '.last_assistant_message // empty' <<<"$payload")"

case "$cwd" in
  "$HOME"/thoven|"$HOME"/thoven/*|"$HOME"/.herdr/worktrees/*) ;;
  *) exit 0 ;;
esac

state="/tmp/claude-thoven/${session_id:-unknown}"
[ -d "$state" ] || exit 0
edited_file="$state/edited"
[ -f "$edited_file" ] || exit 0

pattern='\b(done|built|shipped|complete|completed|finished|fixed|implemented|ready to (review|merge|ship))\b'
found_claim=0
while IFS=: read -r off _rest; do
  [ -n "$off" ] || continue
  start=$(( off > 12 ? off - 12 : 0 ))
  pre="${last_msg:$start:$(( off - start ))}"
  prelow="$(printf '%s' "$pre" | tr '[:upper:]' '[:lower:]')"
  if [[ "$prelow" != *"not "* && "$prelow" != *"n't "* ]]; then
    found_claim=1
    break
  fi
done < <(grep -oiEb "$pattern" <<<"$last_msg" 2>/dev/null)
[ "$found_claim" -eq 1 ] || exit 0

python3 - "$payload" "$edited_file" <<'PY'
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(2)


try:
    payload = json.loads(sys.argv[1])
    message = payload.get("last_assistant_message") or ""
    working_cwd = Path(payload.get("cwd") or os.getcwd()).resolve()
    paths = Path(sys.argv[2]).read_text().splitlines()
except (json.JSONDecodeError, OSError):
    fail("Thoven verification gate could not read this session's edited paths.")

def is_code(path):
    location = Path(path)
    if not location.is_absolute():
        location = working_cwd / location
    archive = Path.home() / "thoven" / "archive"
    # Workspace verification receipts are documents, not application JSON.
    # Both checks keep symlinks and nested repository archives from escaping
    # the exact workspace document boundary.
    if (location.suffix == ".json" and location.is_relative_to(archive)
            and location.resolve().is_relative_to(archive.resolve())):
        return False
    if path.endswith((".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".rb", ".erb", ".css", ".scss", ".py", ".sh", ".yml", ".yaml", ".json", ".toml", ".ini", ".cfg", ".xml")) or Path(path).name in {"Dockerfile", "Makefile", "Gemfile", "Rakefile"}:
        return True
    return re.search(r"/(?:bin|hooks)/[^/]+$", path) is not None


roots = set()
for edited in paths:
    if not is_code(edited):
        continue
    location = Path(edited)
    if not location.is_absolute():
        location = working_cwd / location
    if location.is_file() or not location.exists():
        location = location.parent
    while not location.exists() and location != location.parent:
        location = location.parent
    result = subprocess.run(["git", "-C", str(location), "rev-parse", "--show-toplevel"],
                            text=True, capture_output=True, timeout=10)
    if result.returncode:
        fail(f"Thoven verification gate cannot find the edited repo for {edited}.")
    roots.add(str(Path(result.stdout.strip()).resolve()))

if not roots:
    raise SystemExit(0)

begins = list(re.finditer(r"(?m)^THOVEN_VERIFY_BEGIN\n", message))
ends = list(re.finditer(r"(?m)^THOVEN_VERIFY_END\s*$", message))
blocks = []
cursor = 0
for begin in begins:
    end = next((candidate for candidate in ends if candidate.start() > begin.end()), None)
    if end is None or begin.start() < cursor:
        fail("Thoven verification gate needs one complete THOVEN_VERIFY block per edited repo.")
    raw = message[begin.end():end.start()].strip()
    if "\n" in raw:
        fail("Thoven verification gate requires single-line JSON between the THOVEN_VERIFY markers.")
    try:
        block = json.loads(raw)
    except json.JSONDecodeError:
        fail("Thoven verification gate found a malformed THOVEN_VERIFY block.")
    if not isinstance(block, dict):
        fail("Thoven verification gate found a malformed THOVEN_VERIFY block.")
    blocks.append(block)
    cursor = end.end()
if len(begins) != len(ends) or len(blocks) != len(roots):
    fail("Thoven verification gate needs one complete THOVEN_VERIFY block per edited repo.")

by_root = {}
for block in blocks:
    repo = block.get("repo")
    if not isinstance(repo, str) or repo in by_root:
        fail("Thoven verification gate found duplicate or missing repo evidence.")
    by_root[repo] = block
if set(by_root) != roots:
    fail("Thoven verification gate evidence does not cover exactly the edited repos.")

for root in sorted(roots):
    block = by_root[root]
    rows = block.get("rows")
    if block.get("version") != 1 or block.get("status") != "PASS" or not isinstance(rows, list) or not rows:
        fail(f"Thoven verification gate needs a nonempty PASS receipt for {root}.")
    verifier = Path(root) / "bin" / "verify"
    if not verifier.is_file() or not os.access(verifier, os.X_OK):
        fail(f"Thoven verification gate cannot find executable {verifier}.")
    try:
        result = subprocess.run([str(verifier), "--check-evidence"], cwd=root,
                                input=json.dumps(block), text=True, capture_output=True, timeout=10)
    except subprocess.TimeoutExpired:
        fail(f"Thoven verification gate timed out checking evidence for {root}.")
    if result.returncode:
        fail(f"Thoven verification gate rejected stale or invalid evidence for {root}.")
PY
rc=$?
if [ "$rc" -ne 0 ]; then
  if [ ! -f "$state/nudged" ]; then
    touch "$state/nudged"
    printf '%s\n' 'Done claims after code edits need a fresh PASS block from bin/verify in every edited repo. Run bin/verify, paste each complete THOVEN_VERIFY block, then finish.' >&2
  fi
  exit 2
fi

touch "$state/nudged"
exit 0
