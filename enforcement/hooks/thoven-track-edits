#!/usr/bin/env bash
# Records edited files (Edit|Write file_path, or Bash's git-dirty paths since session start) and nudges the UI rule once.
# Each dialect's payload is read into one shape: session_id, cwd, and an Edit (file_path) or a Bash (command).
#   claude, codex  PostToolUse; tool_name Edit|Write|Bash, cwd in the payload
#   cursor         afterFileEdit (file_path) and afterShellExecution (command); keyed on conversation_id,
#                  no cwd, so the first workspace root (cursor.com/docs/hooks)
#   devin          PostToolUse; tool_name edit|write|notebook_edit carry tool_input.file_path, exec and
#                  apply_patch are scanned; no cwd, so DEVIN_PROJECT_DIR (docs.devin.ai/cli/extensibility/hooks)
#   OpenCode's plugin sends the claude shape (opencode/thoven-uncommitted.js).
#   thoven-track-edits [--dialect claude|cursor|devin] [--pre]
#
# --pre runs before a shell call and only stamps $state/cmd-started. The Bash scan then attributes
# the files newer than that stamp, i.e. the ones this command changed, so a read-only command that
# names a checkout another agent is editing is not charged with that agent's files. Without a stamp
# the boundary is the session start. The stamp is spent by the post call that reads it.
#   claude, codex  PreToolUse, matcher Bash
#   cursor         beforeShellExecution, with --dialect cursor
#   devin          PreToolUse, matcher ^exec$, with --dialect devin
#   OpenCode       has no pre event wired to this script, so it keeps the session-start boundary.
set -o pipefail
# Read-only git: status never takes index.lock to refresh, so it cannot block another session's commit.
export GIT_OPTIONAL_LOCKS=0

dialect=claude
pre=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dialect) dialect="${2:-claude}"; shift ;;
    --pre) pre=1 ;;
  esac
  shift
done

# Path of $2 relative to directory $1, both absolute (os.path.relpath without a subprocess).
relpath_from() {
  local from="${1%/}" to="${2%/}" up=""
  while [ -n "$from" ] && [[ "$to/" != "$from/"* ]]; do
    from="${from%/*}"
    up="../$up"
  done
  local rest="${to#"$from"}"
  rest="${rest#/}"
  local out="$up$rest"
  out="${out%/}"
  printf '%s\n' "${out:-.}"
}

# True when $1 names the checkout $3 through the spelling $2 (absolute, workspace-relative or
# cwd-relative) as a whole path. Two near misses no longer count (2026-11-08):
#   a prefix: ~/thoven/frontend inside ~/thoven/frontend-<tree>, which scanned the main checkout's
#     14,770 untracked scratch files after every command in a worktree;
#   a parent: ~/thoven inside ~/thoven/<checkout>/..., which scanned the workspace root's 32,781
#     untracked files after every command that named any checkout. That path belongs to the
#     nested checkout ($checkouts lists them), not to the root.
names_path() {
  local command="$1" path="$2" repo="$3" rest before after child
  [ -n "$path" ] && [ "$path" != . ] || return 1
  rest="$command"
  while [[ "$rest" == *"$path"* ]]; do
    before="${rest%%"$path"*}"
    after="${rest#*"$path"}"
    rest="$after"
    [[ "${before: -1}" == [[:alnum:]_.-] || "${after:0:1}" == [[:alnum:]_.-] ]] && continue
    if [ "${after:0:1}" = / ]; then
      child="${after#/}"
      child="${child%%[/[:space:]\"\'\;\&\|\)]*}"
      [ -n "$child" ] && [[ $'\n'"$checkouts"$'\n' == *$'\n'"$repo/$child"$'\n'* ]] && continue
    fi
    return 0
  done
  return 1
}

# Prints each path git reports changed in checkout $1 that is newer than $boundary, deletions
# included. One Python pass over the NUL records: a bash loop took ~8s per call on the workspace
# root's 32,781 entries. Porcelain -z reports a rename's destination first and its source as a
# second record, which is consumed without being treated as a status.
changed_paths() {
  git -C "$1" status --porcelain -z --untracked-files=all 2>/dev/null | python3 -c '
import os, sys
repo, boundary = os.fsencode(sys.argv[1]), os.stat(sys.argv[2]).st_mtime_ns
records = iter(sys.stdin.buffer.read().split(b"\0"))
out = sys.stdout.buffer
for record in records:
    if not record:
        continue
    status, rel = record[:2], record[3:]
    if b"R" in status or b"C" in status:
        next(records, None)
    path = repo + b"/" + rel
    if os.path.isfile(path):
        if os.stat(path).st_mtime_ns < boundary:
            continue
    elif b"D" not in status:
        continue
    out.write(path + b"\n")
' "$1" "$boundary"
}

payload="$(cat)"
case "$dialect" in
  cursor)
    session_id="$(jq -r '.conversation_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // .workspace_roots[0] // empty' <<<"$payload")"
    [ -n "$cwd" ] || cwd="${CURSOR_PROJECT_DIR:-$PWD}"
    case "$(jq -r '.hook_event_name // empty' <<<"$payload")" in
      afterFileEdit) tool_name=Edit ;;
      afterShellExecution|beforeShellExecution) tool_name=Bash ;;
      *) tool_name="" ;;
    esac
    file_path="$(jq -r '.file_path // empty' <<<"$payload")"
    command="$(jq -r '.command // empty' <<<"$payload")"
    ;;
  devin)
    session_id="$(jq -r '.session_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // empty' <<<"$payload")"
    [ -n "$cwd" ] || cwd="${DEVIN_PROJECT_DIR:-$PWD}"
    case "$(jq -r '.tool_name // empty' <<<"$payload")" in
      edit|write|notebook_edit) tool_name=Edit ;;
      exec|apply_patch) tool_name=Bash ;;
      *) tool_name="" ;;
    esac
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$payload")"
    command="$(jq -r '.tool_input.command // empty' <<<"$payload")"
    ;;
  *)
    session_id="$(jq -r '.session_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // empty' <<<"$payload")"
    tool_name="$(jq -r '.tool_name // empty' <<<"$payload")"
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$payload")"
    command="$(jq -r '.tool_input.command // empty' <<<"$payload")"
    ;;
esac

case "$cwd" in
  "$HOME"/thoven|"$HOME"/thoven/*|"$HOME"/.herdr/worktrees/*) ;;
  *) exit 0 ;;
esac

[ -n "$session_id" ] || exit 0
# The id names a directory under /tmp/claude-thoven; one that could climb out of it is ignored.
case "$session_id" in */*|.*) exit 0 ;; esac

# THOVEN_CLAUDE_STATE moves the state root; the tests use it so they never write under the real one.
state="${THOVEN_CLAUDE_STATE:-/tmp/claude-thoven}/$session_id"
mkdir -p "$state"
[ -f "$state/started" ] || touch "$state/started"

if [ "$pre" -eq 1 ]; then
  [ "$tool_name" = Bash ] && touch "$state/cmd-started"
  exit 0
fi

edited_file="$state/edited"

case "$tool_name" in
  Edit|Write)
    if [ -n "$file_path" ]; then
      abs_path="$(python3 - "$cwd" "$file_path" <<'PY_PATH'
from pathlib import Path
import sys
path = Path(sys.argv[2])
print((path if path.is_absolute() else Path(sys.argv[1]) / path).resolve())
PY_PATH
)"
      touch "$edited_file"
      grep -qxF "$abs_path" "$edited_file" || echo "$abs_path" >> "$edited_file"
      touch "$state/last-edit"
    fi
    ;;
  Bash)
    # Preserve check commands for diagnostics.
    checks_regex='\b(tsc|rspec|vitest|jest|playwright|eslint|rubocop|contract-check|type-check|typecheck)\b|\b(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?(test|lint|check)\b|\bnext[[:space:]]+lint\b|\brails[[:space:]]+(test|spec)\b'
    if [ -n "$command" ] && grep -qE "$checks_regex" <<<"$command"; then
      printf '%s\n' "$command" >> "$state/checks"
    fi

    boundary="$state/started"
    [ -f "$state/cmd-started" ] && boundary="$state/cmd-started"
    touch "$edited_file"
    candidates="$state/candidates.$$"
    : > "$candidates"

    toplevel="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"
    [ -n "$toplevel" ] && changed_paths "$toplevel" >> "$candidates"
    # A command can edit a sibling checkout that `git status` from cwd cannot see.
    # Inspect only checkouts named in the
    # command, and use the same mtime boundary as the cwd path.
    case "$cwd" in
      "$HOME/thoven"|"$HOME"/thoven/*)
      checkouts="$(find "$HOME/thoven" -maxdepth 2 -name .git -print 2>/dev/null | sed 's|/\.git$||')"
      while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        [ "$repo" = "$toplevel" ] && continue
        relative="${repo#"$HOME/thoven"/}"
        if ! names_path "$command" "$repo" "$repo" && ! names_path "$command" "$relative" "$repo"; then
          names_path "$command" "$(relpath_from "$cwd" "$repo")" "$repo" || continue
        fi
        changed_paths "$repo" >> "$candidates"
      done <<<"$checkouts"
      ;;
    esac

    # One pass against the edited list, however long either grows: a grep per path held two
    # sessions' hooks at ~86% CPU on a 24,000-line list (2026-11-08). FILENAME, not NR == FNR,
    # because an empty edited list would otherwise read the candidates as already seen.
    newly=()
    while IFS= read -r path; do
      newly+=("$path")
    done < <(awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen) { seen[$0] = 1; print }' "$edited_file" "$candidates")
    rm -f "$candidates"
    if [ "${#newly[@]}" -gt 0 ]; then
      printf '%s\n' "${newly[@]}" >> "$edited_file"
      touch "$state/last-edit"
    fi

    # The UI nudge reads only this checkout's paths, as before siblings shared the list.
    if [ "$dialect" = claude ] && [ -n "$toplevel" ] && [ ! -f "$state/ui-rule-shown" ]; then
      match=0
      for p in "${newly[@]:-}"; do
        case "$p" in "$toplevel"/*) ;; *) continue ;; esac
        case "$p" in
          */components/*|*/app/*.tsx) match=1 ;;
        esac
      done
      if [ "$match" -eq 1 ]; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"Thoven UI rule: before changing a component, run the thoven-designer skill to find the binding token file for the value in question. The surface named in the task is the only one in scope."}}'
        touch "$state/ui-rule-shown"
      fi
    fi
    rm -f "$state/cmd-started"
    ;;
esac

exit 0
