#!/usr/bin/env bash
# Records edited files (Edit|Write file_path, or Bash's git-dirty paths since session start) and nudges the UI rule once.
# Each dialect's payload is read into one shape: session_id, cwd, and an Edit (file_path) or a Bash (command).
#   claude, codex  PostToolUse; tool_name Edit|Write|Bash, cwd in the payload
#   cursor         afterFileEdit (file_path) and afterShellExecution (command); keyed on conversation_id,
#                  no cwd, so the first workspace root (cursor.com/docs/hooks)
#   devin          PostToolUse; tool_name edit|write|notebook_edit carry tool_input.file_path, exec and
#                  apply_patch are scanned; no cwd, so DEVIN_PROJECT_DIR (docs.devin.ai/cli/extensibility/hooks)
#   OpenCode's plugin sends the claude shape (opencode/thoven-uncommitted.js).
#   thoven-track-edits [--dialect claude|cursor|devin]
set -o pipefail

dialect=claude
[ "${1:-}" = "--dialect" ] && dialect="${2:-claude}"

payload="$(cat)"
case "$dialect" in
  cursor)
    session_id="$(jq -r '.conversation_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // .workspace_roots[0] // empty' <<<"$payload")"
    [ -n "$cwd" ] || cwd="${CURSOR_PROJECT_DIR:-$PWD}"
    case "$(jq -r '.hook_event_name // empty' <<<"$payload")" in
      afterFileEdit) tool_name=Edit ;;
      afterShellExecution) tool_name=Bash ;;
      *) tool_name="" ;;
    esac
    file_path="$(jq -r '.file_path // empty' <<<"$payload")"
    command="$(jq -r '.command // empty' <<<"$payload")"
    ;;
  devin)
    session_id="$(jq -r '.session_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // empty' <<<"$payload")"
    [ -n "$cwd" ] || cwd="${DEVIN_PROJECT_DIR:-$PWD}"
    case "$(jq -r '.tool_name // empty' <<<"$payload")" in
      edit|write|notebook_edit) tool_name=Edit ;;
      exec|apply_patch) tool_name=Bash ;;
      *) tool_name="" ;;
    esac
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$payload")"
    command="$(jq -r '.tool_input.command // empty' <<<"$payload")"
    ;;
  *)
    session_id="$(jq -r '.session_id // empty' <<<"$payload")"
    cwd="$(jq -r '.cwd // empty' <<<"$payload")"
    tool_name="$(jq -r '.tool_name // empty' <<<"$payload")"
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$payload")"
    command="$(jq -r '.tool_input.command // empty' <<<"$payload")"
    ;;
esac

case "$cwd" in
  "$HOME"/thoven|"$HOME"/thoven/*|"$HOME"/.herdr/worktrees/*) ;;
  *) exit 0 ;;
esac

[ -n "$session_id" ] || exit 0
# The id names a directory under /tmp/claude-thoven; one that could climb out of it is ignored.
case "$session_id" in */*|.*) exit 0 ;; esac

state="/tmp/claude-thoven/$session_id"
mkdir -p "$state"
[ -f "$state/started" ] || touch "$state/started"

edited_file="$state/edited"

case "$tool_name" in
  Edit|Write)
    if [ -n "$file_path" ]; then
      abs_path="$(python3 - "$cwd" "$file_path" <<'PY_PATH'
from pathlib import Path
import sys
path = Path(sys.argv[2])
print((path if path.is_absolute() else Path(sys.argv[1]) / path).resolve())
PY_PATH
)"
      touch "$edited_file"
      grep -qxF "$abs_path" "$edited_file" || echo "$abs_path" >> "$edited_file"
      touch "$state/last-edit"
    fi
    ;;
  Bash)
    # Preserve check commands for diagnostics. Command text alone does not
    # satisfy the evidence hook; it validates the native runner's receipt.
    checks_regex='\b(tsc|rspec|vitest|jest|playwright|eslint|rubocop|contract-check|type-check|typecheck)\b|\b(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?(test|lint|check)\b|\bnext[[:space:]]+lint\b|\brails[[:space:]]+(test|spec)\b'
    if [ -n "$command" ] && grep -qE "$checks_regex" <<<"$command"; then
      printf '%s\n' "$command" >> "$state/checks"
    fi

    toplevel="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"
    newly=()
    if [ -n "$toplevel" ]; then
      touch "$edited_file"
      while IFS= read -r -d '' line; do
        [ -n "$line" ] || continue
        rel="${line:3}"
        # Porcelain -z reports the destination first and the rename source
        # as a second NUL record. Consume it without treating it as status.
        case "${line:0:2}" in *R*|*C*) IFS= read -r -d '' || break ;; esac
        abs="$toplevel/$rel"
        if [ ! -f "$abs" ] && [[ "${line:0:2}" != *D* ]]; then
          continue
        fi
        if [ -f "$abs" ] && [ "$abs" -ot "$state/started" ]; then
          continue
        fi
        grep -qxF "$abs" "$edited_file" && continue
        echo "$abs" >> "$edited_file"
        newly+=("$abs")
        touch "$state/last-edit"
      done < <(git -C "$cwd" status --porcelain -z --untracked-files=all 2>/dev/null)

      if [ "$dialect" = claude ] && [ ! -f "$state/ui-rule-shown" ]; then
        match=0
        for p in "${newly[@]:-}"; do
          [ -n "$p" ] || continue
          case "$p" in
            */components/*) match=1 ;;
          esac
          case "$p" in
            */app/*.tsx) match=1 ;;
          esac
        done
        if [ "$match" -eq 1 ]; then
          printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"Thoven UI rule: before changing a component, run the thoven-designer skill to find the binding token file for the value in question. The surface named in the task is the only one in scope."}}'
          touch "$state/ui-rule-shown"
        fi
      fi
    fi
    # A command can edit a sibling checkout that `git status` from cwd cannot see.
    # Inspect only checkouts named in the
    # command, and preserve the same session-start mtime boundary as the cwd path.
    case "$cwd" in
      "$HOME/thoven"|"$HOME"/thoven/*)
      while IFS= read -r dotgit; do
        [ -n "$dotgit" ] || continue
        repo="${dotgit%/.git}"
        relative="${repo#"$HOME/thoven"/}"
        relative_from_cwd="$(python3 - "$cwd" "$repo" <<'PY_PATH'
import os
import sys
print(os.path.relpath(sys.argv[2], sys.argv[1]))
PY_PATH
)"
        if [[ "$command" != *"$repo"* && "$command" != *"$relative"* && "$command" != *"$relative_from_cwd"* ]]; then
          continue
        fi
        while IFS= read -r -d '' line; do
          [ -n "$line" ] || continue
          rel="${line:3}"
          case "${line:0:2}" in *R*|*C*) IFS= read -r -d '' || break ;; esac
          abs="$repo/$rel"
          if [ ! -f "$abs" ] && [[ "${line:0:2}" != *D* ]]; then continue; fi
          if [ -f "$abs" ] && [ "$abs" -ot "$state/started" ]; then continue; fi
          grep -qxF "$abs" "$edited_file" || { echo "$abs" >> "$edited_file"; touch "$state/last-edit"; }
        done < <(git -C "$repo" status --porcelain -z --untracked-files=all 2>/dev/null)
      done < <(find "$HOME/thoven" -maxdepth 4 -name .git -print 2>/dev/null)
      ;;
    esac
    ;;
esac

exit 0
